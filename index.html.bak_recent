<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Delivery Pizza 3D - Medium Poly Edition</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #2b1810;
            font-family: 'Inter', sans-serif;
        }
        .font-display {
            font-family: 'Fredoka', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .hud-glass {
            background: rgba(20, 14, 12, 0.78);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 180, 120, 0.25);
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
        }
        .btn-game {
            transition: all 0.15s ease;
            box-shadow: 0 4px 0 rgba(0,0,0,0.4);
        }
        .btn-game:active, .btn-game.active-press {
            transform: translateY(3px);
            box-shadow: 0 1px 0 rgba(0,0,0,0.4);
        }
        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.88; }
        }
        .animate-mission {
            animation: pulseGlow 2s infinite ease-in-out;
        }
        @keyframes urgentBlink {
            0%, 100% { background-color: rgba(220, 38, 38, 0.9); }
            50% { background-color: rgba(127, 29, 29, 0.9); }
        }
        .timer-urgent {
            animation: urgentBlink 0.6s infinite;
        }
        .floating-text-shadow {
            text-shadow: 0 2px 8px rgba(0,0,0,0.95), 0 0 2px #000, 0 1px 3px #000;
        }
        .floating-glow-amber {
            text-shadow: 0 0 14px rgba(245, 158, 11, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-sky {
            text-shadow: 0 0 14px rgba(56, 189, 248, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-emerald {
            text-shadow: 0 0 14px rgba(16, 185, 129, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-rose {
            text-shadow: 0 0 14px rgba(244, 63, 94, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
    </style>
</head>
<body class="relative">

    <!-- 3D Canvas Container -->
    <div id="canvas-container" class="w-full h-full relative"></div>

    <!-- TOP HUD: Gaji, Statistik, Misi, & Timer -->
    <div class="fixed top-3 left-3 right-3 z-20 pointer-events-none flex flex-col lg:flex-row items-stretch lg:items-start justify-between gap-3">
        
        <!-- Left: Brand & Salary Card -->
        <div class="flex flex-wrap items-center gap-2.5 pointer-events-auto">
            <!-- Game Logo Badge -->
            <div class="hud-glass rounded-2xl px-4 py-2.5 flex items-center gap-3 border-l-4 border-orange-500">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-600 to-orange-500 flex items-center justify-center shadow-inner text-xl">
                    🍕
                </div>
                <div>
                    <h1 class="font-display text-white text-lg leading-none tracking-wide">DELIVERY PIZZA</h1>
                    <p class="text-[11px] text-amber-300/90 font-semibold mt-0.5">Kurir Mobil 3D • Distrik A–C</p>
                </div>
            </div>

            <!-- Gaji (Salary) Counter -->
            <div id="salary-card" class="hud-glass rounded-2xl px-4 py-2.5 flex items-center gap-3 transition-transform duration-300">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 font-bold text-lg">
                    Rp
                </div>
                <div>
                    <div class="text-[10px] uppercase tracking-wider text-amber-200/70 font-bold">Total Gaji Kurir</div>
                    <div id="hud-salary" class="font-display text-xl text-emerald-400 leading-tight">Rp 100.000</div>
                </div>
                <div class="border-l border-white/15 pl-3 ml-1 flex gap-3 text-xs">
                    <div>
                        <span class="text-white/60 block text-[10px]">Sukses</span>
                        <span id="hud-delivered" class="font-bold text-emerald-300">0</span>
                    </div>
                    <div>
                        <span class="text-white/60 block text-[10px]">Telat</span>
                        <span id="hud-failed" class="font-bold text-rose-400">0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Center: Mission Banner & 2-Minute Countdown (Floating HUD - No Container / Background) -->
        <div class="flex flex-col items-center pointer-events-none mx-auto lg:mx-0 select-none">
            <div id="mission-banner" class="max-w-xl w-full text-center px-4 py-0.5 bg-transparent border-0 shadow-none">
                <div class="flex items-center justify-center gap-2 mb-0.5">
                    <span id="mission-badge" class="text-xs font-black tracking-widest uppercase text-amber-400 drop-shadow-[0_2px_4px_rgba(0,0,0,1)]">
                        TAHAP 1 • AMBIL PAKET
                    </span>
                    <span class="text-white/40 drop-shadow-[0_1px_2px_rgba(0,0,0,1)]">•</span>
                    <span id="cargo-status" class="text-xs font-bold text-white drop-shadow-[0_2px_4px_rgba(0,0,0,1)]">
                        Bagasi: Kosong
                    </span>
                </div>
                <div id="mission-text" class="font-display text-white text-base sm:text-lg font-bold tracking-wide drop-shadow-[0_2px_6px_rgba(0,0,0,1)]">
                    Mundur (<span class="text-amber-300 font-extrabold">S / ▼</span>) ke dalam <span class="text-emerald-300 font-extrabold underline underline-offset-2">Garasi Pabrik</span> untuk ambil paket!
                </div>

                <!-- Timer Box (Visible during active delivery, clean floating bar) -->
                <div id="timer-container" class="hidden mt-1 text-center">
                    <div class="flex items-center justify-center gap-2 text-xs mb-0.5">
                        <span class="text-amber-200/95 font-bold drop-shadow-[0_1px_3px_rgba(0,0,0,1)]">Batas Waktu:</span>
                        <span id="timer-display" class="font-display text-base font-black text-white tracking-widest px-1.5 py-0.5 drop-shadow-[0_2px_4px_rgba(0,0,0,1)]">01:25</span>
                    </div>
                    <div class="w-44 mx-auto h-1.5 bg-black/60 rounded-full overflow-hidden shadow">
                        <div id="timer-bar" class="h-full bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 rounded-full transition-all duration-200" style="width: 100%;"></div>
                    </div>
                </div>

                <!-- Unloading Pizza Progress Bar (Active when staying inside blue zone for 10 seconds - no seconds text, purely blue progress bar) -->
                <div id="dropoff-progress-box" class="hidden mt-2 text-center transition-all duration-300">
                    <div class="flex items-center justify-center gap-2 text-xs mb-1">
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping"></span>
                        <span id="dropoff-status-text" class="font-display text-sm font-extrabold text-sky-300 tracking-wide drop-shadow-[0_2px_6px_rgba(0,0,0,1)]">
                            📦 MENURUNKAN PAKET PIZZA... (TETAP DI AREA BIRU)
                        </span>
                    </div>
                    <div class="w-64 mx-auto h-2.5 bg-black/80 backdrop-blur-md rounded-full p-0.5 border border-sky-400/60 shadow-[0_0_16px_rgba(56,189,248,0.6)]">
                        <div id="dropoff-progress-bar" class="h-full bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 rounded-full transition-all duration-100 shadow-[0_0_12px_rgba(56,189,248,0.9)]" style="width: 0%;"></div>
                    </div>
                
                <!-- Floating GPS Navigation Indicator -->
                <div id="gps-banner" class="mt-1 flex items-center justify-center gap-2 select-none">
                    <div class="hud-glass px-3 py-1 rounded-full flex items-center gap-2 border border-white/20 shadow-md">
                        <span id="gps-icon" class="text-sm inline-block transform transition-transform duration-100">🧭</span>
                        <span id="gps-target-name" class="font-extrabold text-white text-xs">Pabrik Pizza</span>
                        <span class="text-white/40">•</span>
                        <span id="gps-distance" class="font-bold text-amber-300 text-xs">0 m</span>
                    </div>
                </div>
</div>
            </div>
        </div>

        <!-- Right: Testing Tools & Camera Controls (Clean, minimal, no bulky container box) -->
        <div class="flex items-center justify-end gap-2 pointer-events-auto">
            <div class="flex flex-wrap items-center gap-2 text-xs bg-transparent border-0 shadow-none">
                <div class="flex items-center gap-1.5">
                    <label class="text-[11px] text-amber-200/90 font-bold block drop-shadow-[0_1px_3px_rgba(0,0,0,1)]">Target:</label>
                    <select id="next-house-select" onchange="this.blur()" class="bg-black/55 hover:bg-black/80 backdrop-blur-sm text-white font-bold text-xs rounded-lg px-2.5 py-1 border border-white/20 focus:outline-none shadow">
                        <option value="AUTO">Otomatis (Mulai C1, lalu Acak)</option>
                        <option value="A1">Paksa Rumah A1</option>
                        <option value="A2">Paksa Rumah A2</option>
                        <option value="A3">Paksa Rumah A3</option>
                        <option value="B1">Paksa Rumah B1</option>
                        <option value="B2">Paksa Rumah B2</option>
                        <option value="B3">Paksa Rumah B3</option>
                        <option value="C1">Paksa Rumah C1</option>
                        <option value="C2">Paksa Rumah C2</option>
                        <option value="C3">Paksa Rumah C3</option>
                    </select>
                </div>
                <button id="btn-test-timeout" onclick="this.blur()" title="Uji coba waktu hampir habis untuk lihat pinalti gaji" class="btn-game hidden bg-rose-600 hover:bg-rose-500 text-white font-bold px-2 py-1 rounded-lg text-[11px] shadow">
                    ⏱️ 5s
                </button>
                <button id="btn-respawn" onclick="this.blur()" title="Kembalikan mobil ke depan pabrik" class="btn-game bg-black/55 hover:bg-amber-600 border border-white/20 text-white font-bold px-2.5 py-1 rounded-lg text-[11px] shadow">
                    🔄 Reset Depan Pabrik
                </button>
            </div>
        </div>
    </div>

    <!-- CENTER POPUP NOTIFICATION (Salary + / - Feedback, floating text without blocking container) -->
    <div id="toast-container" class="fixed top-28 left-1/2 -translate-x-1/2 z-30 pointer-events-none flex flex-col items-center gap-2 w-full max-w-md px-4"></div>

    <!-- BOTTOM LEFT: Interactive 2D Minimap & Quick Actions -->
    <div class="fixed bottom-3 left-3 z-20 flex items-end gap-3 pointer-events-none">
        <!-- 2D Radar / Map of Factory + 3x3 Houses -->
        <div class="hud-glass rounded-2xl p-2.5 pointer-events-auto">
            <div class="flex items-center justify-between mb-1 px-1">
                <span class="text-[11px] font-bold text-amber-300 uppercase tracking-wider">Peta Pengiriman (Pabrik → Perumahan)</span>
                <span id="minimap-target-label" class="text-[11px] font-extrabold text-emerald-400">GARASI</span>
            </div>
            <canvas id="minimap-canvas" width="220" height="115" class="rounded-xl border border-white/15 bg-[#140e0a]"></canvas>
        </div>

        <!-- Action Buttons (Camera V, Horn H, Sound M) -->
        <div class="flex flex-col gap-2 pointer-events-auto">
            <!-- Hidden backward-compatible elements for existing logic -->
            <span id="hud-speed" class="hidden">0</span>
            <span id="hud-gear" class="hidden">DIAM (N)</span>

            <!-- Quick Action Buttons -->
            <div class="flex gap-1.5">
                <button id="btn-camera" onclick="this.blur()" class="btn-game bg-black/55 backdrop-blur-sm border border-white/20 hover:bg-white/20 text-white px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 shadow">
                    <span>👁️</span> <span id="cam-label">Kamera: 3rd (V)</span>
                </button>
                <button id="btn-horn" onclick="this.blur()" class="btn-game bg-black/55 backdrop-blur-sm border border-white/20 hover:bg-white/20 text-white px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1 shadow">
                    <span>📯</span> <span>(H)</span>
                </button>
                <button id="btn-audio" onclick="this.blur()" class="btn-game bg-black/55 backdrop-blur-sm border border-white/20 hover:bg-white/20 text-white px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1 shadow">
                    <span id="audio-icon">🔊</span>
                </button>
            </div>
        </div>
    </div>

    <!-- BOTTOM RIGHT: Controls + Dedicated Mini Speedometer -->
    <div class="fixed bottom-3 right-3 z-30 flex items-end gap-3 pointer-events-auto select-none">
        <!-- Controls Column (Keyboard Hints + Touch driving buttons) -->
        <div class="flex flex-col items-end gap-2">
            <div class="hidden sm:flex bg-black/45 backdrop-blur-sm border border-white/10 rounded-xl px-3 py-1.5 text-[11px] text-amber-100/90 gap-3 items-center shadow">
                <span id="key-ind-w" class="px-1.5 py-0.5 rounded bg-white/5 transition-colors"><strong class="text-white">W / ↑</strong> Gas</span>
                <span id="key-ind-s" class="px-1.5 py-0.5 rounded bg-white/5 transition-colors"><strong class="text-amber-300">S / ↓</strong> Rem / Mundur</span>
                <span class="px-1.5 py-0.5"><strong class="text-white">A D / ← →</strong> Belok</span>
                <span id="key-ind-space" class="px-1.5 py-0.5 rounded bg-white/5 transition-colors"><strong class="text-sky-300">Spasi</strong> Drift</span>
                <span id="key-ind-b" class="px-1.5 py-0.5 rounded bg-white/5 transition-colors"><strong class="text-orange-400">B</strong> Bletak Pop 🔥</span>
            </div>

            <!-- On-Screen Touch Driving Pad (Mobile & Mouse) -->
            <div class="flex items-center gap-2">
                <!-- Left / Right Steering -->
                <div class="flex gap-1.5">
                    <button id="touch-left" class="btn-game bg-black/55 backdrop-blur-sm border border-white/20 hover:bg-white/20 w-11 h-11 sm:w-12 sm:h-12 rounded-xl text-white font-bold text-lg flex items-center justify-center active:bg-amber-500/40">
                        ◀
                    </button>
                    <button id="touch-right" class="btn-game bg-black/55 backdrop-blur-sm border border-white/20 hover:bg-white/20 w-11 h-11 sm:w-12 sm:h-12 rounded-xl text-white font-bold text-lg flex items-center justify-center active:bg-amber-500/40">
                        ▶
                    </button>
                </div>
                <!-- Handbrake Drift, Reverse & Gas -->
                <div class="flex gap-1.5">
                    <button id="touch-brake" class="btn-game bg-sky-600/80 hover:bg-sky-500 border border-sky-300/40 w-12 h-11 sm:w-14 sm:h-12 rounded-xl text-white font-bold flex flex-col items-center justify-center">
                        <span class="text-xs leading-none">💨</span>
                        <span class="text-[9px] uppercase mt-0.5 font-bold">Drift</span>
                    </button>
                    <button id="touch-down" class="btn-game bg-amber-600/80 hover:bg-amber-500 border border-amber-300/40 w-12 h-11 sm:w-14 sm:h-12 rounded-xl text-white font-bold flex flex-col items-center justify-center">
                        <span class="text-sm leading-none">▼</span>
                        <span class="text-[9px] uppercase mt-0.5 font-bold">Mundur</span>
                    </button>
                    <button id="touch-up" class="btn-game bg-emerald-600/80 hover:bg-emerald-500 border border-emerald-300/40 w-12 h-11 sm:w-14 sm:h-12 rounded-xl text-white font-bold flex flex-col items-center justify-center">
                        <span class="text-sm leading-none">▲</span>
                        <span class="text-[9px] uppercase mt-0.5 font-bold">Gas</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- RIGHTMOST CORNER: Sleek Mini Speedometer Gauge -->
        <div id="speedo-widget" class="flex flex-col items-center pointer-events-none">
            <canvas id="speedo-canvas" width="124" height="124" class="drop-shadow-[0_4px_16px_rgba(0,0,0,0.85)]"></canvas>
        </div>
    </div>

    <script>
        /********************************************************************
         * 1. SOUND SYSTEM (Web Audio API Synthesizer - No External Files)
         ********************************************************************/
        class SoundManager {
            constructor() {
                this.ctx = null;
                this.muted = false;
                this.engineOsc = null;
                this.engineGain = null;
                this.skidGain = null;
                this.skidFilter = null;
                this.reverseBeepTimer = 0;
            }

            init() {
                if (this.ctx) return;
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                this.ctx = new AudioCtx();

                // Continuous soft engine hum
                this.engineOsc = this.ctx.createOscillator();
                this.engineGain = this.ctx.createGain();
                this.engineOsc.type = 'sawtooth';
                this.engineOsc.frequency.value = 55;
                this.engineGain.gain.value = 0.0;

                // Lowpass filter so the engine sounds warm and muffled
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.value = 220;

                this.engineOsc.connect(filter);
                filter.connect(this.engineGain);
                this.engineGain.connect(this.ctx.destination);
                this.engineOsc.start();

                // Soft Realistic Tire Scrub / Drift Sound (Filtered Pink/White Noise + Resonance)
                const bufferSize = this.ctx.sampleRate * 2;
                const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const output = noiseBuffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    output[i] = Math.random() * 2 - 1;
                }
                const whiteNoise = this.ctx.createBufferSource();
                whiteNoise.buffer = noiseBuffer;
                whiteNoise.loop = true;

                this.skidFilter = this.ctx.createBiquadFilter();
                this.skidFilter.type = 'bandpass';
                this.skidFilter.frequency.value = 950;
                this.skidFilter.Q.value = 3.5;

                this.skidGain = this.ctx.createGain();
                this.skidGain.gain.value = 0.0;

                whiteNoise.connect(this.skidFilter);
                this.skidFilter.connect(this.skidGain);
                this.skidGain.connect(this.ctx.destination);
                whiteNoise.start();
            }

            updateEngine(speedRatio, isReversing, dt, driftIntensity = 0) {
                if (!this.ctx || this.muted) {
                    if (this.engineGain) this.engineGain.gain.value = 0;
                    if (this.skidGain) this.skidGain.gain.value = 0;
                    return;
                }
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const targetFreq = 52 + Math.abs(speedRatio) * 95 + driftIntensity * 18;
                this.engineOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 0.05);
                this.engineGain.gain.setTargetAtTime(0.035 + Math.abs(speedRatio) * 0.04, this.ctx.currentTime, 0.08);

                // Subtle tire scrub sound proportional to realistic lateral slip
                if (this.skidGain && this.skidFilter) {
                    const targetSkidVol = Math.min(0.055, driftIntensity * 0.045);
                    this.skidGain.gain.setTargetAtTime(targetSkidVol, this.ctx.currentTime, 0.06);
                    this.skidFilter.frequency.setTargetAtTime(820 + driftIntensity * 320, this.ctx.currentTime, 0.08);
                }

                // Backup truck beep when reversing
                if (isReversing) {
                    this.reverseBeepTimer += dt;
                    if (this.reverseBeepTimer > 0.55) {
                        this.reverseBeepTimer = 0;
                        this.playTone(980, 0.12, 'square', 0.04);
                    }
                } else {
                    this.reverseBeepTimer = 0.5;
                }
            }

            playTone(freq, duration, type = 'sine', volume = 0.1) {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                gain.gain.setValueAtTime(volume, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            }

            playHorn() {
                this.playTone(340, 0.28, 'sawtooth', 0.09);
                this.playTone(425, 0.28, 'sawtooth', 0.09);
            }

            playPickup() {
                this.playTone(523.25, 0.12, 'triangle', 0.12);
                setTimeout(() => this.playTone(659.25, 0.15, 'triangle', 0.12), 100);
                setTimeout(() => this.playTone(783.99, 0.22, 'triangle', 0.14), 210);
            }

            playSuccess() {
                const notes = [523.25, 659.25, 783.99, 1046.5];
                notes.forEach((n, i) => {
                    setTimeout(() => this.playTone(n, 0.18, 'triangle', 0.14), i * 90);
                });
            }

            playFail() {
                this.playTone(220, 0.25, 'sawtooth', 0.12);
                setTimeout(() => this.playTone(165, 0.4, 'sawtooth', 0.14), 220);
            }

            playBackfirePop(intensity = 1.0) {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const now = this.ctx.currentTime;

                // 1. Sharp "CRACK" / "SNAP" (high-frequency burst transient - the 'bletak' snap)
                const snapLen = Math.floor(this.ctx.sampleRate * 0.045);
                const snapBuf = this.ctx.createBuffer(1, snapLen, this.ctx.sampleRate);
                const snapData = snapBuf.getChannelData(0);
                for (let i = 0; i < snapLen; i++) {
                    snapData[i] = (Math.random() * 2 - 1) * Math.exp(-i / (snapLen * 0.14));
                }
                const snapSrc = this.ctx.createBufferSource();
                snapSrc.buffer = snapBuf;

                const snapFilter = this.ctx.createBiquadFilter();
                snapFilter.type = 'highpass';
                snapFilter.frequency.value = 1600 + Math.random() * 1200;

                const snapGain = this.ctx.createGain();
                snapGain.gain.setValueAtTime(0.52 * intensity, now);
                snapGain.gain.exponentialRampToValueAtTime(0.001, now + 0.045);

                snapSrc.connect(snapFilter);
                snapFilter.connect(snapGain);
                snapGain.connect(this.ctx.destination);
                snapSrc.start(now);

                // 2. Heavy explosive thump (50-140Hz deep pressure wave)
                const thumpOsc = this.ctx.createOscillator();
                const thumpGain = this.ctx.createGain();
                thumpOsc.type = 'sawtooth';
                thumpOsc.frequency.setValueAtTime(145 + Math.random() * 50, now);
                thumpOsc.frequency.exponentialRampToValueAtTime(32, now + 0.085);

                thumpGain.gain.setValueAtTime(0.38 * intensity, now);
                thumpGain.gain.exponentialRampToValueAtTime(0.001, now + 0.085);

                thumpOsc.connect(thumpGain);
                thumpGain.connect(this.ctx.destination);
                thumpOsc.start(now);
                thumpOsc.stop(now + 0.085);

                // 3. Muffler chamber resonance pop
                const popOsc = this.ctx.createOscillator();
                const popGain = this.ctx.createGain();
                popOsc.type = 'triangle';
                popOsc.frequency.setValueAtTime(270 + Math.random() * 130, now);
                popOsc.frequency.exponentialRampToValueAtTime(45, now + 0.055);

                popGain.gain.setValueAtTime(0.28 * intensity, now);
                popGain.gain.exponentialRampToValueAtTime(0.001, now + 0.055);

                popOsc.connect(popGain);
                popGain.connect(this.ctx.destination);
                popOsc.start(now);
                popOsc.stop(now + 0.055);
            }
        }

        const sound = new SoundManager();

        /********************************************************************
         * 2. PROCEDURAL ROBLOX-STYLE TEXTURE GENERATOR
         ********************************************************************/
        function createBrickTexture(baseColor, brickColors, mortarColor, repeatX = 4, repeatY = 2) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = mortarColor;
            ctx.fillRect(0, 0, 256, 256);

            const rows = 8;
            const cols = 4;
            const brickH = 256 / rows;
            const brickW = 256 / cols;
            const gap = 3;

            for (let r = 0; r < rows; r++) {
                const offset = (r % 2 === 1) ? brickW / 2 : 0;
                for (let c = -1; c <= cols; c++) {
                    const x = c * brickW + offset;
                    const y = r * brickH;
                    ctx.fillStyle = brickColors[Math.floor(Math.random() * brickColors.length)];
                    ctx.fillRect(x + gap, y + gap, brickW - gap * 2, brickH - gap * 2);

                    // Subtle top highlight for medium-poly depth
                    ctx.fillStyle = 'rgba(255,255,255,0.08)';
                    ctx.fillRect(x + gap, y + gap, brickW - gap * 2, 3);
                }
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createGarageDoorTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#f3ece4';
            ctx.fillRect(0, 0, 256, 256);

            const slats = 16;
            const h = 256 / slats;
            for (let i = 0; i < slats; i++) {
                const y = i * h;
                const grad = ctx.createLinearGradient(0, y, 0, y + h);
                grad.addColorStop(0, '#ffffff');
                grad.addColorStop(0.7, '#e5dcd2');
                grad.addColorStop(1, '#b8ada1');
                ctx.fillStyle = grad;
                ctx.fillRect(0, y, 256, h);
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        function createAsphaltTexture(repeatX = 10, repeatY = 10) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#252a2e';
            ctx.fillRect(0, 0, 256, 256);

            const tones = ['#1d2226', '#2c3237', '#33393e', '#191d20'];
            for (let i = 0; i < 1600; i++) {
                ctx.fillStyle = tones[i % tones.length];
                const x = Math.random() * 256;
                const y = Math.random() * 256;
                const w = 2 + Math.random() * 5;
                const h = 2 + Math.random() * 5;
                ctx.fillRect(x, y, w, h);
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createAutumnGroundTexture(repeatX = 36, repeatY = 36) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            // Base warm autumn soil/grass
            ctx.fillStyle = '#8b4922';
            ctx.fillRect(0, 0, 256, 256);

            // Scattered autumn leaves (orange, golden, red, olive green, brown) like ref images 6-9
            const leafPalette = [
                '#c9521e', '#e06b24', '#d98a2b', '#b8371b',
                '#6d682a', '#9c4119', '#e89938', '#783a18'
            ];
            for (let i = 0; i < 2200; i++) {
                ctx.fillStyle = leafPalette[Math.floor(Math.random() * leafPalette.length)];
                const x = Math.random() * 256;
                const y = Math.random() * 256;
                const rx = 3 + Math.random() * 7;
                const ry = 2 + Math.random() * 5;
                ctx.beginPath();
                ctx.ellipse(x, y, rx, ry, Math.random() * Math.PI, 0, Math.PI * 2);
                ctx.fill();
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createWheelRimTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            // Tire rubber outer ring
            ctx.fillStyle = '#151719';
            ctx.fillRect(0, 0, 256, 256);

            const cx = 128, cy = 128;

            // Silver rim circle (matching Image 2 & 3)
            ctx.beginPath();
            ctx.arc(cx, cy, 82, 0, Math.PI * 2);
            ctx.fillStyle = '#d3cac3';
            ctx.fill();

            // 5 dark cutouts between the 5 silver spokes
            ctx.fillStyle = '#222528';
            for (let i = 0; i < 5; i++) {
                const angle = (i * Math.PI * 2) / 5;
                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(angle);
                ctx.beginPath();
                ctx.ellipse(0, -52, 18, 22, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // 5 lug bolts around center hub
            ctx.fillStyle = '#2a2d30';
            for (let i = 0; i < 5; i++) {
                const angle = (i * Math.PI * 2) / 5 + 0.3;
                const bx = cx + Math.cos(angle) * 20;
                const by = cy + Math.sin(angle) * 20;
                ctx.beginPath();
                ctx.arc(bx, by, 4.5, 0, Math.PI * 2);
                ctx.fill();
            }

            return new THREE.CanvasTexture(canvas);
        }

        function createHouseCodeTexture(code) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#271911';
            ctx.fillRect(0, 0, 256, 128);

            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 8;
            ctx.strokeRect(6, 6, 244, 116);

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 72px Fredoka, Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(code, 128, 66);

            return new THREE.CanvasTexture(canvas);
        }

        function createPizzaBoxTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#f4d092';
            ctx.fillRect(0, 0, 256, 256);

            ctx.strokeStyle = '#c83e2b';
            ctx.lineWidth = 14;
            ctx.strokeRect(14, 14, 228, 228);

            ctx.beginPath();
            ctx.arc(128, 128, 68, 0, Math.PI * 2);
            ctx.fillStyle = '#f59e0b';
            ctx.fill();
            ctx.lineWidth = 6;
            ctx.strokeStyle = '#b45309';
            ctx.stroke();

            // Pepperoni dots
            ctx.fillStyle = '#dc2626';
            [
                [105, 105], [150, 110], [125, 145], [100, 145], [152, 148], [128, 98]
            ].forEach(([px, py]) => {
                ctx.beginPath();
                ctx.arc(px, py, 10, 0, Math.PI * 2);
                ctx.fill();
            });

            return new THREE.CanvasTexture(canvas);
        }

        function createFoliageLeafTexture(baseHex, highlightHex, shadowHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = baseHex;
            ctx.fillRect(0, 0, 128, 128);

            // Speckled medium-poly Roblox leaf texture grain
            for (let i = 0; i < 900; i++) {
                ctx.fillStyle = (i % 3 === 0) ? highlightHex : (i % 2 === 0) ? shadowHex : baseHex;
                const x = Math.random() * 128;
                const y = Math.random() * 128;
                const r = 2 + Math.random() * 4;
                ctx.fillRect(x, y, r, r);
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(2, 2);
            return tex;
        }

        function createBarkTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#4e2f1b';
            ctx.fillRect(0, 0, 128, 128);

            const barkColors = ['#3c2213', '#5c3822', '#694129', '#2e190d'];
            for (let i = 0; i < 180; i++) {
                ctx.fillStyle = barkColors[i % barkColors.length];
                ctx.fillRect(Math.random() * 128, Math.random() * 128, 3 + Math.random() * 4, 18 + Math.random() * 25);
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        function createSunGlowTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            const grad = ctx.createRadialGradient(128, 128, 8, 128, 128, 128);
            grad.addColorStop(0.0, 'rgba(255, 252, 230, 1.0)');
            grad.addColorStop(0.22, 'rgba(255, 210, 125, 0.85)');
            grad.addColorStop(0.55, 'rgba(255, 145, 65, 0.35)');
            grad.addColorStop(1.0, 'rgba(255, 110, 40, 0.0)');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 256, 256);

            return new THREE.CanvasTexture(canvas);
        }

        /********************************************************************
         * 3. THREE.JS SCENE, RAY-TRACING STYLE LIGHTING, GOD RAYS & ENV MAP
         ********************************************************************/
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        // Warm golden-orange sunset fog matching the Roblox reference screenshots
        scene.fog = new THREE.FogExp2(0xe2925e, 0.0011);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.2, 1600);

        const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // Sunset Sky Dome (Warm Roblox Autumn Sunset Palette)
        function createSunsetSky() {
            const skyCanvas = document.createElement('canvas');
            skyCanvas.width = 512;
            skyCanvas.height = 512;
            const ctx = skyCanvas.getContext('2d');
            const grad = ctx.createLinearGradient(0, 0, 0, 512);
            grad.addColorStop(0.0, '#3b1f16');
            grad.addColorStop(0.28, '#8c4627');
            grad.addColorStop(0.48, '#cc6f3d');
            grad.addColorStop(0.66, '#eb985b');
            grad.addColorStop(0.82, '#f5b57f');
            grad.addColorStop(1.0, '#b56135');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 512, 512);

            // Soft sunset clouds matching reference sky
            ctx.fillStyle = 'rgba(255, 220, 185, 0.22)';
            for (let i = 0; i < 80; i++) {
                const x = Math.random() * 512;
                const y = 60 + Math.random() * 200;
                const w = 35 + Math.random() * 115;
                const h = 6 + Math.random() * 18;
                ctx.beginPath();
                ctx.ellipse(x, y, w, h, 0, 0, Math.PI * 2);
                ctx.fill();
            }

            const skyTex = new THREE.CanvasTexture(skyCanvas);
            const skyGeo = new THREE.SphereGeometry(1100, 32, 24);
            const skyMat = new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide, fog: false });
            const skyMesh = new THREE.Mesh(skyGeo, skyMat);
            scene.add(skyMesh);
        }
        createSunsetSky();

        // Balanced Golden Hour Lighting (Rich contrast, no overexposure)
        const hemiLight = new THREE.HemisphereLight(0xffcf9e, 0x3d2214, 0.62);
        scene.add(hemiLight);

        const sunPosition = new THREE.Vector3(-190, 95, -150);
        const dirLight = new THREE.DirectionalLight(0xffaa5c, 0.92);
        dirLight.position.copy(sunPosition);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 2048;
        dirLight.shadow.mapSize.height = 2048;
        dirLight.shadow.camera.near = 10;
        dirLight.shadow.camera.far = 480;
        const d = 185;
        dirLight.shadow.camera.left = -d;
        dirLight.shadow.camera.right = d;
        dirLight.shadow.camera.top = d;
        dirLight.shadow.camera.bottom = -d;
        dirLight.shadow.bias = -0.0005;
        scene.add(dirLight);

        // Distant Sunset Sun Orb in the Sky Horizon
        const sunGroup = new THREE.Group();
        scene.add(sunGroup);

        const sunGlowTex = createSunGlowTexture();
        const sunSprite = new THREE.Sprite(
            new THREE.SpriteMaterial({
                map: sunGlowTex,
                color: 0xffbe73,
                transparent: true,
                opacity: 0.75,
                blending: THREE.AdditiveBlending,
                depthWrite: false,
                fog: false
            })
        );
        sunSprite.position.copy(sunPosition.clone().multiplyScalar(1.8));
        sunSprite.scale.set(110, 110, 1);
        sunGroup.add(sunSprite);

        // Subtle Distant Horizon Sunbeams (Kept far away from camera so it never blinds the screen)
        const godRaysGroup = new THREE.Group();
        scene.add(godRaysGroup);
        const godRayMeshes = [];

        const rayMat = new THREE.MeshBasicMaterial({
            color: 0xffae63,
            transparent: true,
            opacity: 0.022,
            side: THREE.FrontSide,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            fog: false
        });

        for (let i = 0; i < 6; i++) {
            const rayGeo = new THREE.CylinderGeometry(1.5, 9, 180, 12, 1, true);
            const rayMesh = new THREE.Mesh(rayGeo, rayMat.clone());

            const targetPt = new THREE.Vector3(-120 + i * 28, 0, -145 + (i % 2) * 15);
            const midPt = new THREE.Vector3().addVectors(sunPosition, targetPt).multiplyScalar(0.5);
            rayMesh.position.copy(midPt);
            rayMesh.lookAt(sunPosition);
            rayMesh.rotateX(Math.PI / 2);

            godRaysGroup.add(rayMesh);
            godRayMeshes.push({
                mesh: rayMesh,
                baseOpacity: 0.018 + Math.random() * 0.012,
                phase: Math.random() * Math.PI * 2
            });
        }

        /********************************************************************
         * 4. PROCEDURAL TEXTURES FOR EXTENDED WORLD
         ********************************************************************/
        function createWoodPlankTexture(repeatX = 1, repeatY = 1) {
            const canvas = document.createElement('canvas');
            canvas.width = 256; canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#5c3a21'; ctx.fillRect(0, 0, 256, 256);
            const planks = 8; const h = 256 / planks;
            for (let i = 0; i < planks; i++) {
                const y = i * h;
                ctx.fillStyle = i % 2 === 0 ? '#6a4326' : '#52321a';
                ctx.fillRect(0, y, 256, h - 2);
                ctx.fillStyle = 'rgba(35, 18, 8, 0.35)';
                for (let j = 0; j < 14; j++) {
                    ctx.fillRect(Math.random() * 256, y + Math.random() * (h - 4), 25 + Math.random() * 75, 1.5);
                }
                ctx.fillStyle = '#1e1107';
                ctx.beginPath(); ctx.arc(14, y + h / 2, 2.5, 0, Math.PI * 2); ctx.fill();
                ctx.beginPath(); ctx.arc(242, y + h / 2, 2.5, 0, Math.PI * 2); ctx.fill();
            }
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createRockCliffTexture(repeatX = 4, repeatY = 4) {
            const canvas = document.createElement('canvas');
            canvas.width = 256; canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#5a524a'; ctx.fillRect(0, 0, 256, 256);
            const strata = ['#4c453e', '#665d54', '#3d3731', '#73695f', '#443e37', '#584f45', '#38332c'];
            for (let y = 0; y < 256; y += 4) {
                ctx.fillStyle = strata[Math.floor(Math.random() * strata.length)];
                ctx.fillRect(0, y, 256, 4);
            }
            for (let i = 0; i < 700; i++) {
                ctx.fillStyle = strata[i % strata.length];
                ctx.fillRect(Math.random() * 256, Math.random() * 256, 3 + Math.random() * 8, 2 + Math.random() * 3);
            }
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createWaterTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256; canvas.height = 256;
            const ctx = canvas.getContext('2d');
            const grad = ctx.createLinearGradient(0, 0, 256, 256);
            grad.addColorStop(0, '#19618a');
            grad.addColorStop(0.5, '#2582b3');
            grad.addColorStop(1.0, '#154e6f');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 256, 256);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
            ctx.lineWidth = 2.0;
            for (let i = 0; i < 50; i++) {
                ctx.beginPath();
                const x = Math.random() * 256; const y = Math.random() * 256;
                ctx.arc(x, y, 10 + Math.random() * 30, 0, Math.PI * 0.85);
                ctx.stroke();
            }
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(3, 30);
            return tex;
        }

        function createCornTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#497c27'; ctx.fillRect(0, 0, 128, 256);
            ctx.fillStyle = '#eab308'; ctx.fillRect(36, 60, 56, 120);
            ctx.fillStyle = '#ca8a04';
            for (let y = 64; y < 176; y += 8) ctx.fillRect(36, y, 56, 2);
            for (let x = 40; x < 90; x += 8) ctx.fillRect(x, 60, 2, 120);
            ctx.fillStyle = '#3f6212';
            ctx.beginPath(); ctx.moveTo(36, 180); ctx.lineTo(22, 95); ctx.lineTo(36, 115); ctx.fill();
            ctx.beginPath(); ctx.moveTo(92, 180); ctx.lineTo(106, 95); ctx.lineTo(92, 115); ctx.fill();
            const tex = new THREE.CanvasTexture(canvas);
            return tex;
        }

        /********************************************************************
         * 5. WORLD GEOMETRY & EXPANSIVE LANDMARKS (refrensi-denah.jpeg)
         ********************************************************************/
        const colliders = [];

        function addBoxCollider(cx, cz, width, depth) {
            colliders.push({
                minX: cx - width / 2,
                maxX: cx + width / 2,
                minZ: cz - depth / 2,
                maxZ: cz + depth / 2
            });
        }

        // BOUNDARY PERIMETER COLLIDERS (Guarantees zero void fall!)
        addBoxCollider(0, -320, 1500, 30);
        addBoxCollider(0, 320, 1500, 30);
        addBoxCollider(-640, 0, 30, 750);
        addBoxCollider(640, 0, 30, 750);

        // Huge Solid Autumn Ground Plane
        const groundTex = createAutumnGroundTexture(96, 48);
        const groundGeo = new THREE.PlaneGeometry(1320, 700);
        const groundMat = new THREE.MeshStandardMaterial({
            map: groundTex,
            roughness: 0.88,
            metalness: 0.05
        });
        const ground = new THREE.Mesh(groundGeo, groundMat);
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        scene.add(ground);

        // Materials
        const factoryBrickMat = new THREE.MeshStandardMaterial({
            map: createBrickTexture('#8b4730', ['#9e4f36', '#863f28', '#ad5d42', '#753622'], '#bba693', 6, 3),
            roughness: 0.78,
            metalness: 0.05
        });
        const darkRoofBrickMat = new THREE.MeshStandardMaterial({
            map: createBrickTexture('#2b2d2f', ['#282a2c', '#343739', '#1f2122'], '#595959', 8, 2),
            roughness: 0.65,
            metalness: 0.15
        });
        const houseCreamBrickMat = new THREE.MeshStandardMaterial({
            map: createBrickTexture('#dfd3c3', ['#e5dacb', '#d8cbb8', '#eee4d7', '#cfbda8'], '#b5a899', 5, 3),
            roughness: 0.75,
            metalness: 0.05
        });
        const garageDoorMat = new THREE.MeshStandardMaterial({
            map: createGarageDoorTexture(),
            roughness: 0.4,
            metalness: 0.25
        });
        const woodBridgeMat = new THREE.MeshStandardMaterial({
            map: createWoodPlankTexture(3, 1),
            roughness: 0.72,
            metalness: 0.08
        });
        const rockCliffMat = new THREE.MeshStandardMaterial({
            map: createRockCliffTexture(4, 4),
            roughness: 0.90,
            metalness: 0.06,
            flatShading: true
        });
        const asphaltMat = new THREE.MeshStandardMaterial({
            map: createAsphaltTexture(8, 8),
            roughness: 0.52,
            metalness: 0.14
        });
        const waterTex = createWaterTexture();
        const waterMat = new THREE.MeshStandardMaterial({
            map: waterTex,
            color: 0x38bdf8,
            transparent: true,
            opacity: 0.85,
            roughness: 0.10,
            metalness: 0.55
        });

        // ====================================================================
        // A) PABRIK (PIZZA FACTORY DEPOT) - FAR WEST (X = -440, Z = 0)
        // ====================================================================
        const factoryGroup = new THREE.Group();
        factoryGroup.position.set(-540, 0, 0);
        factoryGroup.rotation.y = Math.PI / 2; // Facing East (+X towards road!)
        scene.add(factoryGroup);

        // Factory Courtyard & Forecourt (Wide asphalt parking area)
        const factoryLot = new THREE.Mesh(new THREE.BoxGeometry(120, 0.14, 55), asphaltMat);
        factoryLot.position.set(-480, 0.07, 0);
        factoryLot.receiveShadow = true;
        scene.add(factoryLot);

        // White parking stripes
        for (let i = -2; i <= 2; i++) {
            const stripe = new THREE.Mesh(
                new THREE.BoxGeometry(3.6, 0.16, 0.28),
                new THREE.MeshBasicMaterial({ color: 0xffffff })
            );
            stripe.position.set(-510, 0.09, i * 4.6);
            scene.add(stripe);
        }

        // Main Factory Depot Building Body
        const mainDepot = new THREE.Mesh(new THREE.BoxGeometry(36, 17, 26), factoryBrickMat);
        mainDepot.position.set(0, 8.5, -6);
        mainDepot.castShadow = true;
        factoryGroup.add(mainDepot);
        addBoxCollider(-546, 0, 28, 40); // factory building collider (world space)

        // Open Loading Garage Bay Header
        const bayHeader = new THREE.Mesh(new THREE.BoxGeometry(24, 3.2, 1.5), factoryBrickMat);
        bayHeader.position.set(0, 15.0, 7);
        factoryGroup.add(bayHeader);

        const bayRollDoor = new THREE.Mesh(new THREE.BoxGeometry(24, 3.6, 0.8), garageDoorMat);
        bayRollDoor.position.set(0, 11.6, 7.2);
        factoryGroup.add(bayRollDoor);

        // Interior Bay Floor
        const bayFloor = new THREE.Mesh(
            new THREE.BoxGeometry(28, 0.2, 22),
            new THREE.MeshLambertMaterial({ color: 0xc86432 })
        );
        bayFloor.position.set(0, 0.12, -2);
        factoryGroup.add(bayFloor);

        // Twin Industrial Smokestacks
        [-7, 7].forEach(sx => {
            const chimney = new THREE.Mesh(
                new THREE.CylinderGeometry(2.0, 2.6, 20, 12),
                new THREE.MeshLambertMaterial({ color: 0x6e5544 })
            );
            chimney.position.set(sx, 25, -10);
            factoryGroup.add(chimney);
        });

        // Bright Illuminated Factory Billboard Sign
        const signCanvas = document.createElement('canvas');
        signCanvas.width = 512; signCanvas.height = 128;
        const sctx = signCanvas.getContext('2d');
        sctx.fillStyle = '#b91c1c'; sctx.fillRect(0, 0, 512, 128);
        sctx.strokeStyle = '#facc15'; sctx.lineWidth = 10; sctx.strokeRect(5, 5, 502, 118);
        sctx.fillStyle = '#ffffff'; sctx.font = 'bold 36px Fredoka, sans-serif';
        sctx.textAlign = 'center'; sctx.fillText('🍕 PABRIK PIZZA DEPOT', 256, 52);
        sctx.fillStyle = '#fde047'; sctx.font = 'bold 22px Inter, sans-serif';
        sctx.fillText('TITIK AWAL • PUSAT DISTRIBUSI', 256, 95);
        const depotSignMat = new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(signCanvas) });
        const depotSign = new THREE.Mesh(new THREE.BoxGeometry(20, 5.0, 0.5), depotSignMat);
        depotSign.position.set(0, 18.2, 7.4);
        factoryGroup.add(depotSign);

        // Factory Pickup Pad (Player reverses into this pad to load pizza!)
        const pickupZonePos = new THREE.Vector3(-513, 0.2, 0);
        const pickupPadGroup = new THREE.Group();
        pickupPadGroup.position.copy(pickupZonePos);
        scene.add(pickupPadGroup);

        const padBorder = new THREE.Mesh(
            new THREE.RingGeometry(3.8, 4.6, 32),
            new THREE.MeshBasicMaterial({ color: 0xfacc15, side: THREE.DoubleSide })
        );
        padBorder.rotation.x = -Math.PI / 2;
        pickupPadGroup.add(padBorder);

        const padInner = new THREE.Mesh(
            new THREE.CircleGeometry(3.8, 32),
            new THREE.MeshBasicMaterial({ color: 0x22c55e, transparent: true, opacity: 0.35, side: THREE.DoubleSide })
        );
        padInner.rotation.x = -Math.PI / 2;
        pickupPadGroup.add(padInner);

        // Warm Factory Light
        const factoryLight = new THREE.PointLight(0xff9922, 2.2, 50);
        factoryLight.position.set(0, 12, 2);
        factoryGroup.add(factoryLight);

        // ====================================================================
        // B) SMOOTH SPLINE HIGHWAY (Continuous Curving Asphalt Ribbon)
        // ====================================================================
        // Road layout matching refrensi-denah.jpeg:
        // Factory (far west) → straight east → curve south to bridge → river canyon → tunnel → railroad → cornfield → residential
        const highwayPoints = [
            [-535, 0],    // 0: Factory garage exit (car reverses here to pick up)
            [-490, 0],    // 1: Factory forecourt straight east
            [-450, 0],    // 2: Open forecourt area
            [-410, 0],    // 3: Road begins heading east (spawn point zone)
            [-370, 0],    // 4: Leaving factory area 
            [-335, 8],    // 5: Gentle curve south toward river
            [-295, 22],   // 6: Curving south approaching river
            [-262, 38],   // 7: West wooden bridge entry (Bridge at Z=38)
            [-215, 38],   // 8: East wooden bridge exit
            [-175, 25],   // 9: Curve east off bridge
            [-138, 5],    // 10: Canyon road south, approaching cliffs
            [-100, -18],  // 11: West mountain tunnel portal entry
            [-48, -18],   // 12: East mountain tunnel portal exit
            [-10, -8],    // 13: Winding out of tunnel eastward
            [28, 12],     // 14: S-curve around Tebing 2
            [70, 28],     // 15: Straightening towards railway
            [108, 28],    // 16: Railroad crossing
            [158, 24],    // 17: East of railroad
            [225, 18],    // 18: Along cornfield south edge
            [290, 8],     // 19: Approaching residential
            [345, 0]      // 20: Residential district entrance
        ];

        // Create Smooth 3D Spline
        const spline3D = new THREE.CatmullRomCurve3(
            highwayPoints.map(p => new THREE.Vector3(p[0], 0.25, p[1])),
            false,
            'catmullrom',
            0.5
        );

        // Generate Continuous Road Ribbon Mesh (Zero box corners!)
        const roadSubdivs = 280;
        const roadWidth = 14.5;
        const roadPositions = [];
        const roadUvs = [];
        const roadIndices = [];

        // Center dash stripe positions
        const dashPositions = [];
        const dashUvs = [];
        const dashIndices = [];

        // Yellow edge lines
        const edgeLeftPositions = [];
        const edgeRightPositions = [];
        const edgeIndices = [];

        for (let i = 0; i <= roadSubdivs; i++) {
            const t = i / roadSubdivs;
            const pt = spline3D.getPoint(t);
            const tan = spline3D.getTangent(t);

            // Perpendicular lateral vector in XZ plane
            const normX = -tan.z;
            const normZ = tan.x;
            const normLen = Math.hypot(normX, normZ) || 1;
            const nx = normX / normLen;
            const nz = normZ / normLen;

            // Road surface vertices
            const lx = pt.x + nx * (roadWidth / 2);
            const lz = pt.z + nz * (roadWidth / 2);
            const rx = pt.x - nx * (roadWidth / 2);
            const rz = pt.z - nz * (roadWidth / 2);

            roadPositions.push(lx, pt.y, lz);
            roadPositions.push(rx, pt.y, rz);
            roadUvs.push(0, t * 45);
            roadUvs.push(1, t * 45);

            // FIX: correct CCW winding so road faces UP (visible from above)
            if (i < roadSubdivs) {
                const b = i * 2;
                roadIndices.push(b, b + 2, b + 1);
                roadIndices.push(b + 1, b + 2, b + 3);
            }

            // Dashed center line ribbon (FIX: use nz not nx for second push!)
            const cWidth = 0.38;
            dashPositions.push(pt.x + nx * cWidth, pt.y + 0.04, pt.z + nz * cWidth);
            dashPositions.push(pt.x - nx * cWidth, pt.y + 0.04, pt.z - nz * cWidth);
            dashUvs.push(0, t * 90);
            dashUvs.push(1, t * 90);
            if (i < roadSubdivs) {
                const b = i * 2;
                dashIndices.push(b, b + 2, b + 1);
                dashIndices.push(b + 1, b + 2, b + 3);
            }

            // Yellow edge stripes (visible from above with correct winding)
            const eWidth = 0.32;
            const eOffset = roadWidth / 2 - 0.5;
            // Left edge stripe
            edgeLeftPositions.push(pt.x + nx * (eOffset + eWidth), pt.y + 0.035, pt.z + nz * (eOffset + eWidth));
            edgeLeftPositions.push(pt.x + nx * (eOffset - eWidth), pt.y + 0.035, pt.z + nz * (eOffset - eWidth));
            // Right edge stripe
            edgeRightPositions.push(pt.x - nx * (eOffset - eWidth), pt.y + 0.035, pt.z - nz * (eOffset - eWidth));
            edgeRightPositions.push(pt.x - nx * (eOffset + eWidth), pt.y + 0.035, pt.z - nz * (eOffset + eWidth));

            if (i < roadSubdivs) {
                const b = i * 2;
                edgeIndices.push(b, b + 2, b + 1);
                edgeIndices.push(b + 1, b + 2, b + 3);
            }
        }

        // Build Road Surface Mesh
        const roadGeo = new THREE.BufferGeometry();
        roadGeo.setAttribute('position', new THREE.Float32BufferAttribute(roadPositions, 3));
        roadGeo.setAttribute('uv', new THREE.Float32BufferAttribute(roadUvs, 2));
        roadGeo.setIndex(roadIndices);
        roadGeo.computeVertexNormals();

        const roadMesh = new THREE.Mesh(roadGeo, asphaltMat);
        roadMesh.receiveShadow = true;
        roadMesh.renderOrder = 1; // render on top of ground
        scene.add(roadMesh);

        // Dashed Center Line (Procedural dashed canvas texture)
        const dashCanvas = document.createElement('canvas');
        dashCanvas.width = 64; dashCanvas.height = 128;
        const dctx = dashCanvas.getContext('2d');
        dctx.fillStyle = '#ffffff';
        dctx.fillRect(0, 0, 64, 72); // dash
        dctx.clearRect(0, 72, 64, 56); // gap
        const centerLineTex = new THREE.CanvasTexture(dashCanvas);
        centerLineTex.wrapS = THREE.RepeatWrapping; centerLineTex.wrapT = THREE.RepeatWrapping;
        centerLineTex.repeat.set(1, 48);

        const centerDashMat = new THREE.MeshBasicMaterial({
            map: centerLineTex,
            transparent: true,
            color: 0xffffff
        });
        const dashGeo = new THREE.BufferGeometry();
        dashGeo.setAttribute('position', new THREE.Float32BufferAttribute(dashPositions, 3));
        dashGeo.setAttribute('uv', new THREE.Float32BufferAttribute(dashUvs, 2));
        dashGeo.setIndex(dashIndices);
        const centerDashMesh = new THREE.Mesh(dashGeo, centerDashMat);
        scene.add(centerDashMesh);

        // Yellow Edge Ribbons
        const yellowEdgeMat = new THREE.MeshBasicMaterial({ color: 0xffe066 });
        const leftEdgeGeo = new THREE.BufferGeometry();
        leftEdgeGeo.setAttribute('position', new THREE.Float32BufferAttribute(edgeLeftPositions, 3));
        leftEdgeGeo.setIndex(edgeIndices);
        scene.add(new THREE.Mesh(leftEdgeGeo, yellowEdgeMat));

        const rightEdgeGeo = new THREE.BufferGeometry();
        rightEdgeGeo.setAttribute('position', new THREE.Float32BufferAttribute(edgeRightPositions, 3));
        rightEdgeGeo.setIndex(edgeIndices);
        scene.add(new THREE.Mesh(rightEdgeGeo, yellowEdgeMat));

        // ====================================================================
        // C) SUNGAI (RIVER) & JEMBATAN KAYU (WOODEN BRIDGE)
        // ====================================================================
        // River Trench - runs North-South at X = -238, below the bridge at Z=38
        const riverGroup = new THREE.Group();
        scene.add(riverGroup);

        // Lowered Riverbed at Y = -2.5
        const riverBed = new THREE.Mesh(
            new THREE.PlaneGeometry(50, 660),
            new THREE.MeshStandardMaterial({ color: 0x1f2b30, roughness: 0.95 })
        );
        riverBed.position.set(-238, -2.5, 0);
        riverBed.rotation.x = -Math.PI / 2;
        riverGroup.add(riverBed);

        // Sloping West & East Riverbanks
        [-260, -216].forEach((bx, idx) => {
            const bankSlope = new THREE.Mesh(
                new THREE.BoxGeometry(8, 2.5, 660),
                new THREE.MeshStandardMaterial({ color: 0x4a3b2c, roughness: 0.9 })
            );
            bankSlope.position.set(bx, -1.2, 0);
            bankSlope.rotation.z = idx === 0 ? -0.38 : 0.38;
            riverGroup.add(bankSlope);
        });

        // Water Mesh with shiny blue ripples at Y = -1.3
        const riverWater = new THREE.Mesh(new THREE.PlaneGeometry(44, 660), waterMat);
        riverWater.position.set(-238, -1.3, 0);
        riverWater.rotation.x = -Math.PI / 2;
        riverGroup.add(riverWater);

        // River Rocks & Boulders scattered along the water shore
        for (let i = 0; i < 40; i++) {
            const rock = new THREE.Mesh(
                new THREE.DodecahedronGeometry(1.2 + Math.random() * 1.8, 0),
                rockCliffMat
            );
            const side = Math.random() > 0.5 ? -254 : -222;
            rock.position.set(side + (Math.random() - 0.5) * 5, -1.2, -260 + i * 13.5);
            rock.rotation.set(Math.random(), Math.random(), Math.random());
            riverGroup.add(rock);
        }

        // Wooden Bridge Structure - spans river from X=-262 to X=-215 at Z=38 (matching road points 5-6)
        const bridgeGroup = new THREE.Group();
        bridgeGroup.position.set(-238, 0, 38); // Centered over river, aligned with road
        scene.add(bridgeGroup);

        // Heavy Timber Plank Bridge Deck (47m length x 15m width at Y = 0.3)
        const bridgeDeck = new THREE.Mesh(
            new THREE.BoxGeometry(48, 0.55, 15.5),
            woodBridgeMat
        );
        bridgeDeck.position.set(0, 0.3, 0);
        bridgeDeck.receiveShadow = true;
        bridgeGroup.add(bridgeDeck);

        // Bridge Guardrails (North & South sides)
        [-7.5, 7.5].forEach(sideZ => {
            // Top Rail Beam
            const topRail = new THREE.Mesh(new THREE.BoxGeometry(48, 0.38, 0.48), woodBridgeMat);
            topRail.position.set(0, 1.9, sideZ);
            topRail.castShadow = true;
            bridgeGroup.add(topRail);

            // Mid Rail Beam
            const midRail = new THREE.Mesh(new THREE.BoxGeometry(48, 0.28, 0.38), woodBridgeMat);
            midRail.position.set(0, 1.1, sideZ);
            bridgeGroup.add(midRail);

            // Vertical Posts every 4.5m
            for (let px = -24; px <= 24; px += 4.5) {
                const post = new THREE.Mesh(new THREE.BoxGeometry(0.55, 2.2, 0.55), woodBridgeMat);
                post.position.set(px, 1.1, sideZ);
                post.castShadow = true;
                bridgeGroup.add(post);
            }
        });

        // Bridge Guardrail Colliders
        addBoxCollider(-238, 38 - 7.8, 50, 1.8);
        addBoxCollider(-238, 38 + 7.8, 50, 1.8);

        // Heavy Timber Piling Trestles underneath extending down into water
        [-18, -6, 6, 18].forEach(tx => {
            for (let tz = -5; tz <= 5; tz += 5) {
                const trestle = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.9, 16, 8), woodBridgeMat);
                trestle.position.set(tx, -6.5, tz);
                bridgeGroup.add(trestle);
            }
        });

        // 4 Warm Glowing Lanterns on Bridge Entry Posts
        [[-24, -7.5], [-24, 7.5], [24, -7.5], [24, 7.5]].forEach(([lx, lz]) => {
            const lantern = new THREE.Mesh(
                new THREE.BoxGeometry(0.75, 1.1, 0.75),
                new THREE.MeshBasicMaterial({ color: 0xffd580 })
            );
            lantern.position.set(lx, 2.4, lz);
            bridgeGroup.add(lantern);

            const pLight = new THREE.PointLight(0xffaa44, 1.5, 22);
            pLight.position.set(lx, 2.6, lz);
            bridgeGroup.add(pLight);
        });

        // ====================================================================
        // D) STRATIFIED CLIFFS (TEBING 1 & 2) & MOUNTAIN TUNNEL (TEROWONGAN)
        // ====================================================================
        const cliffGroup = new THREE.Group();
        scene.add(cliffGroup);

        // Helper to create sheer stratified rock cliffs (layered blocks matching sketch)
        function createStratifiedCliff(cx, cy, cz, w, h, d, rotY = 0) {
            const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), rockCliffMat);
            mesh.position.set(cx, cy, cz);
            mesh.rotation.y = rotY;
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            cliffGroup.add(mesh);
            addBoxCollider(cx, cz, w + 1, d + 1);
            return mesh;
        }

        // TEBING 1: Canyon Walls flanking road approaching tunnel (X = -160 to -100, Z=-18 road)
        // North Canyon Wall (Z negative = north)
        createStratifiedCliff(-148, 11, -42, 24, 22, 22);
        createStratifiedCliff(-125, 14, -50, 28, 28, 24);
        createStratifiedCliff(-108, 12, -45, 22, 20, 20);
        // South Canyon Wall (Z positive = south)
        createStratifiedCliff(-155, 10, 18, 22, 20, 20);
        createStratifiedCliff(-132, 13, 22, 24, 24, 20);
        createStratifiedCliff(-112, 11, 18, 20, 22, 18);

        // MOUNTAIN MASSIF & TUNNEL STRUCTURE (Road points 9-10: X=-100 to X=-48 at Z=-18)
        const tunnelGroup = new THREE.Group();
        tunnelGroup.position.set(-74, 0, -18); // Center between X=-100 and X=-48
        scene.add(tunnelGroup);

        // Mountain Ridge Massif over the tunnel
        createStratifiedCliff(-82, 16, -18, 28, 34, 38); // Center massif
        createStratifiedCliff(-50, 15, -18, 26, 30, 36); // East massif
        createStratifiedCliff(-66, 22, -18, 34, 20, 32); // High mountain ridge top
        // Tebing 1: Rocky cliffs flanking the canyon road before the tunnel
        createStratifiedCliff(-120, 10, -8, 20, 22, 30);
        createStratifiedCliff(-130, 12, 5, 18, 24, 25);

        // Grand Stone Arch Portals - local positions relative to tunnelGroup at (-74,0,-18)
        [-26, 26].forEach((px, pIdx) => {
            const portalFrame = new THREE.Mesh(
                new THREE.BoxGeometry(3.6, 14, 24),
                rockCliffMat
            );
            portalFrame.position.set(px, 7.0, 0);
            portalFrame.castShadow = true;
            tunnelGroup.add(portalFrame);

            // Arched Header Stone with Keystone
            const archHeader = new THREE.Mesh(
                new THREE.BoxGeometry(4.2, 4.0, 16),
                factoryBrickMat
            );
            archHeader.position.set(px, 12.5, 0);
            tunnelGroup.add(archHeader);

            const keystone = new THREE.Mesh(
                new THREE.BoxGeometry(4.4, 2.5, 2.8),
                new THREE.MeshLambertMaterial({ color: 0xdfd3c3 })
            );
            keystone.position.set(px, 12.0, 0);
            tunnelGroup.add(keystone);

            // Portal Wing Walls flaring out into the cliffs
            const wingWallL = new THREE.Mesh(new THREE.BoxGeometry(3.0, 16, 8), rockCliffMat);
            wingWallL.position.set(px, 8.0, -14);
            wingWallL.rotation.y = pIdx === 0 ? 0.35 : -0.35;
            tunnelGroup.add(wingWallL);

            const wingWallR = new THREE.Mesh(new THREE.BoxGeometry(3.0, 16, 8), rockCliffMat);
            wingWallR.position.set(px, 8.0, 14);
            wingWallR.rotation.y = pIdx === 0 ? -0.35 : 0.35;
            tunnelGroup.add(wingWallR);
        });

        // Tunnel Arched Stone Ceiling Vault (Length = 55m)
        const tunnelVault = new THREE.Mesh(
            new THREE.CylinderGeometry(8.5, 8.5, 55, 24, 1, true, 0, Math.PI),
            rockCliffMat
        );
        tunnelVault.rotation.z = Math.PI / 2;
        tunnelVault.position.set(0, 4.2, 0);
        tunnelGroup.add(tunnelVault);

        // 4 Overhead Warm Amber Sodium Tunnel Lamps
        [-18, -6, 6, 18].forEach(lx => {
            const lampFixture = new THREE.Mesh(
                new THREE.BoxGeometry(1.2, 0.45, 0.8),
                new THREE.MeshBasicMaterial({ color: 0xffaa22 })
            );
            lampFixture.position.set(lx, 7.8, 0);
            tunnelGroup.add(lampFixture);

            const tLight = new THREE.PointLight(0xff9911, 2.4, 26);
            tLight.position.set(lx, 7.2, 0);
            tunnelGroup.add(tLight);
        });

        // Tunnel Solid Wall Colliders (at Z=-18, length 52m)
        addBoxCollider(-74, -18 - 8.5, 54, 2.0);
        addBoxCollider(-74, -18 + 8.5, 54, 2.0);

        // TEBING 2: Post-Tunnel Cliff Bluff forcing S-curve (road points 11-12)
        createStratifiedCliff(12, 12, 12, 24, 26, 22);
        createStratifiedCliff(30, 14, 20, 22, 28, 20);
        createStratifiedCliff(48, 10, 28, 18, 20, 18);

        // Red/White Chevron Curve Signs (>>>) along S-Curve around Tebing 2
        for (let i = 0; i < 4; i++) {
            const signGroup = new THREE.Group();
            signGroup.position.set(-5 + i * 12, 0, -3 + i * 6.5);
            signGroup.rotation.y = -Math.PI / 4;
            scene.add(signGroup);

            const sPost = new THREE.Mesh(
                new THREE.BoxGeometry(0.2, 2.4, 0.2),
                new THREE.MeshLambertMaterial({ color: 0x475569 })
            );
            sPost.position.y = 1.2;
            signGroup.add(sPost);

            const sBoard = new THREE.Mesh(
                new THREE.BoxGeometry(1.6, 1.2, 0.15),
                new THREE.MeshBasicMaterial({ color: 0xef4444 })
            );
            sBoard.position.y = 2.2;
            signGroup.add(sBoard);
        }

        // ====================================================================
        // E) REL KERETA API (RAILROAD TRACKS LEVEL CROSSING - at X=108, Z=28)
        // ====================================================================
        const railGroup = new THREE.Group();
        railGroup.position.set(108, 0, 0);
        scene.add(railGroup);

        // Gravel Ballast Embankment
        const ballastMesh = new THREE.Mesh(
            new THREE.BoxGeometry(5.4, 0.18, 600),
            new THREE.MeshStandardMaterial({ color: 0x3e3832, roughness: 0.95 })
        );
        ballastMesh.position.set(0, 0.08, 0);
        ballastMesh.receiveShadow = true;
        railGroup.add(ballastMesh);

        // Wooden Ties (Sleepers every 1.8m)
        const tieGeo = new THREE.BoxGeometry(4.4, 0.22, 0.55);
        for (let rz = -280; rz <= 280; rz += 2.0) {
            if (rz > 16 && rz < 34) continue; // Leave crossing clear
            const tie = new THREE.Mesh(tieGeo, woodBridgeMat);
            tie.position.set(0, 0.14, rz);
            railGroup.add(tie);
        }

        // Twin Shiny Steel Rails
        const railMat = new THREE.MeshStandardMaterial({ color: 0xcccccc, metalness: 0.88, roughness: 0.22 });
        [-1.35, 1.35].forEach(rx => {
            const steelRail = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.32, 600), railMat);
            steelRail.position.set(rx, 0.28, 0);
            railGroup.add(steelRail);
        });

        // Flush Timber Crossing Planks at Z = 25
        const crossingPlank = new THREE.Mesh(new THREE.BoxGeometry(5.6, 0.16, 16.0), woodBridgeMat);
        crossingPlank.position.set(0, 0.12, 25);
        crossingPlank.receiveShadow = true;
        railGroup.add(crossingPlank);

        // Crossing Warning Signal Masts with Flashing Red Lamps
        const railroadFlasherLamps = [];
        [-9.5, 9.5].forEach((sigZ, sIdx) => {
            const sigGroup = new THREE.Group();
            sigGroup.position.set(sIdx === 0 ? -3.8 : 3.8, 0, 25 + sigZ);
            railGroup.add(sigGroup);

            const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 6.0, 8), new THREE.MeshLambertMaterial({ color: 0xeeeeee }));
            pole.position.y = 3.0;
            sigGroup.add(pole);

            const xMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
            const x1 = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.35, 0.1), xMat);
            x1.position.set(0, 5.2, 0);
            x1.rotation.z = Math.PI / 4;
            sigGroup.add(x1);

            const x2 = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.35, 0.1), xMat);
            x2.position.set(0, 5.2, 0);
            x2.rotation.z = -Math.PI / 4;
            sigGroup.add(x2);

            [-0.7, 0.7].forEach(lx => {
                const redLamp = new THREE.Mesh(new THREE.SphereGeometry(0.35, 8, 8), new THREE.MeshBasicMaterial({ color: 0xef4444 }));
                redLamp.position.set(lx, 4.2, 0);
                sigGroup.add(redLamp);
                railroadFlasherLamps.push(redLamp);
            });
        });

        // Parked Vintage Freight Locomotive on North Rail Spur (X = 110, Z = -110)
        const trainGroup = new THREE.Group();
        trainGroup.position.set(110, 0, -110);
        scene.add(trainGroup);

        const locoBody = new THREE.Mesh(new THREE.BoxGeometry(3.6, 5.2, 16), new THREE.MeshStandardMaterial({ color: 0x0369a1, roughness: 0.5 }));
        locoBody.position.set(0, 3.2, 0);
        trainGroup.add(locoBody);
        addBoxCollider(110, -110, 4.4, 18);

        const locoCab = new THREE.Mesh(new THREE.BoxGeometry(3.8, 3.2, 6), new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.5 }));
        locoCab.position.set(0, 6.2, -4);
        trainGroup.add(locoCab);

        // ====================================================================
        // F) LADANG JAGUNG (CORNFIELD) - NORTH OF ROAD (X = 145..290, Z = -145..5)
        // ====================================================================
        const farmGroup = new THREE.Group();
        farmGroup.position.set(220, 0, -70);
        scene.add(farmGroup);

        // Agricultural Soil Patch (150m width x 150m depth)
        const soilMesh = new THREE.Mesh(
            new THREE.PlaneGeometry(150, 150),
            new THREE.MeshStandardMaterial({ color: 0x422a18, roughness: 0.95 })
        );
        soilMesh.position.set(0, 0.05, 0);
        soilMesh.rotation.x = -Math.PI / 2;
        soilMesh.receiveShadow = true;
        farmGroup.add(soilMesh);

        // Ranch Post-and-Rail Fence along Road (South Border)
        const fenceMat = woodBridgeMat;
        for (let fx = -74; fx <= 74; fx += 5.0) {
            const fPost = new THREE.Mesh(new THREE.BoxGeometry(0.3, 1.8, 0.3), fenceMat);
            fPost.position.set(fx, 0.9, 74);
            farmGroup.add(fPost);
        }
        const sRail1 = new THREE.Mesh(new THREE.BoxGeometry(150, 0.18, 0.2), fenceMat);
        sRail1.position.set(0, 1.4, 74);
        farmGroup.add(sRail1);
        const sRail2 = new THREE.Mesh(new THREE.BoxGeometry(150, 0.18, 0.2), fenceMat);
        sRail2.position.set(0, 0.7, 74);
        farmGroup.add(sRail2);
        addBoxCollider(220, -70 + 74, 152, 1.5);

        // Dense Rows of 3D Corn Stalks with Leaves and Bright Yellow Corn Cobs!
        const cornTex = createCornTexture();
        const cornCobMat = new THREE.MeshBasicMaterial({ map: cornTex });
        const cornLeafMat = new THREE.MeshLambertMaterial({ color: 0x4d7c0f });
        const stalkGeo = new THREE.CylinderGeometry(0.12, 0.18, 3.8, 5);
        const cobGeo = new THREE.CylinderGeometry(0.16, 0.22, 1.2, 6);

        for (let rowX = -65; rowX <= 65; rowX += 5.2) {
            for (let rowZ = -65; rowZ <= 65; rowZ += 4.5) {
                const stalk = new THREE.Mesh(stalkGeo, cornLeafMat);
                stalk.position.set(rowX + (Math.random() - 0.5) * 0.8, 1.9, rowZ + (Math.random() - 0.5) * 0.8);
                stalk.rotation.y = Math.random() * Math.PI;
                stalk.castShadow = true;
                farmGroup.add(stalk);

                const cob = new THREE.Mesh(cobGeo, cornCobMat);
                cob.position.set(0.25, 0.2, 0);
                cob.rotation.z = 0.45;
                stalk.add(cob);

                [-1, 1].forEach(ldir => {
                    const leaf = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.08, 0.35), cornLeafMat);
                    leaf.position.set(ldir * 0.55, 0.6, 0);
                    leaf.rotation.z = -ldir * 0.55;
                    stalk.add(leaf);
                });
            }
        }

        // Classic Red Farm Barn
        const barn = new THREE.Mesh(new THREE.BoxGeometry(18, 12, 24), new THREE.MeshStandardMaterial({ color: 0xb91c1c, roughness: 0.75 }));
        barn.position.set(50, 6.0, -45);
        barn.castShadow = true;
        farmGroup.add(barn);
        addBoxCollider(220 + 50, -70 - 45, 20, 26);

        const barnRoof = new THREE.Mesh(new THREE.ConeGeometry(15, 6, 4), darkRoofBrickMat);
        barnRoof.position.set(50, 15.0, -45);
        barnRoof.rotation.y = Math.PI / 4;
        farmGroup.add(barnRoof);

        // Windmill with Spinning Blades
        const windmillGroup = new THREE.Group();
        windmillGroup.position.set(-52, 0, -45);
        farmGroup.add(windmillGroup);

        const wmTower = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 2.6, 18, 8), woodBridgeMat);
        wmTower.position.y = 9.0;
        wmTower.castShadow = true;
        windmillGroup.add(wmTower);

        const wmRotor = new THREE.Group();
        wmRotor.position.set(0, 17.5, 1.6);
        windmillGroup.add(wmRotor);

        for (let b = 0; b < 4; b++) {
            const blade = new THREE.Mesh(new THREE.BoxGeometry(0.45, 6.5, 0.12), new THREE.MeshBasicMaterial({ color: 0xf1f5f9 }));
            blade.position.y = 3.25;
            blade.rotation.z = (b * Math.PI) / 2;
            wmRotor.add(blade);
        }

        // ====================================================================
        // G) PERUMAHAN (RESIDENTIAL 3x3 DISTRICT OF HOUSES A1..C3)
        // ====================================================================
        const colRoadX = [345, 405, 465];
        const rowZCoords = [-45, 10, 65];

        function createRoadBox(x, z, w, d) {
            const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, 0.14, d), asphaltMat);
            mesh.position.set(x, 0.07, z);
            mesh.receiveShadow = true;
            scene.add(mesh);
            return mesh;
        }

        // 3 Vertical Avenues for the Housing District
        colRoadX.forEach(rx => {
            createRoadBox(rx, 10, 14, 160);
        });

        // 4 Connecting Cross-Streets
        const crossRoadZ = [-70, -20, 35, 85];
        crossRoadZ.forEach(rz => {
            createRoadBox(405, rz, 148, 14);
        });

        const houses = {};
        const houseCodes = [
            { code: 'A1', col: 0, row: 0 },
            { code: 'A2', col: 1, row: 0 },
            { code: 'A3', col: 2, row: 0 },
            { code: 'B1', col: 0, row: 1 },
            { code: 'B2', col: 1, row: 1 },
            { code: 'B3', col: 2, row: 1 },
            { code: 'C1', col: 0, row: 2 },
            { code: 'C2', col: 1, row: 2 },
            { code: 'C3', col: 2, row: 2 }
        ];

        function createRobloxHouse(code, roadX, zPos, index) {
            const houseGroup = new THREE.Group();
            const houseX = roadX - 20;
            houseGroup.position.set(houseX, 0, zPos);
            scene.add(houseGroup);

            // Foundation Base
            const foundation = new THREE.Mesh(new THREE.BoxGeometry(16, 1.1, 14), new THREE.MeshLambertMaterial({ color: 0xc7bdb1 }));
            foundation.position.set(0, 0.55, 0);
            foundation.receiveShadow = true;
            houseGroup.add(foundation);

            // House Body
            const body = new THREE.Mesh(new THREE.BoxGeometry(12.5, 6.8, 13.6), houseCreamBrickMat);
            body.position.set(-1.6, 4.5, 0);
            body.castShadow = true;
            body.receiveShadow = true;
            houseGroup.add(body);
            addBoxCollider(houseX - 1.2, zPos, 15.5, 14.2);

            // Pitched Gable Roof
            const roofShape = new THREE.Shape();
            roofShape.moveTo(-8.2, 0);
            roofShape.lineTo(8.2, 0);
            roofShape.lineTo(0, 4.4);
            roofShape.closePath();

            const roofGeo = new THREE.ExtrudeGeometry(roofShape, { depth: 14.2, bevelEnabled: false });
            roofGeo.center();
            const roofMesh = new THREE.Mesh(roofGeo, darkRoofBrickMat);
            roofMesh.rotation.y = Math.PI / 2;
            roofMesh.position.set(0, 10.1, 0);
            roofMesh.castShadow = true;
            houseGroup.add(roofMesh);

            // Porch Pillars
            const pillarMat = new THREE.MeshLambertMaterial({ color: 0x26282a });
            [-6.4, 6.4].forEach(pz => {
                const pillar = new THREE.Mesh(new THREE.BoxGeometry(0.45, 6.8, 0.45), pillarMat);
                pillar.position.set(7.6, 4.5, pz);
                pillar.castShadow = true;
                houseGroup.add(pillar);
            });

            // Door & Knob
            const door = new THREE.Mesh(new THREE.BoxGeometry(0.3, 4.5, 2.4), new THREE.MeshLambertMaterial({ color: 0x5c3a21 }));
            door.position.set(4.65, 3.35, 0);
            houseGroup.add(door);

            const knob = new THREE.Mesh(new THREE.SphereGeometry(0.16, 8, 8), new THREE.MeshBasicMaterial({ color: 0xfacc15 }));
            knob.position.set(4.85, 3.1, 0.75);
            houseGroup.add(knob);

            // Glowing Windows
            const winMat = new THREE.MeshStandardMaterial({
                color: 0xffb36b,
                emissive: 0xd97736,
                emissiveIntensity: 0.55,
                roughness: 0.12,
                metalness: 0.6
            });
            [-6.85, 6.85].forEach(wz => {
                const win = new THREE.Mesh(new THREE.BoxGeometry(4.2, 2.5, 0.15), winMat);
                win.position.set(-1.6, 4.8, wz);
                houseGroup.add(win);
            });

            // Porch Light
            const porchLight = new THREE.PointLight(0xffb76b, 0.65, 18);
            porchLight.position.set(6.2, 6.8, 0);
            houseGroup.add(porchLight);

            // Concrete Footpath to Road
            const pathMesh = new THREE.Mesh(new THREE.BoxGeometry(6.5, 0.16, 2.4), new THREE.MeshLambertMaterial({ color: 0xb0a79e }));
            pathMesh.position.set(10.6, 0.08, 0);
            pathMesh.receiveShadow = true;
            houseGroup.add(pathMesh);

            // Mailbox with House Code Plaque
            const mailboxGroup = new THREE.Group();
            mailboxGroup.position.set(11.8, 0, -2.5);
            houseGroup.add(mailboxGroup);

            const post = new THREE.Mesh(new THREE.BoxGeometry(0.35, 2.6, 0.35), new THREE.MeshLambertMaterial({ color: 0x6b3e23 }));
            post.position.y = 1.3;
            mailboxGroup.add(post);

            const boxBody = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.75, 0.75), new THREE.MeshLambertMaterial({ color: 0xf5ebe1 }));
            boxBody.position.set(0.15, 2.4, 0);
            mailboxGroup.add(boxBody);

            const codeTex = createHouseCodeTexture(code);
            const signMesh = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.9, 1.65), new THREE.MeshBasicMaterial({ map: codeTex }));
            signMesh.position.set(0.15, 3.25, 0);
            mailboxGroup.add(signMesh);

            const bigSignSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: codeTex, transparent: true }));
            bigSignSprite.position.set(11.8, 6.2, -2.5);
            bigSignSprite.scale.set(4.5, 2.25, 1);
            houseGroup.add(bigSignSprite);

            // Delivery Drop-off Point in Front of Mailbox on Road
            const dropOffWorldPos = new THREE.Vector3(roadX - 2.5, 0.18, zPos - 1.2);

            houses[code] = {
                code,
                group: houseGroup,
                dropOffPos: dropOffWorldPos,
                housePos: new THREE.Vector3(houseX, 0, zPos)
            };
        }

        houseCodes.forEach((h, idx) => {
            createRobloxHouse(h.code, colRoadX[h.col], rowZCoords[h.row], idx);
        });

        // 3D Target Marker Beacon & Delivery Ring
        const targetMarkerGroup = new THREE.Group();
        targetMarkerGroup.visible = false;
        scene.add(targetMarkerGroup);

        const targetRingOuter = new THREE.Mesh(
            new THREE.RingGeometry(3.8, 4.6, 32),
            new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide })
        );
        targetRingOuter.rotation.x = -Math.PI / 2;
        targetMarkerGroup.add(targetRingOuter);

        const targetRingInner = new THREE.Mesh(
            new THREE.CircleGeometry(3.8, 32),
            new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.28, side: THREE.DoubleSide })
        );
        targetRingInner.rotation.x = -Math.PI / 2;
        targetMarkerGroup.add(targetRingInner);

        // 3D Expanding Progress Ring (10 seconds delay fill)
        const targetProgressFill = new THREE.Mesh(
            new THREE.CircleGeometry(3.78, 32),
            new THREE.MeshBasicMaterial({
                color: 0x38bdf8,
                transparent: true,
                opacity: 0.70,
                side: THREE.DoubleSide
            })
        );
        targetProgressFill.rotation.x = -Math.PI / 2;
        targetProgressFill.position.y = 0.04;
        targetProgressFill.scale.set(0.001, 0.001, 0.001);
        targetMarkerGroup.add(targetProgressFill);

        // Sky Beacon Beam
        const beaconBeam = new THREE.Mesh(
            new THREE.CylinderGeometry(0.65, 1.8, 120, 16, 1, true),
            new THREE.MeshBasicMaterial({
                color: 0x38bdf8,
                transparent: true,
                opacity: 0.35,
                side: THREE.DoubleSide,
                depthWrite: false
            })
        );
        beaconBeam.position.y = 60;
        targetMarkerGroup.add(beaconBeam);

        // ====================================================================
        // H) ROADSIDE TREES & ENVIRONMENT (FILLING ALL EMPTY WHITE SPACES)
        // ====================================================================
        const barkTex = createBarkTexture();
        const trunkMat = new THREE.MeshStandardMaterial({ map: barkTex, roughness: 0.85, metalness: 0.05 });
        const autumnCrownMaterials = [
            new THREE.MeshStandardMaterial({ map: createFoliageLeafTexture('#d4621a', '#f5822e', '#943808'), roughness: 0.68, flatShading: true }),
            new THREE.MeshStandardMaterial({ map: createFoliageLeafTexture('#d4902a', '#f5b342', '#9e6314'), roughness: 0.68, flatShading: true }),
            new THREE.MeshStandardMaterial({ map: createFoliageLeafTexture('#b54b1e', '#d66832', '#822f0d'), roughness: 0.68, flatShading: true }),
            new THREE.MeshStandardMaterial({ map: createFoliageLeafTexture('#366b28', '#528d3d', '#1f4714'), roughness: 0.68, flatShading: true })
        ];

        function createAutumnTree(x, z, scale = 1, addCollision = true) {
            const tree = new THREE.Group();
            tree.position.set(x, 0, z);

            const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.42 * scale, 0.72 * scale, 5.2 * scale, 7), trunkMat);
            trunk.position.y = 2.6 * scale;
            trunk.castShadow = true;
            tree.add(trunk);

            const primaryMat = autumnCrownMaterials[Math.floor(Math.random() * autumnCrownMaterials.length)];
            const secondaryMat = autumnCrownMaterials[Math.floor(Math.random() * autumnCrownMaterials.length)];

            const mainCrown = new THREE.Mesh(new THREE.IcosahedronGeometry(3.3 * scale, 1), primaryMat);
            mainCrown.position.set(0, 6.6 * scale, 0);
            mainCrown.rotation.set(Math.random(), Math.random(), Math.random());
            mainCrown.castShadow = true;
            tree.add(mainCrown);

            const topCrown = new THREE.Mesh(new THREE.DodecahedronGeometry(2.35 * scale, 1), secondaryMat);
            topCrown.position.set(0.2 * scale, 8.5 * scale, -0.2 * scale);
            topCrown.castShadow = true;
            tree.add(topCrown);

            scene.add(tree);
            if (addCollision) {
                addBoxCollider(x, z, 1.4 * scale, 1.4 * scale);
            }
        }

        function isSpotClearForTree(x, z) {
            // Clear area around factory and forecourt (factory now at X=-540)
            if (x < -380 && Math.abs(z) < 38) return false;
            // Clear bridge approach areas (river canyon at X=-238)
            if (Math.abs(x - (-238)) < 32) return false;
            // Clear cliff/canyon/tunnel zone
            if (x > -160 && x < -30 && Math.abs(z - (-8)) < 30) return false;
            // Clear S-curve around tebing 2
            if (x > -15 && x < 60 && z > -5 && z < 42) return false;
            // Clear railroad zone
            if (Math.abs(x - 108) < 16) return false;
            // Clear cornfield zone
            if (x > 140 && x < 295 && z > -155 && z < 15) return false;
            // Clear residential zone
            if (x > 310 && x < 500 && z > -85 && z < 100) return false;
            // Clear along road corridor (check each road segment midpoint)
            for (let i = 0; i < highwayPoints.length - 1; i++) {
                const px = (highwayPoints[i][0] + highwayPoints[i+1][0]) / 2;
                const pz = (highwayPoints[i][1] + highwayPoints[i+1][1]) / 2;
                if (Math.hypot(x - px, z - pz) < 18.0) return false;
            }
            return true;
        }

        // Roadside Tree Spawns (updated to match new road layout - placed on flanks, not on road)
        const treeSpawns = [
            // West area background trees
            [-530, -55], [-510, 55], [-490, -60], [-480, 65], [-460, -50],
            // Factory north/south flanks (road is at Z≈0 heading east)
            [-420, -48], [-400, -52], [-375, -58], [-355, -52],
            [-420, 58], [-400, 62], [-375, 65], [-355, 60],
            // River flanks east and west of canyon
            [-270, -82], [-270, -58], [-270, 92], [-270, 125],
            [-205, -82], [-205, -58], [-205, 92], [-205, 125],
            // Cliff and canyon south/north
            [-155, -68], [-135, -72], [-115, -70], [-90, -65],
            [-155, 42], [-135, 46], [-115, 42],
            // Post-tunnel sides
            [-20, -58], [8, -50], [22, -55],
            // S-curve zone flanks
            [-4, -62], [18, -56], [42, -64], [62, -57],
            [58, 68], [46, 74], [28, 70], [10, 65],
            // Railroad flanks
            [88, -82], [88, -48], [88, 82], [88, 122],
            [128, -82], [128, -48], [128, 82], [128, 122],
            // South road edge near cornfield
            [162, 58], [192, 60], [222, 58], [258, 52], [288, 44],
            // Residential outskirts
            [320, -102], [370, -102], [420, -102], [470, -102],
            [320, 118], [370, 118], [420, 118], [470, 118],
            [510, -55], [510, 0], [510, 55]
        ];

        treeSpawns.forEach(([tx, tz]) => {
            if (isSpotClearForTree(tx, tz)) {
                createAutumnTree(tx, tz, 0.9 + Math.random() * 0.45, true);
            }
        });

        for (let i = 0; i < 90; i++) {
            const rx = -500 + Math.random() * 1000;
            const rz = -230 + Math.random() * 460;
            if (isSpotClearForTree(rx, rz)) {
                createAutumnTree(rx, rz, 1.0 + Math.random() * 0.5, true);
            }
        }

        // Falling leaves particles
        const leafCount = 180;
        const leafGeo = new THREE.PlaneGeometry(0.48, 0.48);
        const leafGroup = new THREE.Group();
        scene.add(leafGroup);
        const leavesData = [];
        const leafColors = [0xd96b27, 0xe68a2e, 0xc23b22, 0xf59e0b, 0xb8531c];

        for (let i = 0; i < leafCount; i++) {
            const mat = new THREE.MeshBasicMaterial({ color: leafColors[i % leafColors.length], side: THREE.DoubleSide });
            const mesh = new THREE.Mesh(leafGeo, mat);
            mesh.position.set(-450 + Math.random() * 900, 2 + Math.random() * 26, -200 + Math.random() * 400);
            leafGroup.add(mesh);
            leavesData.push({ mesh, speedY: 1.5 + Math.random() * 1.6, swayOffset: Math.random() * Math.PI * 2 });
        }

        /********************************************************************
         * 8. PLAYER VEHICLE: RED CONVERTIBLE CAR (Ref Images 2, 3, 4)
         *    - Fixed 100% Straight & Flush Windshield Frame (windshieldGroup)
         *    - Glossy PBR Clearcoat Red Body + Real Headlight SpotLights
         ********************************************************************/
        const carGroup = new THREE.Group();
        scene.add(carGroup);

        const carChassis = new THREE.Group();
        carGroup.add(carChassis);

        // Rich Crimson Red Car Paint (Vibrant Roblox Red without white washout)
        const carRedMat = new THREE.MeshPhongMaterial({
            color: 0xd91b11,
            specular: 0x552222,
            shininess: 65
        });
        const darkInteriorMat = new THREE.MeshLambertMaterial({ color: 0x2f3337 });
        const blackTrimMat = new THREE.MeshLambertMaterial({ color: 0x141618 });

        // ====================================================================
        // HELPER FUNCTIONS: PROCEDURAL PRISMS (Flawless Roblox Prisms)
        // ====================================================================
        // ====================================================================
        // HELPER FUNCTIONS: PROCEDURAL CAR BODY PROFILES (Ref Images 3, 4, 5)
        // ====================================================================
        function createProfileMesh(points, width, material) {
            const shape = new THREE.Shape();
            shape.moveTo(points[0][0], points[0][1]);
            for (let i = 1; i < points.length; i++) {
                shape.lineTo(points[i][0], points[i][1]);
            }
            shape.closePath();

            const geo = new THREE.ExtrudeGeometry(shape, {
                depth: width,
                bevelEnabled: false
            });
            geo.translate(0, 0, -width / 2);
            geo.rotateY(Math.PI / 2);
            geo.computeVertexNormals();

            const mesh = new THREE.Mesh(geo, material);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            return mesh;
        }

        // Full Outer Side Silhouette Profile with Square Wheel Arches (Ref Image 3)
        // shape_X = -car_Z, shape_Y = car_Y
        const sideProfilePts = [
            [ 2.80, 0.50], // Front bumper bottom
            [ 2.80, 0.88], // Front bumper vertical top
            [ 2.35, 1.18], // Front 45-deg chamfer bevel top
            [ 0.90, 1.52], // Sloped hood to cowl
            [ 0.90, 1.15], // Step down to dipped door sill
            [-0.65, 1.15], // Door sill end
            [-0.65, 1.45], // Rise to trunk deck
            [-2.45, 1.45], // Flat trunk deck end
            [-2.70, 1.25], // Rear top chamfer bevel
            [-2.70, 0.98], // Rear bumper vertical bottom
            [-2.00, 0.50], // Angled underbody diffuser (Yellow bracket in Image 3 & 4!)
            [-2.00, 1.08], // Rear square wheel cutout rear edge
            [-0.80, 1.08], // Rear square wheel cutout top
            [-0.80, 0.50], // Rear square wheel cutout front edge
            [ 1.15, 0.50], // Door sill bottom
            [ 1.15, 1.08], // Front square wheel cutout rear edge
            [ 2.35, 1.08], // Front square wheel cutout top
            [ 2.35, 0.50]  // Front square wheel cutout front edge
        ];

        // Left & Right Outer Side Panels with Square Wheel Arches (Ref Image 3)
        const leftSidePanel = createProfileMesh(sideProfilePts, 0.20, carRedMat);
        leftSidePanel.position.x = -1.30;
        carChassis.add(leftSidePanel);

        const rightSidePanel = createProfileMesh(sideProfilePts, 0.20, carRedMat);
        rightSidePanel.position.x = 1.30;
        carChassis.add(rightSidePanel);

        // Center Front Hood Profile (Ref Images 3 & 5)
        const hoodPts = [
            [ 2.80, 0.50],
            [ 2.80, 0.88],
            [ 2.35, 1.18],
            [ 0.90, 1.52],
            [ 0.90, 0.60],
            [ 2.80, 0.50]
        ];
        const centerHood = createProfileMesh(hoodPts, 2.40, carRedMat);
        centerHood.position.x = 0;
        carChassis.add(centerHood);

        // 2 Square Yellow Headlights on Front Vertical Fascia (Ref Image 5)
        const headlightMat = new THREE.MeshBasicMaterial({ color: 0xffcc00 });
        [-0.78, 0.78].forEach(hx => {
            const hl = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.28, 0.05), headlightMat);
            hl.position.set(hx, 0.69, -2.81);
            carChassis.add(hl);
        });

        // Front Headlight Beam illuminating the road ahead
        const headlightBeam = new THREE.SpotLight(0xffe4a0, 1.6, 48, Math.PI / 4, 0.45, 1.2);
        headlightBeam.position.set(0, 0.85, -2.7);
        headlightBeam.target.position.set(0, 0.2, -18);
        carChassis.add(headlightBeam);
        carChassis.add(headlightBeam.target);

        // Center Rear Trunk Profile with Angled Underbody (Ref Images 3 & 4)
        const trunkPts = [
            [-0.65, 0.60],
            [-0.65, 1.45],
            [-2.45, 1.45],
            [-2.70, 1.25],
            [-2.70, 0.98],
            [-2.00, 0.50],
            [-0.65, 0.50]
        ];
        const centerTrunk = createProfileMesh(trunkPts, 2.40, carRedMat);
        centerTrunk.position.x = 0;
        carChassis.add(centerTrunk);

        // 2 Square Red Taillights on Rear Vertical Fascia (Ref Image 4)
        const tailLightMat = new THREE.MeshBasicMaterial({ color: 0xff1515 });
        [-0.78, 0.78].forEach(tx => {
            const tl = new THREE.Mesh(new THREE.BoxGeometry(0.52, 0.24, 0.05), tailLightMat);
            tl.position.set(tx, 1.115, 2.71);
            carChassis.add(tl);
        });

        const rearTailGlowLight = new THREE.PointLight(0xff2222, 0.8, 8);
        rearTailGlowLight.position.set(0, 1.15, 2.95);
        carChassis.add(rearTailGlowLight);

        // 2. CONVERTIBLE COCKPIT: Dashboard Cowl, Floor & Steering Column
        const dashCowl = new THREE.Mesh(new THREE.BoxGeometry(2.80, 0.38, 0.20), carRedMat);
        dashCowl.position.set(0, 1.36, -0.90);
        dashCowl.castShadow = true;
        carChassis.add(dashCowl);

        const cabinFloor = new THREE.Mesh(new THREE.BoxGeometry(2.40, 0.16, 1.55), blackTrimMat);
        cabinFloor.position.set(0, 0.58, -0.125);
        carChassis.add(cabinFloor);

        // 3. FIXED CONVERTIBLE WINDSHIELD (Slanted backwards aerodynamically toward driver)
        const windshieldGroup = new THREE.Group();
        windshieldGroup.position.set(0, 1.52, -0.90);
        windshieldGroup.rotation.x = 0.40;
        carChassis.add(windshieldGroup);

        const pillarHeight = 1.28;
        const pillarGeo = new THREE.BoxGeometry(0.18, pillarHeight, 0.16);
        [-1.26, 1.26].forEach(px => {
            const pillar = new THREE.Mesh(pillarGeo, carRedMat);
            pillar.position.set(px, pillarHeight / 2, 0);
            pillar.castShadow = true;
            windshieldGroup.add(pillar);
        });

        const topHeaderGeo = new THREE.BoxGeometry(2.70, 0.18, 0.16);
        const topHeaderBar = new THREE.Mesh(topHeaderGeo, carRedMat);
        topHeaderBar.position.set(0, pillarHeight + 0.06, 0);
        topHeaderBar.castShadow = true;
        windshieldGroup.add(topHeaderBar);

        const bottomSillBar = new THREE.Mesh(new THREE.BoxGeometry(2.70, 0.12, 0.16), carRedMat);
        bottomSillBar.position.set(0, 0.04, 0);
        windshieldGroup.add(bottomSillBar);

        const glassMat = new THREE.MeshPhongMaterial({
            color: 0x93c5fd,
            specular: 0xffffff,
            shininess: 100,
            transparent: true,
            opacity: 0.35
        });
        const windshieldGlass = new THREE.Mesh(
            new THREE.BoxGeometry(2.34, pillarHeight - 0.04, 0.04),
            glassMat
        );
        windshieldGlass.position.set(0, pillarHeight / 2 + 0.02, 0);
        windshieldGroup.add(windshieldGlass);

        // 4. COCKPIT INTERIOR: Seatback & Steering Column (Ref Image 3)
        const seatBack = new THREE.Mesh(new THREE.BoxGeometry(1.10, 1.15, 0.32), darkInteriorMat);
        seatBack.position.set(0, 1.25, 0.45);
        seatBack.castShadow = true;
        carChassis.add(seatBack);

        const steeringCol = new THREE.Mesh(new THREE.CylinderGeometry(0.10, 0.10, 0.75, 10), blackTrimMat);
        steeringCol.position.set(0, 1.30, -0.58);
        steeringCol.rotation.x = 1.05;
        carChassis.add(steeringCol);

        const steeringWheel = new THREE.Mesh(new THREE.TorusGeometry(0.35, 0.06, 10, 24), blackTrimMat);
        steeringWheel.position.set(0, 1.48, -0.32);
        steeringWheel.rotation.x = -0.35;
        carChassis.add(steeringWheel);

        // ====================================================================
        // SPORTS EXHAUST PIPES & BACKFIRE FLAME SYSTEM (Api Bletak-Bletak)
        // ====================================================================
        const exhaustPipes = [];
        const exhaustFlamePivots = [];

        const exhaustSteelMat = new THREE.MeshStandardMaterial({
            color: 0x1f2327,
            metalness: 0.88,
            roughness: 0.28
        });
        const exhaustInnerMat = new THREE.MeshBasicMaterial({ color: 0x050505 });
        const exhaustTipBlueMat = new THREE.MeshStandardMaterial({
            color: 0x2563eb,
            metalness: 0.92,
            roughness: 0.18
        });

        // Positioned at the lower rear under the taillights, angled with the rear underbody
        [-0.78, 0.78].forEach(exX => {
            const pipeGroup = new THREE.Group();
            pipeGroup.position.set(exX, 0.82, 2.38);

            // Outer stainless/titanium cylinder
            const pipeOuter = new THREE.Mesh(
                new THREE.CylinderGeometry(0.125, 0.125, 0.38, 16),
                exhaustSteelMat
            );
            pipeOuter.rotation.x = Math.PI / 2;
            pipeOuter.castShadow = true;
            pipeGroup.add(pipeOuter);

            // Burnt titanium blue ring bevel at tip
            const pipeTip = new THREE.Mesh(
                new THREE.TorusGeometry(0.125, 0.022, 8, 20),
                exhaustTipBlueMat
            );
            pipeTip.position.set(0, 0, 0.19);
            pipeGroup.add(pipeTip);

            // Hollow inner hole
            const pipeInner = new THREE.Mesh(
                new THREE.CircleGeometry(0.105, 16),
                exhaustInnerMat
            );
            pipeInner.position.set(0, 0, 0.191);
            pipeGroup.add(pipeInner);

            // 3D Backfire Flame Group (Hidden until pop!)
            const flameGroup = new THREE.Group();
            flameGroup.position.set(0, 0, 0.20);
            flameGroup.visible = false;

            // Core fiery white center burst
            const coreBurst = new THREE.Mesh(
                new THREE.SphereGeometry(0.09, 8, 8),
                new THREE.MeshBasicMaterial({ color: 0xffffff })
            );
            coreBurst.position.set(0, 0, 0.12);
            flameGroup.add(coreBurst);

            // Inner hot blue cone core
            const innerFlameGeo = new THREE.ConeGeometry(0.12, 0.75, 8);
            innerFlameGeo.rotateX(-Math.PI / 2);
            innerFlameGeo.translate(0, 0, 0.38);
            const innerFlame = new THREE.Mesh(
                innerFlameGeo,
                new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.95 })
            );
            flameGroup.add(innerFlame);

            // Outer roaring fiery orange/yellow flame tongues
            const outerFlameGeo = new THREE.ConeGeometry(0.28, 1.65, 8);
            outerFlameGeo.rotateX(-Math.PI / 2);
            outerFlameGeo.translate(0, 0, 0.82);
            const outerFlame = new THREE.Mesh(
                outerFlameGeo,
                new THREE.MeshBasicMaterial({ color: 0xff5500, transparent: true, opacity: 0.95 })
            );
            flameGroup.add(outerFlame);

            pipeGroup.add(flameGroup);
            carChassis.add(pipeGroup);

            exhaustPipes.push(pipeGroup);
            exhaustFlamePivots.push({ group: flameGroup, inner: innerFlame, outer: outerFlame });
        });

        // Dynamic light illuminating ground & rear bumper during flame pops
        const exhaustFlashLight = new THREE.PointLight(0xff6600, 0, 14);
        exhaustFlashLight.position.set(0, 0.48, 3.2);
        carChassis.add(exhaustFlashLight);

        // Exhaust Ember & Spark System
        const exhaustSparks = [];
        const sparkGroup = new THREE.Group();
        scene.add(sparkGroup);
        const sparkGeo = new THREE.BoxGeometry(0.08, 0.08, 0.12);

        function spawnExhaustSpark(originWorldPos, carAngle) {
            if (exhaustSparks.length > 36) return;
            const mat = new THREE.MeshBasicMaterial({
                color: Math.random() > 0.3 ? 0xffaa00 : 0x38bdf8,
                transparent: true,
                opacity: 1.0
            });
            const mesh = new THREE.Mesh(sparkGeo, mat);
            mesh.position.copy(originWorldPos);

            const backX = Math.sin(carAngle);
            const backZ = Math.cos(carAngle);
            const rightX = Math.cos(carAngle);
            const rightZ = -Math.sin(carAngle);

            const spreadR = (Math.random() - 0.5) * 3.2;
            const speedBack = 12 + Math.random() * 15;
            const speedUp = 1.0 + Math.random() * 2.5;

            exhaustSparks.push({
                mesh,
                vx: backX * speedBack + rightX * spreadR,
                vy: speedUp,
                vz: backZ * speedBack + rightZ * spreadR,
                age: 0,
                maxAge: 0.14 + Math.random() * 0.14
            });
            sparkGroup.add(mesh);
        }

        // 3D PIZZA PACKAGE BOX ON TRUNK (Visible only when carrying a package!)
        const pizzaCargoGroup = new THREE.Group();
        pizzaCargoGroup.position.set(0, 1.62, 1.55);
        pizzaCargoGroup.visible = false;
        carChassis.add(pizzaCargoGroup);

        const pizzaBoxTex = createPizzaBoxTexture();
        const pizzaBoxMesh = new THREE.Mesh(
            new THREE.BoxGeometry(1.55, 0.34, 1.55),
            [
                new THREE.MeshLambertMaterial({ color: 0xe2b878 }),
                new THREE.MeshLambertMaterial({ color: 0xe2b878 }),
                new THREE.MeshLambertMaterial({ map: pizzaBoxTex }),
                new THREE.MeshLambertMaterial({ color: 0xd4a359 }),
                new THREE.MeshLambertMaterial({ color: 0xe2b878 }),
                new THREE.MeshLambertMaterial({ color: 0xe2b878 })
            ]
        );
        pizzaBoxMesh.castShadow = true;
        pizzaCargoGroup.add(pizzaBoxMesh);

        // Second stacked pizza box for extra visibility
        const pizzaBoxMesh2 = pizzaBoxMesh.clone();
        pizzaBoxMesh2.position.y = 0.36;
        pizzaBoxMesh2.rotation.y = 0.18;
        pizzaCargoGroup.add(pizzaBoxMesh2);

        // 4 Wheels with 5-Spoke Silver Rims (Ref Image 2 & 3)
        const rimTex = createWheelRimTexture();
        const wheelGeo = new THREE.CylinderGeometry(0.56, 0.56, 0.44, 24);
        wheelGeo.rotateZ(Math.PI / 2);
        const wheelMaterials = [
            new THREE.MeshLambertMaterial({ color: 0x151719 }), // Tire tread
            new THREE.MeshBasicMaterial({ map: rimTex }),       // Outer rim
            new THREE.MeshBasicMaterial({ map: rimTex })        // Inner rim
        ];

        const wheelPositions = [
            { x: -1.36, y: 0.56, z: -1.75, isFront: true },
            { x:  1.36, y: 0.56, z: -1.75, isFront: true },
            { x: -1.36, y: 0.56, z:  1.40, isFront: false },
            { x:  1.36, y: 0.56, z:  1.40, isFront: false }
        ];

        const wheels = [];
        wheelPositions.forEach(wp => {
            const pivot = new THREE.Group();
            pivot.position.set(wp.x, wp.y, wp.z);
            const mesh = new THREE.Mesh(wheelGeo, wheelMaterials);
            mesh.castShadow = true;
            pivot.add(mesh);
            carGroup.add(pivot);
            wheels.push({ pivot, mesh, isFront: wp.isFront });
        });

        // ====================================================================
        // REALISTIC DRIFT VISUALS: TIRE SMOKE PUFFS & ASPHALT SKIDMARKS
        // ====================================================================
        const smokeParticles = [];
        const smokeGroup = new THREE.Group();
        scene.add(smokeGroup);
        const smokeGeo = new THREE.DodecahedronGeometry(0.32, 0);

        function spawnTireSmoke(worldX, worldZ, intensity) {
            if (smokeParticles.length > 70) return;
            const mat = new THREE.MeshBasicMaterial({
                color: 0xe5e7eb,
                transparent: true,
                opacity: Math.min(0.42, 0.15 + intensity * 0.22),
                depthWrite: false
            });
            const mesh = new THREE.Mesh(smokeGeo, mat);
            mesh.position.set(
                worldX + (Math.random() - 0.5) * 0.25,
                0.22,
                worldZ + (Math.random() - 0.5) * 0.25
            );
            const s = 0.55 + Math.random() * 0.35;
            mesh.scale.set(s, s * 0.7, s);
            mesh.rotation.set(Math.random() * 3, Math.random() * 3, 0);
            smokeGroup.add(mesh);
            smokeParticles.push({
                mesh,
                age: 0,
                maxAge: 0.55 + Math.random() * 0.35,
                vx: (Math.random() - 0.5) * 1.2,
                vy: 0.7 + Math.random() * 0.6,
                vz: (Math.random() - 0.5) * 1.2
            });
        }

        // Subtle Tire Skidmarks on Road during Drift
        const skidMarks = [];
        const maxSkidMarks = 160;
        const skidGroup = new THREE.Group();
        scene.add(skidGroup);
        const skidGeo = new THREE.PlaneGeometry(0.36, 0.85);
        skidGeo.rotateX(-Math.PI / 2);

        function addSkidMark(worldX, worldZ, yawAngle, alpha) {
            const mat = new THREE.MeshBasicMaterial({
                color: 0x111315,
                transparent: true,
                opacity: Math.min(0.38, alpha * 0.32),
                depthWrite: false
            });
            const mesh = new THREE.Mesh(skidGeo, mat);
            mesh.position.set(worldX, 0.155, worldZ);
            mesh.rotation.y = yawAngle;
            skidGroup.add(mesh);
            skidMarks.push({ mesh, age: 0 });

            if (skidMarks.length > maxSkidMarks) {
                const oldest = skidMarks.shift();
                skidGroup.remove(oldest.mesh);
                oldest.mesh.material.dispose();
            }
        }

        /********************************************************************
         * 9. GAME STATE, SPAWN, REVERSE PICKUP & 2-MINUTE DELIVERY LOGIC
         ********************************************************************/
        const gameState = {
            salary: 100000,          // Saldo gaji awal Rp 100.000
            deliveredCount: 0,
            failedCount: 0,
            hasPackage: false,
            targetHouse: null,       // 'C1' pertama kali, lalu sesuai pilihan/acak
            firstOrderDone: false,   // Order pertama otomatis ke C1 sesuai prompt user
            timeRemaining: 85,      // 85 detik (1m 25s) untuk rute cepat ekspedisi!
            maxTime: 85,
            cameraMode: 'THIRD',     // 'THIRD' atau 'FIRST' (setir dalam kabin)
            camYawOffset: 0,
            camPitchOffset: 0.28,
            camZoom: 11.5,
            targetZoom: 11.5,
            dropoffProgress: 0,       // 0.0 s/d 1.0 (harus berada di area biru selama 10 detik)
            dropoffDuration: 10.0,    // 10 detik sesuai instruksi user
            isInsideDropoff: false
        };

        const carPhysics = {
            x: -430,  // In the open forecourt right outside the factory garage bay
            z: 0,
            angle: Math.PI / 2, // Facing East (toward the road)
            speed: 0,
            vx: 0,                   // Kecepatan dunia X (untuk fisika inersia & slip ban realistis)
            vz: 0,                   // Kecepatan dunia Z
            lateralVelocity: 0,      // Kecepatan geser samping (slip ban)
            angularVelocity: 0,      // Kecepatan putar yaw bodi
            driftIntensity: 0,       // 0.0 (grip penuh) s/d 1.0 (sedang drift halus)
            smokeTimer: 0,
            maxForwardSpeed: 38,
            maxReverseSpeed: -22,
            accel: 30,
            reverseAccel: 26,
            activeBrakeDecel: 68,    // Pengereman kuat saat menekan S ketika mobil sedang maju
            friction: 11,
            brakeForce: 55,
            steerAngle: 0,
            wheelSpin: 0,
            pickupCooldown: 0
        };

        function formatRupiah(num) {
            const prefix = num < 0 ? '-Rp ' : 'Rp ';
            return prefix + Math.abs(Math.round(num)).toLocaleString('id-ID');
        }

        function formatTimer(seconds) {
            const s = Math.max(0, Math.ceil(seconds));
            const mins = Math.floor(s / 60);
            const secs = s % 60;
            return String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
        }

        function showToast(title, subtitle, type = 'success') {
            const container = document.getElementById('toast-container');
            const el = document.createElement('div');
            const titleColor = type === 'success'
                ? 'text-emerald-400'
                : type === 'error'
                ? 'text-rose-400'
                : 'text-amber-400';

            el.className = 'w-full text-center transition-all duration-400 transform translate-y-0 select-none pointer-events-none drop-shadow-[0_4px_10px_rgba(0,0,0,1)]';
            el.innerHTML = `
                <div class="font-display text-2xl font-black ${titleColor} tracking-wide">${title}</div>
                <div class="text-xs text-white/95 font-extrabold mt-0.5 tracking-wider">${subtitle}</div>
            `;
            container.appendChild(el);

            setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(-16px)';
                setTimeout(() => el.remove(), 400);
            }, 3000);
        }

        // ====================================================================
        // BACKFIRE & FLAME CONTROLLER (Api Knalpot Bletak-Bletak)
        // ====================================================================
        const backfireState = {
            flameTimer: 0,
            isFiring: false,
            wasThrottling: false,
            wasBraking: false,
            driftPopTimer: 0,
            revLimitTimer: 0
        };

        function triggerSingleBackfirePop(intensity = 1.0) {
            backfireState.flameTimer = 0.16;
            backfireState.isFiring = true;

            const carAngle = carGroup.rotation.y;
            const sinA = Math.sin(carAngle);
            const cosA = Math.cos(carAngle);

            // Emit sparks from both exhaust pipes
            [-0.80, 0.80].forEach(exX => {
                const wx = carPhysics.x + cosA * exX + sinA * 2.72;
                const wz = carPhysics.z - sinA * exX + cosA * 2.72;
                for (let i = 0; i < 4; i++) {
                    spawnExhaustSpark(new THREE.Vector3(wx, 0.48, wz), carAngle);
                }
            });

            // Flash dynamic light
            exhaustFlashLight.color.setHex(Math.random() > 0.35 ? 0xff5500 : 0x38bdf8);
            exhaustFlashLight.intensity = 5.2 * intensity;

            // Audio synth pop
            sound.playBackfirePop(intensity);
        }

        function triggerBackfireBurst(count = 2, intensity = 1.0) {
            triggerSingleBackfirePop(intensity);
            if (count > 1) {
                for (let i = 1; i < count; i++) {
                    setTimeout(() => {
                        triggerSingleBackfirePop(intensity * (0.8 + Math.random() * 0.3));
                    }, i * (52 + Math.random() * 40));
                }
            }
        }

        // ====================================================================
        // SPEEDOMETER HUD (Sisi Kanan Bawah Mini Gauge)
        // ====================================================================
        const speedoCanvas = document.getElementById('speedo-canvas');
        const sCtx = speedoCanvas ? speedoCanvas.getContext('2d') : null;

        function drawSpeedometer(kmh, gearText, gearColor, isBackfiring) {
            if (!sCtx) return;
            const w = speedoCanvas.width;
            const h = speedoCanvas.height;
            sCtx.clearRect(0, 0, w, h);

            const cx = w / 2;
            const cy = h / 2;
            const radius = w * 0.41;

            // Dial Background: Sleek gradient dark disc
            const bgGrad = sCtx.createRadialGradient(cx, cy, radius * 0.2, cx, cy, radius + 3);
            bgGrad.addColorStop(0, 'rgba(28, 18, 14, 0.88)');
            bgGrad.addColorStop(1, 'rgba(10, 6, 4, 0.94)');

            sCtx.beginPath();
            sCtx.arc(cx, cy, radius + 3, 0, Math.PI * 2);
            sCtx.fillStyle = bgGrad;
            sCtx.fill();

            // Outer Bezel Rim (Flashes fiery orange during backfire pops!)
            sCtx.beginPath();
            sCtx.arc(cx, cy, radius + 3, 0, Math.PI * 2);
            sCtx.strokeStyle = isBackfiring ? '#ff5500' : 'rgba(255, 180, 120, 0.28)';
            sCtx.lineWidth = isBackfiring ? 2.5 : 1.5;
            if (isBackfiring) {
                sCtx.shadowColor = '#ff5500';
                sCtx.shadowBlur = 10;
            }
            sCtx.stroke();
            sCtx.shadowBlur = 0;

            // Gauge Arc Parameters (250 degrees from 135 deg to 25 deg)
            const startAngle = 0.75 * Math.PI;
            const totalSweep = 1.5 * Math.PI;
            const endAngle = startAngle + totalSweep;

            // Track background arc
            sCtx.beginPath();
            sCtx.arc(cx, cy, radius - 2, startAngle, endAngle);
            sCtx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
            sCtx.lineWidth = 4.5;
            sCtx.lineCap = 'round';
            sCtx.stroke();

            // Active Speed Arc (Cyan -> Emerald -> Amber -> Redline)
            const maxKmh = 90;
            const speedRatio = Math.max(0, Math.min(1, kmh / maxKmh));
            const currentAngle = startAngle + speedRatio * totalSweep;

            if (speedRatio > 0.015) {
                const arcGrad = sCtx.createLinearGradient(0, cy + radius, w, cy - radius);
                arcGrad.addColorStop(0, '#38bdf8');
                arcGrad.addColorStop(0.35, '#10b981');
                arcGrad.addColorStop(0.7, '#f59e0b');
                arcGrad.addColorStop(1.0, '#ef4444');

                sCtx.beginPath();
                sCtx.arc(cx, cy, radius - 2, startAngle, currentAngle);
                sCtx.strokeStyle = arcGrad;
                sCtx.lineWidth = 4.5;
                sCtx.lineCap = 'round';
                if (isBackfiring || kmh > 65) {
                    sCtx.shadowColor = isBackfiring ? '#ff5500' : '#f59e0b';
                    sCtx.shadowBlur = 8;
                }
                sCtx.stroke();
                sCtx.shadowBlur = 0;
            }

            // Dial Ticks
            for (let s = 0; s <= 90; s += 15) {
                const tRatio = s / 90;
                const a = startAngle + tRatio * totalSweep;
                const isMajor = (s % 30 === 0);
                const tickLen = isMajor ? 5.5 : 3.0;

                const x1 = cx + Math.cos(a) * (radius - 5.5);
                const y1 = cy + Math.sin(a) * (radius - 5.5);
                const x2 = cx + Math.cos(a) * (radius - 5.5 - tickLen);
                const y2 = cy + Math.sin(a) * (radius - 5.5 - tickLen);

                sCtx.beginPath();
                sCtx.moveTo(x1, y1);
                sCtx.lineTo(x2, y2);
                sCtx.strokeStyle = isMajor ? (s >= 75 ? '#ef4444' : 'rgba(255, 255, 255, 0.75)') : 'rgba(255, 255, 255, 0.35)';
                sCtx.lineWidth = isMajor ? 1.4 : 0.9;
                sCtx.stroke();

                if (isMajor) {
                    const tx = cx + Math.cos(a) * (radius - 16.5);
                    const ty = cy + Math.sin(a) * (radius - 16.5);
                    sCtx.fillStyle = s >= 75 ? '#ef4444' : 'rgba(255, 255, 255, 0.65)';
                    sCtx.font = 'bold 8.5px Inter, sans-serif';
                    sCtx.textAlign = 'center';
                    sCtx.textBaseline = 'middle';
                    sCtx.fillText(s, tx, ty);
                }
            }

            // Sweeping Needle
            sCtx.save();
            sCtx.translate(cx, cy);
            sCtx.rotate(currentAngle);
            sCtx.beginPath();
            sCtx.moveTo(-radius * 0.15, 0);
            sCtx.lineTo(radius - 7, 0);
            sCtx.strokeStyle = isBackfiring ? '#ff3b30' : (kmh > 65 ? '#f59e0b' : '#38bdf8');
            sCtx.lineWidth = 2.2;
            sCtx.lineCap = 'round';
            sCtx.shadowColor = sCtx.strokeStyle;
            sCtx.shadowBlur = 6;
            sCtx.stroke();
            sCtx.restore();

            // Center Pin
            sCtx.beginPath();
            sCtx.arc(cx, cy, 3.8, 0, Math.PI * 2);
            sCtx.fillStyle = '#ffffff';
            sCtx.fill();
            sCtx.strokeStyle = '#18100c';
            sCtx.lineWidth = 1.2;
            sCtx.stroke();

            // Digital KM/H readout
            sCtx.font = 'bold 19px Fredoka, sans-serif';
            sCtx.fillStyle = '#ffffff';
            sCtx.textAlign = 'center';
            sCtx.textBaseline = 'middle';
            sCtx.fillText(kmh, cx, cy + 12);

            sCtx.font = 'bold 7.5px Inter, sans-serif';
            sCtx.fillStyle = 'rgba(255, 255, 255, 0.55)';
            sCtx.fillText('KM/J', cx, cy + 24);

            // Gear / Backfire Status at Top
            sCtx.font = 'extrabold 8.5px Fredoka, sans-serif';
            sCtx.fillStyle = isBackfiring ? '#ff6600' : gearColor;
            sCtx.fillText(isBackfiring ? '🔥 POP!' : gearText, cx, cy - 14);
        }

        function updateHUD() {
            const salEl = document.getElementById('hud-salary');
            salEl.textContent = formatRupiah(gameState.salary);
            salEl.className = `font-display text-xl leading-tight ${gameState.salary >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

            document.getElementById('hud-delivered').textContent = gameState.deliveredCount;
            document.getElementById('hud-failed').textContent = gameState.failedCount;

            const badge = document.getElementById('mission-badge');
            const cargo = document.getElementById('cargo-status');
            const text = document.getElementById('mission-text');
            const timerBox = document.getElementById('timer-container');
            const testBtn = document.getElementById('btn-test-timeout');
            const minimapLabel = document.getElementById('minimap-target-label');

            if (!gameState.hasPackage) {
                badge.textContent = 'TAHAP 1 • AMBIL PAKET';
                badge.className = 'text-xs font-black tracking-widest uppercase text-amber-400 drop-shadow-[0_2px_4px_rgba(0,0,0,1)]';
                cargo.textContent = 'Bagasi: Kosong';
                text.innerHTML = 'Mundur (<span class="text-amber-300 font-extrabold">S / ▼</span>) ke dalam <span class="text-emerald-300 font-extrabold underline underline-offset-2">Garasi Pabrik</span> untuk ambil paket!';
                timerBox.classList.add('hidden');
                testBtn.classList.add('hidden');
                minimapLabel.textContent = 'KE PABRIK';
                minimapLabel.className = 'text-[11px] font-extrabold text-amber-400';

                const dropBoxEl = document.getElementById('dropoff-progress-box');
                if (dropBoxEl) dropBoxEl.classList.add('hidden');
                gameState.dropoffProgress = 0;
                gameState.isInsideDropoff = false;
            } else {
                badge.textContent = 'TAHAP 2 • ANTAR PIZZA';
                badge.className = 'text-xs font-black tracking-widest uppercase text-sky-400 drop-shadow-[0_2px_4px_rgba(0,0,0,1)]';
                cargo.textContent = `Bagasi: 1 Paket (${gameState.targetHouse})`;
                text.innerHTML = `Antarkan Paket ke <span class="text-sky-300 font-extrabold text-xl underline underline-offset-2">Rumah ${gameState.targetHouse}</span> sebelum 2 menit!`;
                timerBox.classList.remove('hidden');
                testBtn.classList.remove('hidden');
                minimapLabel.textContent = `TARGET: ${gameState.targetHouse}`;
                minimapLabel.className = 'text-[11px] font-extrabold text-sky-400';
            }
        }

        function spawnCarAtFactory() {
            carPhysics.x = -430;
            carPhysics.z = 0;
            carPhysics.angle = Math.PI / 2; // Facing East (toward road)
            carPhysics.speed = 0;
            carPhysics.vx = 0;
            carPhysics.vz = 0;
            carPhysics.lateralVelocity = 0;
            carPhysics.angularVelocity = 0;
            carPhysics.driftIntensity = 0;
            carPhysics.steerAngle = 0;

            gameState.dropoffProgress = 0;
            gameState.isInsideDropoff = false;
            const dropBoxEl = document.getElementById('dropoff-progress-box');
            if (dropBoxEl) dropBoxEl.classList.add('hidden');
            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);

            showToast('📍 Posisi Mobil Direset', 'Mundur (S) ke belakang menuju garasi pabrik untuk mengambil paket.', 'info');
        }

        function pickNextTargetHouse() {
            const selector = document.getElementById('next-house-select').value;
            if (selector !== 'AUTO') {
                return selector;
            }
            // Sesuai deskripsi user: "misal paket nya diantarkan ke rumah c1, kita harus ke c1 dalam waktu 2 menit"
            if (!gameState.firstOrderDone) {
                gameState.firstOrderDone = true;
                return 'C1';
            }
            const allCodes = Object.keys(houses);
            const filtered = allCodes.filter(c => c !== gameState.targetHouse);
            return filtered[Math.floor(Math.random() * filtered.length)];
        }

        function triggerPackagePickup() {
            gameState.hasPackage = true;
            gameState.targetHouse = pickNextTargetHouse();
            gameState.timeRemaining = gameState.maxTime; // 120 seconds (2 minutes)
            gameState.dropoffProgress = 0;
            gameState.isInsideDropoff = false;

            const dropBoxEl = document.getElementById('dropoff-progress-box');
            if (dropBoxEl) dropBoxEl.classList.add('hidden');
            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);

            pizzaCargoGroup.visible = true;
            pickupPadGroup.visible = false;

            // Place target marker on target house
            const targetObj = houses[gameState.targetHouse];
            targetMarkerGroup.position.copy(targetObj.dropOffPos);
            targetMarkerGroup.visible = true;

            sound.playPickup();
            updateHUD();
            showToast(
                `🍕 Paket Diambil! Tujuan: Rumah ${gameState.targetHouse}`,
                `Waktu Anda 02:00 menit. Segera melaju ke Rumah ${gameState.targetHouse}!`,
                'info'
            );
        }

        function triggerDeliverySuccess() {
            const deliveredHouse = gameState.targetHouse;
            const timeLeft = Math.ceil(gameState.timeRemaining);
            const basePay = 50000;
            const speedBonus = Math.floor(timeLeft * 250); // Bonus cepat
            const totalEarned = basePay + speedBonus;

            gameState.salary += totalEarned;
            gameState.deliveredCount++;
            gameState.hasPackage = false;
            gameState.targetHouse = null;
            gameState.dropoffProgress = 0;
            gameState.isInsideDropoff = false;

            const dropBoxEl = document.getElementById('dropoff-progress-box');
            if (dropBoxEl) dropBoxEl.classList.add('hidden');
            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);

            pizzaCargoGroup.visible = false;
            targetMarkerGroup.visible = false;
            pickupPadGroup.visible = true;

            // Pastikan fokus tidak pernah nyangkut di elemen UI setelah pengantaran
            if (document.activeElement && document.activeElement !== document.body) {
                document.activeElement.blur();
            }

            sound.playSuccess();
            updateHUD();

            const card = document.getElementById('salary-card');
            card.classList.add('scale-110');
            setTimeout(() => card.classList.remove('scale-110'), 350);

            showToast(
                `✅ Paket Sampai di Rumah ${deliveredHouse}! (+${formatRupiah(totalEarned)})`,
                `Gaji Pokok Rp 50.000 + Bonus Sisa Waktu (${timeLeft} dtk). Tekan S untuk berhenti/mundur & kembali ke pabrik!`,
                'success'
            );
        }

        function triggerDeliveryTimeout() {
            const failedHouse = gameState.targetHouse;
            const penalty = 35000;

            gameState.salary -= penalty;
            gameState.failedCount++;
            gameState.hasPackage = false;
            gameState.targetHouse = null;
            gameState.dropoffProgress = 0;
            gameState.isInsideDropoff = false;

            const dropBoxEl = document.getElementById('dropoff-progress-box');
            if (dropBoxEl) dropBoxEl.classList.add('hidden');
            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);

            pizzaCargoGroup.visible = false;
            targetMarkerGroup.visible = false;
            pickupPadGroup.visible = true;

            sound.playFail();
            updateHUD();

            const card = document.getElementById('salary-card');
            card.classList.add('scale-95');
            setTimeout(() => card.classList.remove('scale-95'), 350);

            showToast(
                `⏰ WAKTU HABIS! Gaji Dipotong (-${formatRupiah(penalty)})`,
                `Pengiriman ke Rumah ${failedHouse} melebihi 2 menit. Kembalilah ke pabrik untuk mengambil paket baru!`,
                'error'
            );
        }

        /********************************************************************
         * 10. INPUT CONTROLS (KEYBOARD, TOUCH & MOUSE ORBIT)
         *     - Fixed so S (Brake/Reverse) NEVER locks up after delivery
         ********************************************************************/
        const keys = {
            up: false,
            down: false,
            left: false,
            right: false,
            brake: false
        };

        function setKeyState(e, isPressed) {
            const code = e.code;
            const key = (e.key || '').toLowerCase();

            // Prevent arrow keys / space / WASD from scrolling or interacting with focused dropdowns
            const isDrivingKey = (
                code === 'KeyW' || code === 'ArrowUp' || key === 'w' ||
                code === 'KeyS' || code === 'ArrowDown' || key === 's' ||
                code === 'KeyA' || code === 'ArrowLeft' || key === 'a' ||
                code === 'KeyD' || code === 'ArrowRight' || key === 'd' ||
                code === 'Space' || key === ' '
            );

            if (isDrivingKey && document.activeElement && document.activeElement.tagName !== 'BODY') {
                document.activeElement.blur();
            }
            if (code === 'ArrowUp' || code === 'ArrowDown' || code === 'ArrowLeft' || code === 'ArrowRight' || code === 'Space') {
                e.preventDefault();
            }

            if (code === 'KeyW' || code === 'ArrowUp' || key === 'w') keys.up = isPressed;
            if (code === 'KeyS' || code === 'ArrowDown' || key === 's') keys.down = isPressed;
            if (code === 'KeyA' || code === 'ArrowLeft' || key === 'a') keys.left = isPressed;
            if (code === 'KeyD' || code === 'ArrowRight' || key === 'd') keys.right = isPressed;
            if (code === 'Space' || key === ' ') keys.brake = isPressed;

            if (isPressed) {
                sound.init();
                if (code === 'KeyV' || key === 'v') toggleCameraMode();
                if (code === 'KeyH' || key === 'h') sound.playHorn();
                if (code === 'KeyB' || key === 'b') triggerBackfireBurst(3, 1.25);
            }
        }

        window.addEventListener('keydown', (e) => setKeyState(e, true), { passive: false });
        window.addEventListener('keyup', (e) => setKeyState(e, false), { passive: false });

        // Reset key states cleanly if window loses focus so W never gets stuck
        window.addEventListener('blur', () => {
            keys.up = false;
            keys.down = false;
            keys.left = false;
            keys.right = false;
            keys.brake = false;
        });

        // Bind On-Screen Touch Buttons
        function bindHoldButton(btnId, keyName) {
            const btn = document.getElementById(btnId);
            const start = (e) => {
                e.preventDefault();
                keys[keyName] = true;
                btn.classList.add('active-press');
                sound.init();
            };
            const end = (e) => {
                e.preventDefault();
                keys[keyName] = false;
                btn.classList.remove('active-press');
            };
            btn.addEventListener('mousedown', start);
            btn.addEventListener('mouseup', end);
            btn.addEventListener('mouseleave', end);
            btn.addEventListener('touchstart', start, { passive: false });
            btn.addEventListener('touchend', end, { passive: false });
        }

        bindHoldButton('touch-up', 'up');
        bindHoldButton('touch-down', 'down');
        bindHoldButton('touch-left', 'left');
        bindHoldButton('touch-right', 'right');
        bindHoldButton('touch-brake', 'brake');

        // Camera Mode Toggle (Third Person vs First Person Steering Wheel View)
        function toggleCameraMode() {
            gameState.cameraMode = gameState.cameraMode === 'THIRD' ? 'FIRST' : 'THIRD';
            gameState.camYawOffset = 0;
            document.getElementById('cam-label').textContent =
                gameState.cameraMode === 'THIRD' ? 'Kamera: 3rd (V)' : 'Kamera: Setir 1st (V)';
        }

        document.getElementById('btn-camera').addEventListener('click', toggleCameraMode);
        document.getElementById('btn-horn').addEventListener('click', () => sound.playHorn());
        document.getElementById('btn-audio').addEventListener('click', () => {
            sound.muted = !sound.muted;
            document.getElementById('audio-icon').textContent = sound.muted ? '🔇' : '🔊';
        });
        document.getElementById('btn-respawn').addEventListener('click', spawnCarAtFactory);
        document.getElementById('btn-test-timeout').addEventListener('click', () => {
            if (gameState.hasPackage) {
                gameState.timeRemaining = 5;
                showToast('⏱️ Simulasi Waktu Kritis', 'Sisa waktu diatur menjadi 5 detik untuk menguji pinalti gaji!', 'info');
            }
        });

        // ====================================================================
        // ROBLOX-STYLE CAMERA CONTROLS: Right-Click Orbit & Mouse Wheel Zoom
        // ====================================================================
        // Prevent default browser context menu ("Copy image", "Inspect", etc.) everywhere
        ['contextmenu'].forEach(evt => {
            window.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); return false; }, { passive: false });
            document.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); return false; }, { passive: false });
            if (renderer && renderer.domElement) {
                renderer.domElement.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); return false; }, false);
            }
        });

        let isRightDragging = false;
        let prevMousePos = { x: 0, y: 0 };

        // Right-Click (e.button === 2) starts camera rotation just like in Roblox
        // Left-Click (e.button === 0) is reserved for pressing UI buttons / normal clicks
        renderer.domElement.addEventListener('mousedown', (e) => {
            sound.init();
            if (e.button === 2) {
                isRightDragging = true;
                prevMousePos = { x: e.clientX, y: e.clientY };
                document.body.style.cursor = 'grab';
                e.preventDefault();
            }
        });

        window.addEventListener('mouseup', (e) => {
            if (e.button === 2 || e.buttons === 0) {
                isRightDragging = false;
                document.body.style.cursor = 'default';
            }
        });

        window.addEventListener('mousemove', (e) => {
            if (!isRightDragging) return;
            const dx = e.clientX - prevMousePos.x;
            const dy = e.clientY - prevMousePos.y;
            prevMousePos = { x: e.clientX, y: e.clientY };

            // Rotate camera yaw & pitch around car (Roblox-style spherical orbit)
            gameState.camYawOffset -= dx * 0.0065;
            gameState.camPitchOffset = Math.max(-0.20, Math.min(1.25, gameState.camPitchOffset + dy * 0.0055));
        });

        // Mouse Wheel Scroll: Smooth Zoom In / Zoom Out (Roblox-style)
        window.addEventListener('wheel', (e) => {
            // Scroll Up (deltaY < 0) = Zoom In, Scroll Down (deltaY > 0) = Zoom Out
            const zoomDelta = Math.sign(e.deltaY) * 1.5;
            gameState.targetZoom = Math.max(3.8, Math.min(30.0, gameState.targetZoom + zoomDelta));
        }, { passive: true });

        /********************************************************************
         * 11. 2D MINIMAP RENDERER (Factory + 3x3 Houses A1..C3)
         ********************************************************************/
        const minimapCanvas = document.getElementById('minimap-canvas');
        const mCtx = minimapCanvas.getContext('2d');

        function drawMinimap() {
            const W = minimapCanvas.width;
            const H = minimapCanvas.height;
            mCtx.clearRect(0, 0, W, H);

            // Autumn Landscape Background
            mCtx.fillStyle = '#22140d';
            mCtx.fillRect(0, 0, W, H);

            // Coordinate mapper: World X in [-520, 520], World Z in [-240, 240]
            const mapX = (wx) => ((wx + 520) / 1040) * W;
            const mapZ = (wz) => ((wz + 240) / 480) * H;

            // 1. Draw River (Sungai) & Wooden Bridge
            mCtx.fillStyle = '#1e608a';
            mCtx.fillRect(mapX(-244), 0, mapX(-216) - mapX(-244), H);

            mCtx.fillStyle = '#78431f';
            mCtx.fillRect(mapX(-255), mapZ(35 - 8), mapX(-205) - mapX(-255), mapZ(35 + 8) - mapZ(35 - 8));

            // 2. Draw Mountain & Tunnel Area
            mCtx.fillStyle = '#473f38';
            mCtx.beginPath();
            mCtx.arc(mapX(-65), mapZ(-20), 14, 0, Math.PI * 2);
            mCtx.fill();

            mCtx.fillStyle = '#1e1b18';
            mCtx.fillRect(mapX(-95), mapZ(-20 - 4), mapX(-35) - mapX(-95), 8);

            // Tebing 2 Bluff
            mCtx.fillStyle = '#473f38';
            mCtx.beginPath();
            mCtx.arc(mapX(10), mapZ(12), 7, 0, Math.PI * 2);
            mCtx.fill();

            // 3. Draw Railroad Track (Rel Kereta Api)
            mCtx.strokeStyle = '#94a3b8';
            mCtx.lineWidth = 1.5;
            mCtx.beginPath();
            mCtx.moveTo(mapX(110), 0);
            mCtx.lineTo(mapX(110), H);
            mCtx.stroke();

            // 4. Draw Cornfield (Ladang Jagung)
            const cx1 = mapX(145);
            const cz1 = mapZ(-145);
            const cx2 = mapX(295);
            const cz2 = mapZ(5);
            mCtx.fillStyle = '#4d7c0f';
            mCtx.fillRect(cx1, cz1, cx2 - cx1, cz2 - cz1);
            mCtx.strokeStyle = '#ca8a04';
            mCtx.lineWidth = 1;
            mCtx.strokeRect(cx1, cz1, cx2 - cx1, cz2 - cz1);

            mCtx.fillStyle = '#fef08a';
            mCtx.font = 'bold 7px Inter, sans-serif';
            mCtx.textAlign = 'center';
            mCtx.fillText('JAGUNG', (cx1 + cx2) / 2, (cz1 + cz2) / 2);

            // 5. Draw Highway Route
            mCtx.strokeStyle = '#64748b';
            mCtx.lineWidth = 3.5;
            mCtx.beginPath();
            highwayPoints.forEach((pt, idx) => {
                const px = mapX(pt[0]);
                const pz = mapZ(pt[1]);
                if (idx === 0) mCtx.moveTo(px, pz);
                else mCtx.lineTo(px, pz);
            });
            mCtx.stroke();

            // 6. Draw Residential District Grid (Perumahan)
            mCtx.strokeStyle = '#64748b';
            mCtx.lineWidth = 2.5;
            colRoadX.forEach(rx => {
                mCtx.beginPath();
                mCtx.moveTo(mapX(rx), mapZ(-70));
                mCtx.lineTo(mapX(rx), mapZ(85));
                mCtx.stroke();
            });
            crossRoadZ.forEach(rz => {
                mCtx.beginPath();
                mCtx.moveTo(mapX(330), mapZ(rz));
                mCtx.lineTo(mapX(485), mapZ(rz));
                mCtx.stroke();
            });

            // Draw Factory Building & Pickup Ring
            mCtx.fillStyle = '#b45309';
            mCtx.fillRect(mapX(-485), mapZ(-18), mapX(-450) - mapX(-485), mapZ(18) - mapZ(-18));
            mCtx.strokeStyle = '#facc15';
            mCtx.lineWidth = 1.2;
            mCtx.strokeRect(mapX(-485), mapZ(-18), mapX(-450) - mapX(-485), mapZ(18) - mapZ(-18));

            mCtx.fillStyle = '#fde68a';
            mCtx.font = 'bold 7px Inter, sans-serif';
            mCtx.textAlign = 'center';
            mCtx.fillText('PABRIK', mapX(-468), mapZ(3));

            if (!gameState.hasPackage) {
                mCtx.fillStyle = '#22c55e';
                mCtx.beginPath();
                mCtx.arc(mapX(-448), mapZ(0), 4.5, 0, Math.PI * 2);
                mCtx.fill();
            }

            // Draw 9 Houses (A1..C3)
            Object.values(houses).forEach(h => {
                const hx = mapX(h.housePos.x);
                const hz = mapZ(h.housePos.z);
                const isTarget = gameState.hasPackage && gameState.targetHouse === h.code;

                mCtx.fillStyle = isTarget ? '#38bdf8' : '#e2d7ca';
                mCtx.fillRect(hx - 5, hz - 4, 10, 8);

                if (isTarget) {
                    mCtx.strokeStyle = '#ffffff';
                    mCtx.lineWidth = 2;
                    mCtx.strokeRect(hx - 7, hz - 6, 14, 12);
                }

                mCtx.fillStyle = isTarget ? '#082f49' : '#1f2937';
                mCtx.font = 'bold 6px Inter, sans-serif';
                mCtx.textAlign = 'center';
                mCtx.textBaseline = 'middle';
                mCtx.fillText(h.code, hx, hz);
            });

            // Draw Player Car Arrow
            const px = mapX(carPhysics.x);
            const pz = mapZ(carPhysics.z);
            mCtx.save();
            mCtx.translate(px, pz);
            mCtx.rotate(-carPhysics.angle);
            mCtx.fillStyle = '#ef4444';
            mCtx.strokeStyle = '#ffffff';
            mCtx.lineWidth = 1.5;
            mCtx.beginPath();
            mCtx.moveTo(0, -7);
            mCtx.lineTo(5, 6);
            mCtx.lineTo(0, 3.5);
            mCtx.lineTo(-5, 6);
            mCtx.closePath();
            mCtx.fill();
            mCtx.stroke();
            mCtx.restore();
        }

        /********************************************************************
         * 12. MAIN GAME LOOP (PHYSICS, COLLISIONS, TRIGGERS, ANIMATIONS)
         ********************************************************************/
        let lastTime = performance.now();

        function resolveCircleBoxCollision(pos, radius, box) {
            const closestX = Math.max(box.minX, Math.min(pos.x, box.maxX));
            const closestZ = Math.max(box.minZ, Math.min(pos.z, box.maxZ));
            const dx = pos.x - closestX;
            const dz = pos.z - closestZ;
            const distSq = dx * dx + dz * dz;

            if (distSq >= radius * radius) {
                return null;
            }

            const dist = Math.sqrt(distSq);
            let nx = 0;
            let nz = 0;
            let overlap = 0;

            if (dist > 0.0001) {
                nx = dx / dist;
                nz = dz / dist;
                overlap = radius - dist;
            } else {
                // Center is completely inside box: push out through closest face
                const dLeft = pos.x - box.minX;
                const dRight = box.maxX - pos.x;
                const dTop = pos.z - box.minZ;
                const dBottom = box.maxZ - pos.z;
                const minDist = Math.min(dLeft, dRight, dTop, dBottom);

                if (minDist === dLeft) {
                    nx = -1; nz = 0; overlap = radius + dLeft;
                } else if (minDist === dRight) {
                    nx = 1; nz = 0; overlap = radius + dRight;
                } else if (minDist === dTop) {
                    nx = 0; nz = -1; overlap = radius + dTop;
                } else {
                    nx = 0; nz = 1; overlap = radius + dBottom;
                }
            }

            // Immediately push tentative position out of the collider
            pos.x += nx * overlap;
            pos.z += nz * overlap;

            return { nx, nz, overlap };
        }

        function updateGame(dt) {
            // Update visual key indicators in bottom-right HUD
            const indW = document.getElementById('key-ind-w');
            const indS = document.getElementById('key-ind-s');
            const indSp = document.getElementById('key-ind-space');
            const indB = document.getElementById('key-ind-b');
            if (indW) indW.className = keys.up ? 'px-1.5 py-0.5 rounded bg-emerald-500/50 border border-emerald-300 transition-colors' : 'px-1.5 py-0.5 rounded bg-white/5 transition-colors';
            if (indS) indS.className = keys.down ? 'px-1.5 py-0.5 rounded bg-amber-500/50 border border-amber-300 transition-colors' : 'px-1.5 py-0.5 rounded bg-white/5 transition-colors';
            if (indSp) indSp.className = keys.brake ? 'px-1.5 py-0.5 rounded bg-sky-500/50 border border-sky-300 transition-colors' : 'px-1.5 py-0.5 rounded bg-white/5 transition-colors';
            if (indB) indB.className = backfireState.isFiring ? 'px-1.5 py-0.5 rounded bg-orange-500/60 border border-orange-300 transition-colors shadow-[0_0_8px_rgba(249,115,22,0.8)]' : 'px-1.5 py-0.5 rounded bg-white/5 transition-colors';

            // ====================================================================
            // 1. REALISTIC DRIVING & Controlled DRIFT PHYSICS (Non-Brutal, Smooth)
            // ====================================================================
            // Transform current world velocity (vx, vz) into car local axes:
            // Forward vector: (-sin(angle), -cos(angle))
            // Right vector:   ( cos(angle), -sin(angle))
            const forwardX = -Math.sin(carPhysics.angle);
            const forwardZ = -Math.cos(carPhysics.angle);
            const rightX = Math.cos(carPhysics.angle);
            const rightZ = -Math.sin(carPhysics.angle);

            let forwardVel = carPhysics.vx * forwardX + carPhysics.vz * forwardZ;
            let lateralVel = carPhysics.vx * rightX + carPhysics.vz * rightZ;

            // Smooth steering input with speed-sensitive ratio (prevents twitchy spinouts)
            const targetSteer = (keys.left ? 1 : 0) - (keys.right ? 1 : 0);
            const speedRatio = Math.min(1, Math.abs(forwardVel) / carPhysics.maxForwardSpeed);
            const maxSteerAtSpeed = 0.56 - speedRatio * 0.14;
            carPhysics.steerAngle += (targetSteer * maxSteerAtSpeed - carPhysics.steerAngle) * Math.min(1, dt * 9.5);

            // Longitudinal acceleration, braking & handbrake drift entry
            const isHandbrakeDrifting = keys.brake && forwardVel > 9.5 && Math.abs(carPhysics.steerAngle) > 0.08;

            if (keys.brake) {
                if (isHandbrakeDrifting) {
                    // Handbrake while turning at speed: mild drag on rear wheels so car slides smoothly without dead-stopping
                    forwardVel -= Math.sign(forwardVel) * (keys.up ? 9.0 : 20.0) * dt;
                } else {
                    // Straight-line or low-speed emergency handbrake stop
                    if (Math.abs(forwardVel) < 1.0) {
                        forwardVel = 0;
                    } else {
                        forwardVel -= Math.sign(forwardVel) * carPhysics.brakeForce * dt;
                    }
                }
            } else if (keys.down && !keys.up) {
                // Pressing S / Down: strong front/rear brake when moving forward, then smooth reverse
                if (forwardVel > 0.35) {
                    forwardVel = Math.max(0, forwardVel - carPhysics.activeBrakeDecel * dt);
                } else {
                    forwardVel -= carPhysics.reverseAccel * dt;
                }
            } else if (keys.up && !keys.down) {
                // Pressing W / Up: brake from reverse to 0, then accelerate forward
                if (forwardVel < -0.35) {
                    forwardVel = Math.min(0, forwardVel + carPhysics.activeBrakeDecel * dt);
                } else {
                    forwardVel += carPhysics.accel * dt;
                }
            } else if (keys.up && keys.down) {
                if (Math.abs(forwardVel) < 0.8) {
                    forwardVel = 0;
                } else {
                    forwardVel -= Math.sign(forwardVel) * carPhysics.activeBrakeDecel * dt;
                }
            } else {
                // Natural rolling resistance
                if (Math.abs(forwardVel) < 0.45) {
                    forwardVel = 0;
                } else {
                    forwardVel -= Math.sign(forwardVel) * carPhysics.friction * dt;
                }
            }

            forwardVel = Math.max(carPhysics.maxReverseSpeed, Math.min(carPhysics.maxForwardSpeed, forwardVel));

            // 2. Yaw Rotation & Realistic Lateral Tire Grip (Pacejka-lite smooth slip)
            if (Math.abs(forwardVel) > 0.15) {
                const dirSign = forwardVel >= 0 ? 1 : -1;
                const turnFactor = Math.min(1, Math.abs(forwardVel) / 8.5);

                // Base angular rate from front wheel steering
                let targetYawRate = carPhysics.steerAngle * 2.55 * dirSign * turnFactor;

                // Subtle oversteer boost only when initiating a handbrake drift or high-speed hard cornering
                if (isHandbrakeDrifting) {
                    targetYawRate *= 1.24;
                } else if (forwardVel > 24 && Math.abs(carPhysics.steerAngle) > 0.32) {
                    targetYawRate *= 1.08;
                }

                // Natural self-aligning torque (counter-steering stabilizes the rear smoothly so it never spins out brutally)
                const stabilizingTorque = -lateralVel * 0.045 * dirSign;
                carPhysics.angularVelocity += ((targetYawRate + stabilizingTorque) - carPhysics.angularVelocity) * Math.min(1, dt * 11);
                carPhysics.angle += carPhysics.angularVelocity * dt;
            } else {
                carPhysics.angularVelocity = 0;
            }

            // Recompute local basis after yaw rotation update:
            // Because the car rotated by (angularVelocity * dt) while its momentum vector was still pointing
            // along the previous heading, part of forwardVel naturally projects into lateralVel (centrifugal slip)
            const newForwardX = -Math.sin(carPhysics.angle);
            const newForwardZ = -Math.cos(carPhysics.angle);
            const newRightX = Math.cos(carPhysics.angle);
            const newRightZ = -Math.sin(carPhysics.angle);

            // Centrifugal transfer from turning at speed
            const yawDelta = carPhysics.angularVelocity * dt;
            lateralVel += forwardVel * Math.sin(yawDelta) * 0.78;

            // Tire lateral grip coefficient (High grip normally; smoothly reduced during handbrake or high-speed hard cornering)
            let lateralGrip = 9.5; // Normal high asphalt grip
            if (isHandbrakeDrifting) {
                lateralGrip = 2.65; // Controlled, smooth rear slide when holding Space + Turn
            } else if (forwardVel > 23 && Math.abs(carPhysics.steerAngle) > 0.3) {
                lateralGrip = 4.6;  // Subtle natural dynamic slip on fast tight corners
            }

            // Dampen lateral velocity according to tire grip & cap maximum sideways slide so it stays realistic
            lateralVel *= Math.max(0, 1 - lateralGrip * dt);
            const maxAllowedSlide = Math.min(10.5, Math.abs(forwardVel) * 0.36);
            lateralVel = Math.max(-maxAllowedSlide, Math.min(maxAllowedSlide, lateralVel));
            if (Math.abs(lateralVel) < 0.08) lateralVel = 0;

            // Induced drag when sliding sideways (scrubbing speed realistically in a corner)
            const slipSpeed = Math.abs(lateralVel);
            if (slipSpeed > 1.2 && forwardVel > 5) {
                forwardVel -= slipSpeed * 0.18 * dt;
            }

            carPhysics.speed = forwardVel;
            carPhysics.lateralVelocity = lateralVel;

            // Compute normalized drift intensity (0 = pure grip, 1 = active smooth drift)
            const rawDrift = (Math.abs(forwardVel) > 9 && slipSpeed > 1.65)
                ? Math.min(1, (slipSpeed - 1.65) / 5.5)
                : 0;
            carPhysics.driftIntensity += (rawDrift - carPhysics.driftIntensity) * Math.min(1, dt * 10);

            // Reconstruct tentative world velocity vector (vx, vz) from forward + lateral velocity
            carPhysics.vx = newForwardX * forwardVel + newRightX * lateralVel;
            carPhysics.vz = newForwardZ * forwardVel + newRightZ * lateralVel;

            // ====================================================================
            // CONTINUOUS COLLISION SEPARATION & PENETRATION RESOLUTION
            // (Completely eliminates sticking bugs: reversing with S is always free!)
            // ====================================================================
            const carRadius = 1.88;
            const targetPos = {
                x: carPhysics.x + carPhysics.vx * dt,
                z: carPhysics.z + carPhysics.vz * dt
            };

            let hadCollision = false;
            let colNormalX = 0;
            let colNormalZ = 0;

            // 2 Relaxation passes: cleanly resolves multi-collider intersections & tight wall corners
            for (let pass = 0; pass < 2; pass++) {
                // 1. World Boundary Enclosure
                if (targetPos.x < -164 + carRadius) {
                    targetPos.x = -164 + carRadius;
                    if (carPhysics.vx < 0) carPhysics.vx = 0;
                } else if (targetPos.x > 164 - carRadius) {
                    targetPos.x = 164 - carRadius;
                    if (carPhysics.vx > 0) carPhysics.vx = 0;
                }

                if (targetPos.z < -116 + carRadius) {
                    targetPos.z = -116 + carRadius;
                    if (carPhysics.vz < 0) carPhysics.vz = 0;
                } else if (targetPos.z > 154 - carRadius) {
                    targetPos.z = 154 - carRadius;
                    if (carPhysics.vz > 0) carPhysics.vz = 0;
                }

                // 2. Box Colliders (Houses, Factory Walls, Parked Cars, Trees)
                for (let i = 0; i < colliders.length; i++) {
                    const hit = resolveCircleBoxCollision(targetPos, carRadius, colliders[i]);
                    if (hit) {
                        hadCollision = true;
                        colNormalX += hit.nx;
                        colNormalZ += hit.nz;
                    }
                }
            }

            // Apply separated collision-free position
            carPhysics.x = targetPos.x;
            carPhysics.z = targetPos.z;

            // Velocity resolution: Dampen velocity pointing INTO collider, allow smooth sliding & instant reverse
            if (hadCollision) {
                const normLen = Math.hypot(colNormalX, colNormalZ);
                if (normLen > 0.0001) {
                    const nx = colNormalX / normLen;
                    const nz = colNormalZ / normLen;
                    const vDotN = carPhysics.vx * nx + carPhysics.vz * nz;

                    // If moving into the wall, eliminate velocity into wall with slight elasticity
                    // If vDotN >= 0, the car is moving AWAY (e.g. reversing away), so do NOT cancel velocity!
                    if (vDotN < 0) {
                        carPhysics.vx -= vDotN * nx * 1.15;
                        carPhysics.vz -= vDotN * nz * 1.15;
                        carPhysics.lateralVelocity *= 0.4;
                    }
                }
            }

            // Sync forward velocity to match actual updated world velocity
            const updatedForwardVel = carPhysics.vx * newForwardX + carPhysics.vz * newForwardZ;
            carPhysics.speed = updatedForwardVel;

            // Apply Position & Suspension Tilt to 3D Car
            carGroup.position.set(carPhysics.x, 0, carPhysics.z);
            carGroup.rotation.y = carPhysics.angle;

            // Realistic suspension pitch & lateral body roll during cornering / drifting
            const targetPitch = (keys.up ? -0.024 : (keys.down || keys.brake) ? 0.032 : 0);
            const targetRoll = (-carPhysics.steerAngle * (carPhysics.speed / carPhysics.maxForwardSpeed) * 0.065)
                             + (carPhysics.lateralVelocity * 0.0085);
            carChassis.rotation.x += (targetPitch - carChassis.rotation.x) * 0.15;
            carChassis.rotation.z += (targetRoll - carChassis.rotation.z) * 0.15;

            // Rotate Steering Wheel in Cockpit
            steeringWheel.rotation.z = carPhysics.steerAngle * 1.4;

            // Spin & Turn the 4 Wheels (Front wheels subtly counter-steer into the slip angle for realism)
            carPhysics.wheelSpin += carPhysics.speed * dt * 1.5;
            const slipSteerAssist = Math.atan2(carPhysics.lateralVelocity, Math.max(6, Math.abs(carPhysics.speed))) * 0.35;
            wheels.forEach(w => {
                w.mesh.rotation.x = -carPhysics.wheelSpin;
                if (w.isFront) {
                    w.pivot.rotation.y = carPhysics.steerAngle * 0.75 + slipSteerAssist;
                }
            });

            // Spawn Realistic Rear Tire Smoke & Skidmarks when Drifting
            if (carPhysics.driftIntensity > 0.12) {
                carPhysics.smokeTimer += dt;
                if (carPhysics.smokeTimer > 0.035) {
                    carPhysics.smokeTimer = 0;
                    // Rear Left & Rear Right wheel world coordinates
                    [-1.35, 1.35].forEach(rxOffset => {
                        const wx = carPhysics.x + newRightX * rxOffset - newForwardX * 1.55;
                        const wz = carPhysics.z + newRightZ * rxOffset - newForwardZ * 1.55;
                        spawnTireSmoke(wx, wz, carPhysics.driftIntensity);
                        addSkidMark(wx, wz, carPhysics.angle, carPhysics.driftIntensity);
                    });
                }
            }

            // Update Tire Smoke Particles & Fade Old Skidmarks
            for (let i = smokeParticles.length - 1; i >= 0; i--) {
                const sp = smokeParticles[i];
                sp.age += dt;
                if (sp.age >= sp.maxAge) {
                    smokeGroup.remove(sp.mesh);
                    sp.mesh.material.dispose();
                    smokeParticles.splice(i, 1);
                } else {
                    const lifeRatio = sp.age / sp.maxAge;
                    sp.mesh.position.x += sp.vx * dt;
                    sp.mesh.position.y += sp.vy * dt;
                    sp.mesh.position.z += sp.vz * dt;
                    const scale = 0.6 + lifeRatio * 1.35;
                    sp.mesh.scale.set(scale, scale * 0.75, scale);
                    sp.mesh.material.opacity = (1 - lifeRatio) * 0.32;
                }
            }

            for (let i = skidMarks.length - 1; i >= 0; i--) {
                const sm = skidMarks[i];
                sm.age += dt;
                if (sm.age > 6.0) {
                    sm.mesh.material.opacity = Math.max(0, sm.mesh.material.opacity - dt * 0.15);
                }
            }

            // Taillight & Rear Ground Light: White when reversing, bright crimson when braking, normal red otherwise
            const isReversing = carPhysics.speed < -0.35 || (keys.down && carPhysics.speed <= 0.35);
            const isBraking = (keys.down && carPhysics.speed > 0.35) || keys.brake;
            if (isReversing) {
                tailLightMat.color.setHex(0xffffff);
                rearTailGlowLight.color.setHex(0xffffff);
                rearTailGlowLight.intensity = 1.3;
            } else if (isBraking) {
                tailLightMat.color.setHex(0xff0000);
                rearTailGlowLight.color.setHex(0xff1111);
                rearTailGlowLight.intensity = 1.6;
            } else {
                tailLightMat.color.setHex(0xb91c1c);
                rearTailGlowLight.color.setHex(0xff2222);
                rearTailGlowLight.intensity = 0.6;
            }

            // Sound Engine & Tire Scrub Update
            sound.updateEngine(
                carPhysics.speed / carPhysics.maxForwardSpeed,
                isReversing && carPhysics.speed < -0.4,
                dt,
                carPhysics.driftIntensity
            );

            // ====================================================================
            // BACKFIRE POP & BANG DETECTION (Api Knalpot Bletak-Bletak)
            // ====================================================================
            // A) Lift-Off Overrun Backfire: releasing gas at speed spits pops & bang flames!
            if (backfireState.wasThrottling && !keys.up && forwardVel > 7.0) {
                const burstCount = forwardVel > 22 ? 3 : (Math.random() > 0.4 ? 2 : 1);
                triggerBackfireBurst(burstCount, 1.0);
            }
            // B) Hard Braking / Downshift Pop while at speed
            if ((keys.down || keys.brake) && forwardVel > 12.0 && !backfireState.wasBraking) {
                triggerBackfireBurst(2, 0.95);
            }
            // C) Sustained High-Angle Drift Pops
            if (carPhysics.driftIntensity > 0.38) {
                backfireState.driftPopTimer += dt;
                if (backfireState.driftPopTimer > (0.28 + Math.random() * 0.28)) {
                    backfireState.driftPopTimer = 0;
                    triggerSingleBackfirePop(0.88);
                }
            } else {
                backfireState.driftPopTimer = 0;
            }
            // D) Two-Step Launch Control / Burnout Rev-Limiter (Gas + Brake simultaneously)
            if (keys.up && (keys.down || keys.brake) && Math.abs(forwardVel) < 3.5) {
                backfireState.revLimitTimer += dt;
                if (backfireState.revLimitTimer > 0.15) {
                    backfireState.revLimitTimer = 0;
                    triggerSingleBackfirePop(1.15);
                }
            } else {
                backfireState.revLimitTimer = 0;
            }

            backfireState.wasThrottling = keys.up;
            backfireState.wasBraking = (keys.down || keys.brake);

            // Animate Backfire Flame Meshes & Light Decay
            if (backfireState.flameTimer > 0) {
                backfireState.flameTimer -= dt;
                exhaustFlamePivots.forEach(f => {
                    f.group.visible = true;
                    const jx = 0.85 + Math.random() * 0.45;
                    const jy = 0.85 + Math.random() * 0.45;
                    const jz = 0.75 + Math.random() * 0.95;
                    f.group.scale.set(jx, jy, jz);
                    f.group.rotation.z = Math.random() * Math.PI * 2;
                });
                exhaustFlashLight.intensity = Math.max(0, exhaustFlashLight.intensity - dt * 26);
            } else {
                exhaustFlamePivots.forEach(f => {
                    f.group.visible = false;
                });
                exhaustFlashLight.intensity = 0;
                backfireState.isFiring = false;
            }

            // Update Flying Exhaust Spark Embers
            for (let i = exhaustSparks.length - 1; i >= 0; i--) {
                const sp = exhaustSparks[i];
                sp.age += dt;
                if (sp.age >= sp.maxAge) {
                    sparkGroup.remove(sp.mesh);
                    sp.mesh.material.dispose();
                    exhaustSparks.splice(i, 1);
                } else {
                    sp.mesh.position.x += sp.vx * dt;
                    sp.mesh.position.y += sp.vy * dt;
                    sp.mesh.position.z += sp.vz * dt;
                    sp.vy -= 14 * dt; // gravity
                    const lifeRatio = sp.age / sp.maxAge;
                    sp.mesh.material.opacity = Math.max(0, 1 - lifeRatio);
                    const sc = Math.max(0.2, 1 - lifeRatio * 0.6);
                    sp.mesh.scale.setScalar(sc);
                }
            }

            // ====================================================================
            // UPDATE SPEEDOMETER & GEAR HUD (Bottom Right Mini Speedo + Legacy)
            // ====================================================================
            const totalSpeed = Math.hypot(carPhysics.vx, carPhysics.vz);
            const kmh = Math.round(totalSpeed * 2.4);

            let gearText = 'DIAM (N)';
            let gearColor = 'rgba(255, 255, 255, 0.8)';
            if (carPhysics.driftIntensity > 0.18) {
                gearText = 'DRIFT 💨';
                gearColor = '#38bdf8';
            } else if (carPhysics.speed < -0.35) {
                gearText = 'MUNDUR (R)';
                gearColor = '#f59e0b';
            } else if (isBraking) {
                gearText = 'MENGEREM';
                gearColor = '#f43f5e';
            } else if (carPhysics.speed > 0.35) {
                gearText = 'MAJU (D)';
                gearColor = '#10b981';
            }

            // Draw Bottom-Right Mini Speedometer Gauge
            drawSpeedometer(kmh, gearText, gearColor, backfireState.isFiring);

            // Backward-compatible updates for any legacy hooks
            const hudSpeedEl = document.getElementById('hud-speed');
            const hudGearEl = document.getElementById('hud-gear');
            if (hudSpeedEl) hudSpeedEl.textContent = kmh;
            if (hudGearEl) {
                hudGearEl.textContent = gearText;
                hudGearEl.style.color = gearColor;
            }

            // 3. GAMEPLAY MECHANIC CHECKS:
            // A) Reverse Pickup inside Factory Bay
            if (!gameState.hasPackage) {
                const dx = carPhysics.x - pickupZonePos.x;
                const dz = carPhysics.z - pickupZonePos.z;
                const distToPickup = Math.hypot(dx, dz);

                // Animate Pickup Ring
                padBorder.rotation.z += dt * 1.5;

                // Trigger pickup when player backs into the factory loading bay
                if (distToPickup < 5.2 && (carPhysics.speed <= 0.8 || keys.down)) {
                    triggerPackagePickup();
                }
            }
            // B) Active Delivery Countdown Timer (2 Minutes) & House Drop-off Check
            else {
                gameState.timeRemaining -= dt;

                // Update Timer UI
                const timerDisp = document.getElementById('timer-display');
                const timerBar = document.getElementById('timer-bar');
                timerDisp.textContent = formatTimer(gameState.timeRemaining);

                const pct = Math.max(0, (gameState.timeRemaining / gameState.maxTime) * 100);
                timerBar.style.width = pct + '%';

                if (gameState.timeRemaining <= 20) {
                    timerDisp.classList.add('timer-urgent');
                } else {
                    timerDisp.classList.remove('timer-urgent');
                }

                // Animate Target House Marker
                targetRingOuter.rotation.z -= dt * 2.0;

                // Check if player reached Target House (e.g. C1) and stays in blue zone for 10 seconds
                const targetObj = houses[gameState.targetHouse];
                const dropBoxEl = document.getElementById('dropoff-progress-box');
                const dropBarEl = document.getElementById('dropoff-progress-bar');
                const dropTextEl = document.getElementById('dropoff-status-text');

                if (targetObj) {
                    const distToHouse = Math.hypot(
                        carPhysics.x - targetObj.dropOffPos.x,
                        carPhysics.z - targetObj.dropOffPos.z
                    );

                    // Drop-off ring outer radius is 4.6m; player counts as inside when within 5.4m
                    const isInsideZone = distToHouse < 5.4;

                    if (isInsideZone) {
                        gameState.isInsideDropoff = true;
                        // Accumulate progress over exactly 10 seconds inside the blue area
                        gameState.dropoffProgress = Math.min(1.0, gameState.dropoffProgress + dt / gameState.dropoffDuration);

                        if (dropBoxEl) dropBoxEl.classList.remove('hidden');
                        if (dropBarEl) dropBarEl.style.width = (gameState.dropoffProgress * 100) + '%';
                        if (dropTextEl) {
                            dropTextEl.innerHTML = `📦 MENURUNKAN PAKET DI AREA RUMAH ${gameState.targetHouse}...`;
                        }

                        // Animate 3D Blue Target Ring & Expanding Progress Disc
                        targetRingOuter.rotation.z -= dt * (2.0 + gameState.dropoffProgress * 6.0);
                        targetRingInner.material.opacity = 0.28 + gameState.dropoffProgress * 0.40;
                        if (typeof targetProgressFill !== 'undefined' && targetProgressFill) {
                            const sc = Math.max(0.001, gameState.dropoffProgress);
                            targetProgressFill.scale.set(sc, sc, sc);
                            targetProgressFill.material.opacity = 0.45 + gameState.dropoffProgress * 0.45;
                        }

                        // Complete delivery after remaining in the blue area for 10 seconds (100% full bar)!
                        if (gameState.dropoffProgress >= 1.0) {
                            gameState.dropoffProgress = 0;
                            if (dropBoxEl) dropBoxEl.classList.add('hidden');
                            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);
                            triggerDeliverySuccess();
                        }
                    } else {
                        // Left the blue area before completing 10s: smoothly drain progress bar
                        if (gameState.dropoffProgress > 0) {
                            gameState.dropoffProgress = Math.max(0, gameState.dropoffProgress - dt * 0.45);
                            if (dropBarEl) dropBarEl.style.width = (gameState.dropoffProgress * 100) + '%';
                            if (dropTextEl) {
                                dropTextEl.innerHTML = `⚠️ KELUAR DARI AREA! Masuk kembali ke area biru Rumah ${gameState.targetHouse}!`;
                            }
                            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) {
                                const sc = Math.max(0.001, gameState.dropoffProgress);
                                targetProgressFill.scale.set(sc, sc, sc);
                            }
                        } else {
                            if (dropBoxEl) dropBoxEl.classList.add('hidden');
                            if (typeof targetProgressFill !== 'undefined' && targetProgressFill) targetProgressFill.scale.set(0.001, 0.001, 0.001);
                        }
                        gameState.isInsideDropoff = false;
                        targetRingInner.material.opacity = 0.28;
                    }
                }

                // Check if 2-minute Timer ran out -> Deduct Salary (-Gaji)
                if (gameState.hasPackage && gameState.timeRemaining <= 0) {
                    triggerDeliveryTimeout();
                }
            }

            // 4. Camera Follow Logic (Third-Person vs First-Person Driver Seat)
            if (gameState.cameraMode === 'FIRST') {
                // Exact First-Person Steering Wheel Cockpit View (Matching Reference Image 4!)
                const localEye = new THREE.Vector3(0, 2.18, 0.12);
                localEye.applyAxisAngle(new THREE.Vector3(0, 1, 0), carPhysics.angle);
                camera.position.set(
                    carPhysics.x + localEye.x,
                    localEye.y,
                    carPhysics.z + localEye.z
                );

                const lookDist = 14;
                const lookYaw = carPhysics.angle + gameState.camYawOffset;
                const lookX = carPhysics.x - Math.sin(lookYaw) * lookDist;
                const lookZ = carPhysics.z - Math.cos(lookYaw) * lookDist;
                camera.lookAt(lookX, 1.55, lookZ);
            } else {
                // Smooth Roblox Third-Person Follow Camera: Scroll Zoom + Right-Click Orbit
                gameState.camZoom += (gameState.targetZoom - gameState.camZoom) * Math.min(1, dt * 9.5);

                const totalYaw = carPhysics.angle + gameState.camYawOffset;
                const pitch = gameState.camPitchOffset;
                const horizDist = Math.max(1.2, Math.cos(pitch) * gameState.camZoom);
                const vertDist = Math.max(0.65, Math.sin(pitch) * gameState.camZoom);

                const lookTargetY = 1.55;
                const desiredX = carPhysics.x + Math.sin(totalYaw) * horizDist;
                const desiredY = lookTargetY + vertDist;
                const desiredZ = carPhysics.z + Math.cos(totalYaw) * horizDist;

                camera.position.x += (desiredX - camera.position.x) * Math.min(1, dt * 9.5);
                camera.position.y += (desiredY - camera.position.y) * Math.min(1, dt * 9.5);
                camera.position.z += (desiredZ - camera.position.z) * Math.min(1, dt * 9.5);
                camera.lookAt(carPhysics.x, lookTargetY, carPhysics.z);
            }

            // 5. Falling Autumn Leaves & Volumetric God Rays Shimmer Animation
            const timeSec = performance.now() * 0.001;
            leavesData.forEach(lf => {
                lf.mesh.position.y -= lf.speedY * dt;
                lf.mesh.position.x += Math.sin(timeSec + lf.swayOffset) * 0.85 * dt;
                lf.mesh.rotation.x += dt * 1.2;
                lf.mesh.rotation.y += dt * 1.5;
                if (lf.mesh.position.y < 0.2) {
                    lf.mesh.position.y = 26;
                    lf.mesh.position.x = carPhysics.x + (Math.random() - 0.5) * 140;
                    lf.mesh.position.z = carPhysics.z + (Math.random() - 0.5) * 140;
                }
            });

            godRayMeshes.forEach(gr => {
                gr.mesh.material.opacity = gr.baseOpacity + Math.sin(timeSec * 0.9 + gr.phase) * 0.006;
            });

            // 6. Update Minimap
            
            // Animate Windmill Rotor
            if (typeof wmRotor !== 'undefined' && wmRotor) {
                wmRotor.rotation.z += dt * 1.6;
            }

            // Animate Railroad Level Crossing Alternating Red Flashers
            if (typeof railroadFlasherLamps !== 'undefined' && railroadFlasherLamps.length > 0) {
                const now = performance.now();
                const flashPhase = Math.floor(now * 0.003) % 2;
                railroadFlasherLamps.forEach((lamp, idx) => {
                    lamp.material.color.setHex((idx % 2 === flashPhase) ? 0xef4444 : 0x330000);
                });
            }

            // Animate Flowing River Water
            if (typeof waterTex !== 'undefined' && waterTex) {
                waterTex.offset.y += dt * 0.035;
            }

            // Dynamic GPS Navigation Banner Updates
            const gpsTargetName = document.getElementById('gps-target-name');
            const gpsDistance = document.getElementById('gps-distance');
            const gpsIcon = document.getElementById('gps-icon');

            if (gpsTargetName && gpsDistance) {
                let targetX = pickupZonePos.x;
                let targetZ = pickupZonePos.z;
                let tName = 'Pabrik Pizza';

                if (gameState.hasPackage && gameState.targetHouse && houses[gameState.targetHouse]) {
                    targetX = houses[gameState.targetHouse].dropOffPos.x;
                    targetZ = houses[gameState.targetHouse].dropOffPos.z;
                    tName = 'Rumah ' + gameState.targetHouse;
                }

                const distToTarget = Math.hypot(targetX - carPhysics.x, targetZ - carPhysics.z);
                gpsTargetName.textContent = tName;
                gpsDistance.textContent = Math.round(distToTarget) + ' m';

                const dx = targetX - carPhysics.x;
                const dz = targetZ - carPhysics.z;
                const angleToTarget = Math.atan2(dx, dz);
                let relAngle = angleToTarget - carPhysics.angle;
                if (gpsIcon) {
                    gpsIcon.style.transform = 'rotate(' + Math.round(relAngle * (180 / Math.PI)) + 'deg)';
                }
            }

            drawMinimap();
        }

        function animate(now) {
            requestAnimationFrame(animate);
            const dt = Math.min(0.05, (now - lastTime) / 1000);
            lastTime = now;

            updateGame(dt);
            renderer.render(scene, camera);
        }

        // Responsive Resize Handler
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        window.onload = function () {
            spawnCarAtFactory();
            updateHUD();
            camera.position.set(-426, 5.2, 0);
            camera.lookAt(-410, 1.8, 0);
            showToast(
                '🏭 ANDA DI DEPAN PABRIK PIZZA (TITIK AWAL)',
                'Mundur (S / ▼) ke dalam garasi pabrik untuk mengambil paket pizza!',
                'info'
            );
            lastTime = performance.now();
            animate(lastTime);
        };
    </script>
</body>
</html>