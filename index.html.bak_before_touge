        function triggerSingleBackfirePop(intensity = 1.0) {
            backfireState.flameTimer = 0.16;
            backfireState.isFiring = true;

            const carAngle = carGroup.rotation.y;
            const sinA = Math.sin(carAngle);
            const cosA = Math.cos(carAngle);

            // Emit sparks from both exhaust pipes
            [-0.80, 0.80].forEach(exX => {
                const wx = carPhysics.x + cosA * exX + sinA * 2.72;
                const wz = carPhysics.z - sinA * exX + cosA * 2.72;
                for (let i = 0; i < 4; i++) {
                    spawnExhaustSpark(new THREE.Vector3(wx, 0.48, wz), carAngle);
