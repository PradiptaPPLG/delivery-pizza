        // ====================================================================
        // SPEEDOMETER HUD (Sisi Kanan Bawah Mini Gauge)
        // ====================================================================
        const speedoCanvas = document.getElementById('speedo-canvas');
        const sCtx = speedoCanvas ? speedoCanvas.getContext('2d') : null;

        function drawSpeedometer(kmh, gearText, gearColor, isBackfiring) {
            if (!sCtx) return;
            const w = speedoCanvas.width;
            const h = speedoCanvas.height;
            sCtx.clearRect(0, 0, w, h);

            const cx = w / 2;
            const cy = h / 2;
            const radius = w * 0.41;

            // Dial Background: Sleek gradient dark disc
            const bgGrad = sCtx.createRadialGradient(cx, cy, radius * 0.2, cx, cy, radius + 3);
            bgGrad.addColorStop(0, 'rgba(28, 18, 14, 0.88)');
            bgGrad.addColorStop(1, 'rgba(10, 6, 4, 0.94)');

            sCtx.beginPath();
            sCtx.arc(cx, cy, radius + 3, 0, Math.PI * 2);
            sCtx.fillStyle = bgGrad;
            sCtx.fill();

            // Outer Bezel Rim (Flashes fiery orange during backfire pops!)
            sCtx.beginPath();
            sCtx.arc(cx, cy, radius + 3, 0, Math.PI * 2);
            sCtx.strokeStyle = isBackfiring ? '#ff5500' : 'rgba(255, 180, 120, 0.28)';
            sCtx.lineWidth = isBackfiring ? 2.5 : 1.5;
            if (isBackfiring) {
                sCtx.shadowColor = '#ff5500';
                sCtx.shadowBlur = 10;
            }
            sCtx.stroke();
            sCtx.shadowBlur = 0;

            // Gauge Arc Parameters (250 degrees from 135 deg to 25 deg)
            const startAngle = 0.75 * Math.PI;
            const totalSweep = 1.5 * Math.PI;
            const endAngle = startAngle + totalSweep;

            // Track background arc
            sCtx.beginPath();
            sCtx.arc(cx, cy, radius - 2, startAngle, endAngle);
            sCtx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
            sCtx.lineWidth = 4.5;
            sCtx.lineCap = 'round';
            sCtx.stroke();

            // Active Speed Arc (Cyan -> Emerald -> Amber -> Redline)
            const maxKmh = 90;
            const speedRatio = Math.max(0, Math.min(1, kmh / maxKmh));
            const currentAngle = startAngle + speedRatio * totalSweep;

            if (speedRatio > 0.015) {
                const arcGrad = sCtx.createLinearGradient(0, cy + radius, w, cy - radius);
                arcGrad.addColorStop(0, '#38bdf8');
                arcGrad.addColorStop(0.35, '#10b981');
                arcGrad.addColorStop(0.7, '#f59e0b');
                arcGrad.addColorStop(1.0, '#ef4444');

                sCtx.beginPath();
                sCtx.arc(cx, cy, radius - 2, startAngle, currentAngle);
                sCtx.strokeStyle = arcGrad;
                sCtx.lineWidth = 4.5;
                sCtx.lineCap = 'round';
                if (isBackfiring || kmh > 65) {
                    sCtx.shadowColor = isBackfiring ? '#ff5500' : '#f59e0b';
                    sCtx.shadowBlur = 8;
                }
                sCtx.stroke();
                sCtx.shadowBlur = 0;
            }

            // Dial Ticks
            for (let s = 0; s <= 90; s += 15) {
                const tRatio = s / 90;
                const a = startAngle + tRatio * totalSweep;
                const isMajor = (s % 30 === 0);
                const tickLen = isMajor ? 5.5 : 3.0;

                const x1 = cx + Math.cos(a) * (radius - 5.5);
                const y1 = cy + Math.sin(a) * (radius - 5.5);
                const x2 = cx + Math.cos(a) * (radius - 5.5 - tickLen);
                const y2 = cy + Math.sin(a) * (radius - 5.5 - tickLen);

                sCtx.beginPath();
                sCtx.moveTo(x1, y1);
                sCtx.lineTo(x2, y2);
                sCtx.strokeStyle = isMajor ? (s >= 75 ? '#ef4444' : 'rgba(255, 255, 255, 0.75)') : 'rgba(255, 255, 255, 0.35)';
                sCtx.lineWidth = isMajor ? 1.4 : 0.9;
                sCtx.stroke();

                if (isMajor) {
                    const tx = cx + Math.cos(a) * (radius - 16.5);
                    const ty = cy + Math.sin(a) * (radius - 16.5);
                    sCtx.fillStyle = s >= 75 ? '#ef4444' : 'rgba(255, 255, 255, 0.65)';
                    sCtx.font = 'bold 8.5px Inter, sans-serif';
                    sCtx.textAlign = 'center';
                    sCtx.textBaseline = 'middle';
                    sCtx.fillText(s, tx, ty);
                }
            }

            // Sweeping Needle
            sCtx.save();
            sCtx.translate(cx, cy);
            sCtx.rotate(currentAngle);
            sCtx.beginPath();
            sCtx.moveTo(-radius * 0.15, 0);
            sCtx.lineTo(radius - 7, 0);
            sCtx.strokeStyle = isBackfiring ? '#ff3b30' : (kmh > 65 ? '#f59e0b' : '#38bdf8');
            sCtx.lineWidth = 2.2;
            sCtx.lineCap = 'round';
            sCtx.shadowColor = sCtx.strokeStyle;
            sCtx.shadowBlur = 6;
            sCtx.stroke();
            sCtx.restore();

            // Center Pin
            sCtx.beginPath();
            sCtx.arc(cx, cy, 3.8, 0, Math.PI * 2);
            sCtx.fillStyle = '#ffffff';
            sCtx.fill();
            sCtx.strokeStyle = '#18100c';
            sCtx.lineWidth = 1.2;
            sCtx.stroke();

            // Digital KM/H readout
            sCtx.font = 'bold 19px Fredoka, sans-serif';
            sCtx.fillStyle = '#ffffff';
            sCtx.textAlign = 'center';
            sCtx.textBaseline = 'middle';
            sCtx.fillText(kmh, cx, cy + 12);

            sCtx.font = 'bold 7.5px Inter, sans-serif';
            sCtx.fillStyle = 'rgba(255, 255, 255, 0.55)';
            sCtx.fillText('KM/J', cx, cy + 24);

            // Gear / Backfire / Engine Status at Top
            sCtx.font = 'extrabold 8.5px Fredoka, sans-serif';
            let displayTopText = isBackfiring ? '🔥 POP!' : gearText;
            let displayTopColor = isBackfiring ? '#ff6600' : gearColor;
            if (typeof carPhysics !== 'undefined' && !carPhysics.engineOn) {
                displayTopText = '🔴 MESIN OFF';
                displayTopColor = '#f43f5e';
            }
            sCtx.fillStyle = displayTopColor;
            sCtx.fillText(displayTopText, cx, cy - 14);
        }

