        function triggerBackfireBurst(count = 2, intensity = 1.0) {
            triggerSingleBackfirePop(intensity);
            if (count > 1) {
                let accumulatedDelay = 0;
                for (let i = 1; i < count; i++) {
                    accumulatedDelay += (42 + Math.random() * 46);
