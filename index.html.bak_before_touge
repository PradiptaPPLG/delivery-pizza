<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Delivery Pizza 3D - Medium Poly Edition</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #2b1810;
            font-family: 'Inter', sans-serif;
        }
        .font-display {
            font-family: 'Fredoka', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .hud-glass {
            background: rgba(20, 14, 12, 0.78);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 180, 120, 0.25);
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
        }
        .btn-game {
            transition: all 0.15s ease;
            box-shadow: 0 4px 0 rgba(0,0,0,0.4);
        }
        .btn-game:active, .btn-game.active-press {
            transform: translateY(3px);
            box-shadow: 0 1px 0 rgba(0,0,0,0.4);
        }
        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.88; }
        }
        .animate-mission {
            animation: pulseGlow 2s infinite ease-in-out;
        }
        @keyframes urgentBlink {
            0%, 100% { background-color: rgba(220, 38, 38, 0.9); }
            50% { background-color: rgba(127, 29, 29, 0.9); }
        }
        .timer-urgent {
            animation: urgentBlink 0.6s infinite;
        }
        .floating-text-shadow {
            text-shadow: 0 2px 8px rgba(0,0,0,0.95), 0 0 2px #000, 0 1px 3px #000;
        }
        .floating-glow-amber {
            text-shadow: 0 0 14px rgba(245, 158, 11, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-sky {
            text-shadow: 0 0 14px rgba(56, 189, 248, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-emerald {
            text-shadow: 0 0 14px rgba(16, 185, 129, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        .floating-glow-rose {
            text-shadow: 0 0 14px rgba(244, 63, 94, 0.8), 0 2px 6px rgba(0,0,0,0.95);
        }
        /* DUELYST-INSPIRED MENU STYLES */
        @keyframes glyphSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes glyphPulseGlow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(245, 158, 11, 0.65), inset 0 0 12px rgba(245, 158, 11, 0.45);
                border-color: rgba(251, 191, 36, 0.9);
            }
            50% {
                box-shadow: 0 0 35px rgba(245, 158, 11, 0.95), inset 0 0 22px rgba(245, 158, 11, 0.7);
                border-color: rgba(254, 240, 138, 1.0);
            }
        }
        .duelyst-glyph {
            position: relative;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid rgba(245, 158, 11, 0.8);
            background: radial-gradient(circle, rgba(245, 158, 11, 0.35) 0%, rgba(30, 15, 8, 0.9) 70%);
            display: flex;
            align-items: center;
            justify-content: center;
            animation: glyphPulseGlow 2.8s infinite ease-in-out;
            transition: all 0.25s ease;
        }
        .duelyst-glyph::before {
            content: '';
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            border: 1.5px dashed rgba(251, 191, 36, 0.6);
            animation: glyphSpin 18s linear infinite;
        }
        .duelyst-glyph:hover {
            transform: scale(1.12);
        }
        .hex-btn {
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .hex-btn:hover {
            transform: translateY(-2px) scale(1.08);
            box-shadow: 0 0 16px rgba(245, 158, 11, 0.6);
        }
        .menu-btn {
            transition: all 0.2s ease;
        }
        .menu-btn:hover {
            transform: translateX(6px);
        }
        .modal-glass {
            background: rgba(18, 12, 10, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 180, 120, 0.25);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
        }
    </style>
</head>
<body class="relative">

    <!-- 3D Canvas Container -->
    <div id="canvas-container" class="w-full h-full relative"></div>

    <!-- ======================================================== -->
    <!-- GAMEPLAY HUD (Controlled via opacity, hidden during menu)   -->
    <!-- ======================================================== -->
    <div id="gameplay-hud" class="transition-opacity duration-700 opacity-0 pointer-events-none">

        <!-- TOP HUD: Gaji (Kiri), Menu Button (Tengah), Jam + FPS (Kanan) -->
        <div class="fixed top-3 left-3 right-3 z-20 pointer-events-none flex items-start justify-between gap-3">
            
            <!-- Left: Salary Card -->
            <div class="flex items-center gap-2.5 pointer-events-auto">
                <div id="salary-card" class="hud-glass rounded-2xl px-4 py-2.5 flex items-center gap-3 transition-transform duration-300">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 font-bold text-lg">
                        Rp
                    </div>
                    <div>
                        <div class="text-[10px] uppercase tracking-wider text-amber-200/70 font-bold">Total Gaji Kurir</div>
                        <div id="hud-salary" class="font-display text-xl text-emerald-400 leading-tight">Rp 100.000</div>
                    </div>
                    <div class="border-l border-white/15 pl-3 ml-1 flex gap-3 text-xs">
                        <div>
                            <span class="text-white/60 block text-[10px]">Sukses</span>
                            <span id="hud-delivered" class="font-bold text-emerald-300">0</span>
                        </div>
                        <div>
                            <span class="text-white/60 block text-[10px]">Telat</span>
                            <span id="hud-failed" class="font-bold text-rose-400">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Center: Quick Menu / Pause Button -->
            <button onclick="returnToMenu(); this.blur();" class="hud-glass rounded-2xl px-3.5 py-2 flex items-center gap-2 shadow-lg border border-white/15 pointer-events-auto hover:bg-white/10 active:scale-95 transition text-xs font-bold text-white/90 cursor-pointer" title="Kembali ke Menu Utama [ESC]">
                <span>⚙️</span> <span>Menu [ESC]</span>
            </button>

            <!-- Right: Clock & FPS Widget Only -->
            <div class="hud-glass rounded-2xl px-3.5 py-2 flex items-center gap-3 shadow-lg border border-white/15 pointer-events-auto">
                <!-- Clock & Status Pill -->
                <div class="flex items-center gap-2">
                    <span id="weather-clock-icon" class="text-base animate-pulse">☀️</span>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span id="weather-clock-text" class="font-display text-sm font-black text-amber-300 tracking-wider">12:00</span>
                            <span id="weather-period-badge" class="text-[10px] font-extrabold uppercase px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-400/30">SIANG</span>
                        </div>
                        <div id="weather-condition-text" class="text-[10px] font-bold text-white/80 leading-tight">Cerah Berawan</div>
                    </div>
                </div>

                <!-- Real-Time FPS Badge -->
                <div class="border-l border-white/15 pl-2.5">
                    <span id="hud-fps" class="text-[10px] font-black px-2 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-400/40">60 FPS</span>
                </div>
            </div>
        </div>

        <!-- MIDDLE RIGHT: Quest / Mission Objective Panel (Toggleable with 'L') -->
        <div id="quest-container" class="fixed right-3.5 top-1/2 -translate-y-1/2 z-20 pointer-events-auto transition-all duration-300 select-none w-72 sm:w-80">
            <div id="mission-banner" class="hud-glass rounded-2xl p-3.5 border border-white/15 shadow-2xl backdrop-blur-md flex flex-col gap-2">
                <!-- Header with Quest Badge, Cargo Status & Hide Key Hint -->
                <div class="flex items-center justify-between gap-2 border-b border-white/15 pb-2">
                    <span id="mission-badge" class="text-[11px] font-black tracking-wider uppercase text-amber-400 drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]">
                        TAHAP 1 • AMBIL PAKET
                    </span>
                    <button onclick="toggleQuestVisibility(); this.blur();" class="text-[10px] font-bold text-white/70 hover:text-white bg-black/40 hover:bg-black/60 px-2 py-0.5 rounded border border-white/10 transition" title="Tekan L untuk sembunyikan/tampilkan quest">
                        [L] Sembunyi
                    </button>
                </div>

                <!-- Cargo status pill -->
                <div class="flex items-center gap-1.5 text-xs text-white/90">
                    <span>📦</span>
                    <span id="cargo-status" class="font-bold text-white">Bagasi: Kosong</span>
                </div>

                <!-- Mission instruction text -->
                <div id="mission-text" class="font-display text-white text-xs sm:text-sm font-bold leading-snug drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)]">
                    Mundur (<span class="text-amber-300 font-extrabold">S / ▼</span>) ke dalam <span class="text-emerald-300 font-extrabold underline underline-offset-2">Garasi Pabrik</span> untuk ambil paket!
                </div>

                <!-- Timer Bar (during delivery) -->
                <div id="timer-container" class="hidden text-left pt-1 border-t border-white/10">
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="text-amber-200/90 font-bold text-[11px]">Batas Waktu:</span>
                        <span id="timer-display" class="font-display text-sm font-black text-white tracking-wider">02:00</span>
                    </div>
                    <div class="w-full h-1.5 bg-black/60 rounded-full overflow-hidden shadow">
                        <div id="timer-bar" class="h-full bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 rounded-full transition-all duration-200" style="width: 100%;"></div>
                    </div>
                </div>

                <!-- Dropoff progress bar (when delivering at house) -->
                <div id="dropoff-progress-box" class="hidden text-left pt-1 border-t border-white/10 transition-all duration-300">
                    <div class="flex items-center gap-1.5 text-[11px] mb-1">
                        <span class="inline-block w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
                        <span id="dropoff-status-text" class="font-extrabold text-sky-300">📦 Menurunkan paket...</span>
                    </div>
                    <div class="w-full h-2 bg-black/80 rounded-full p-0.5 border border-sky-400/60 shadow">
                        <div id="dropoff-progress-bar" class="h-full bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- Floating GPS Direction Pill -->
                <div id="gps-banner" class="pt-1 border-t border-white/10 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-1.5">
                        <span id="gps-icon" class="text-sm inline-block transform transition-transform duration-100">🧭</span>
                        <span id="gps-target-name" class="font-bold text-white text-xs">Pabrik Pizza</span>
                    </div>
                    <span id="gps-distance" class="font-black text-amber-300 text-xs">0 m</span>
                </div>
            </div>
        </div>

        <!-- Small Floating [L] Quest Toggle Button (When quest is hidden, click or press L to restore) -->
        <button id="quest-collapsed-btn" onclick="toggleQuestVisibility(); this.blur();" class="hidden fixed right-3 top-1/2 -translate-y-1/2 z-20 hud-glass px-3 py-2 rounded-xl border border-white/20 text-white text-xs font-bold shadow-lg hover:bg-white/20 flex items-center gap-1.5 transition">
            <span>📜</span> <span>Quest [L]</span>
        </button>

        <!-- CENTER POPUP NOTIFICATION (Salary + / - Feedback, floating text without blocking container) -->
        <div id="toast-container" class="fixed top-28 left-1/2 -translate-x-1/2 z-30 pointer-events-none flex flex-col items-center gap-2 w-full max-w-md px-4"></div>

        <!-- BOTTOM LEFT: Interactive 2D Minimap -->
        <div class="fixed bottom-3 left-3 z-20 flex items-end gap-3 pointer-events-none">
            <div class="hud-glass rounded-2xl p-2.5 pointer-events-auto">
                <div class="flex items-center justify-between mb-1 px-1">
                    <span class="text-[11px] font-bold text-amber-300 uppercase tracking-wider">Peta Pengiriman (Pabrik → Perumahan)</span>
                    <span id="minimap-target-label" class="text-[11px] font-extrabold text-emerald-400">GARASI</span>
                </div>
                <canvas id="minimap-canvas" width="220" height="115" class="rounded-xl border border-white/15 bg-[#140e0a]"></canvas>
            </div>

            <!-- Hidden backward-compatible elements for existing logic -->
            <span id="hud-speed" class="hidden">0</span>
            <span id="hud-gear" class="hidden">DIAM (N)</span>
        </div>

        <!-- BOTTOM RIGHT: Speedometer, Engine [P] Switch & Key Status -->
        <div class="fixed bottom-3 right-3 z-30 flex items-end gap-2.5 pointer-events-auto select-none">
            <!-- Engine Starter Button & Key Indicators -->
            <div class="flex flex-col items-end gap-2">
                <!-- Engine Toggle Button (Klik atau Tekan P) -->
                <button id="btn-engine-toggle" onclick="toggleEngine(); this.blur();" class="hud-glass rounded-2xl px-3.5 py-2 flex items-center gap-2.5 shadow-lg border border-rose-500/40 hover:border-emerald-400/60 transition-all duration-200 active:scale-95 cursor-pointer" title="Tekan P di keyboard untuk Menyalakan / Mematikan Mesin">
                    <div id="engine-status-dot" class="w-3.5 h-3.5 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.8)]"></div>
                    <div class="text-left">
                        <div class="text-[9px] uppercase tracking-wider text-white/60 font-bold">Mesin [P]</div>
                        <div id="engine-status-text" class="font-display text-xs font-black text-rose-400 leading-tight">MATI</div>
                    </div>
                </button>

                <!-- Quick Key Indicators -->
                <div class="hud-glass rounded-xl px-2 py-1 flex items-center gap-1.5 text-[9px] font-bold text-white/80 border border-white/10">
                    <span id="key-ind-w" class="px-1.5 py-0.5 rounded bg-white/10">W</span>
                    <span id="key-ind-s" class="px-1.5 py-0.5 rounded bg-white/10">S</span>
                    <span id="key-ind-space" class="px-1.5 py-0.5 rounded bg-white/10">SPASI</span>
                    <span id="key-ind-p" class="px-1.5 py-0.5 rounded bg-rose-500/30 text-rose-300 border border-rose-400/40">P</span>
                    <button id="key-ind-b" class="px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 border border-orange-400/30 hover:bg-orange-500/40 transition">🔥 POP [B]</button>
                </div>
            </div>

            <!-- Dedicated Mini Speedometer Canvas -->
            <div id="speedo-widget" class="flex flex-col items-center pointer-events-none">
                <canvas id="speedo-canvas" width="124" height="124" class="drop-shadow-[0_4px_16px_rgba(0,0,0,0.85)]"></canvas>
            </div>
        </div>

    </div> <!-- End Gameplay HUD -->

    <!-- ======================================================== -->
    <!-- MAIN MENU OVERLAY (Duelyst-Inspired AAA Presentation)    -->
    <!-- ======================================================== -->
    <div id="main-menu-overlay" class="fixed inset-0 z-40 flex flex-col justify-between p-6 sm:p-12 pointer-events-auto transition-all duration-700 select-none bg-gradient-to-r from-[#0d0908]/92 via-[#0d0908]/55 to-transparent">
        
        <!-- TOP ROW: Brand Title Logo (Left) & Hex Badges (Right) -->
        <div class="flex items-start justify-between w-full">
            <!-- Left: Title Logo -->
            <div class="flex flex-col gap-1">
                <div class="flex items-center gap-3.5">
                    <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-amber-500 via-orange-500 to-red-600 flex items-center justify-center shadow-lg shadow-amber-500/40 border border-amber-300/50 text-3xl animate-pulse">
                        🍕
                    </div>
                    <div>
                        <h1 class="font-display text-3xl sm:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-orange-200 to-white tracking-wider drop-shadow-[0_4px_16px_rgba(0,0,0,0.95)]">
                            DELIVERY PIZZA
                        </h1>
                        <div class="flex items-center gap-2 mt-0.5">
                            <span class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-widest text-amber-300 bg-amber-500/20 px-2.5 py-0.5 rounded border border-amber-400/40">
                                OPEN WORLD 3D
                            </span>
                            <span class="text-[10px] sm:text-[11px] text-white/60 font-semibold tracking-wider">• AUTUMN COURIER ADVENTURE</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Duelyst-style Hex Badges -->
            <div class="flex items-center gap-2.5 sm:gap-3.5">
                <!-- Quests / Panduan Hex -->
                <button onclick="openMenuModal('modal-controls'); sound.playButtonClick();" class="hex-btn w-12 h-14 sm:w-14 sm:h-16 bg-[#1b1411]/85 border border-amber-400/40 flex flex-col items-center justify-center text-amber-300 hover:text-white hover:bg-amber-500/30 shadow-lg cursor-pointer backdrop-blur-md" title="Panduan & Kontrol Permainan">
                    <span class="text-base sm:text-lg">📜</span>
                    <span class="text-[8px] sm:text-[9px] font-black uppercase tracking-tighter mt-0.5">KONTROL</span>
                </button>

                <!-- Audio Toggle Hex -->
                <button id="menu-sound-btn" onclick="toggleAudioMute(); sound.playButtonClick();" class="hex-btn w-12 h-14 sm:w-14 sm:h-16 bg-[#1b1411]/85 border border-sky-400/40 flex flex-col items-center justify-center text-sky-300 hover:text-white hover:bg-sky-500/30 shadow-lg cursor-pointer backdrop-blur-md" title="Nyalakan / Matikan Suara Audio">
                    <span id="menu-sound-icon" class="text-base sm:text-lg">🔊</span>
                    <span class="text-[8px] sm:text-[9px] font-black uppercase tracking-tighter mt-0.5">AUDIO</span>
                </button>

                <!-- Fullscreen Hex -->
                <button onclick="toggleFullscreen(); sound.playButtonClick();" class="hex-btn w-12 h-14 sm:w-14 sm:h-16 bg-[#1b1411]/85 border border-emerald-400/40 flex flex-col items-center justify-center text-emerald-300 hover:text-white hover:bg-emerald-500/30 shadow-lg cursor-pointer backdrop-blur-md" title="Mode Layar Penuh">
                    <span class="text-base sm:text-lg">⛶</span>
                    <span class="text-[8px] sm:text-[9px] font-black uppercase tracking-tighter mt-0.5">FULL</span>
                </button>
            </div>
        </div>

        <!-- MIDDLE ROW: Vertical Sleek Menu Options (Left-Aligned, DUELYST style) -->
        <div class="flex items-center my-auto py-4">
            <div class="flex flex-col gap-3.5 max-w-md w-full">
                
                <!-- 1. PLAY BUTTON WITH DUELYST ROTATING GLYPH -->
                <div class="flex items-center gap-4 group">
                    <!-- Duelyst Rotating Circular Glyph Ring -->
                    <div class="duelyst-glyph shrink-0 shadow-amber-500/40 cursor-pointer" onclick="startGameFromMenu();">
                        <span class="text-amber-300 text-lg sm:text-xl drop-shadow-[0_0_8px_rgba(251,191,36,0.9)] ml-0.5">▶</span>
                    </div>

                    <button onclick="startGameFromMenu();" onmouseenter="sound.playMenuHover();" class="menu-btn group-hover:border-amber-400 group-hover:bg-amber-500/25 text-left px-5 py-3.5 rounded-2xl bg-black/65 border border-amber-400/50 backdrop-blur-md shadow-2xl transition-all duration-200 flex-1 cursor-pointer">
                        <div class="flex items-center justify-between">
                            <span class="font-display text-xl sm:text-2xl font-black text-white group-hover:text-amber-300 tracking-wider">
                                MULAI PENGIRIMAN
                            </span>
                            <span class="text-xs font-bold text-amber-300/90 px-2 py-0.5 rounded bg-amber-500/20 border border-amber-400/40 uppercase tracking-widest">
                                PLAY
                            </span>
                        </div>
                        <div class="text-[11px] text-white/70 mt-0.5">Nyalakan mesin dan antarkan pizza panas keliling lembah!</div>
                    </button>
                </div>

                <!-- 2. GARASI & STATUS MOBIL -->
                <button onclick="openMenuModal('modal-garage'); sound.playButtonClick();" onmouseenter="sound.playMenuHover();" class="menu-btn ml-16 text-left px-5 py-2.5 rounded-2xl bg-black/40 hover:bg-black/70 border border-white/15 hover:border-amber-300/60 backdrop-blur-md shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-between">
                    <div>
                        <div class="font-display text-base sm:text-lg font-bold text-white/90 hover:text-white tracking-wide flex items-center gap-2">
                            <span>🏎️</span> <span>GARASI & MOBIL</span>
                        </div>
                        <div class="text-[11px] text-white/60">Spesifikasi mesin V6 Turbo, suspensi 4 roda & knalpot api</div>
                    </div>
                    <span class="text-white/40 text-lg font-bold">›</span>
                </button>

                <!-- 3. PANDUAN & KONTROL -->
                <button onclick="openMenuModal('modal-controls'); sound.playButtonClick();" onmouseenter="sound.playMenuHover();" class="menu-btn ml-16 text-left px-5 py-2.5 rounded-2xl bg-black/40 hover:bg-black/70 border border-white/15 hover:border-sky-300/60 backdrop-blur-md shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-between">
                    <div>
                        <div class="font-display text-base sm:text-lg font-bold text-white/90 hover:text-white tracking-wide flex items-center gap-2">
                            <span>🎮</span> <span>PANDUAN & KONTROL</span>
                        </div>
                        <div class="text-[11px] text-white/60">W/A/S/D menyetir, [P] Starter Mesin, Spasi Handbrake Drift</div>
                    </div>
                    <span class="text-white/40 text-lg font-bold">›</span>
                </button>

                <!-- 4. PENGATURAN -->
                <button onclick="openMenuModal('modal-settings'); sound.playButtonClick();" onmouseenter="sound.playMenuHover();" class="menu-btn ml-16 text-left px-5 py-2.5 rounded-2xl bg-black/40 hover:bg-black/70 border border-white/15 hover:border-emerald-300/60 backdrop-blur-md shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-between">
                    <div>
                        <div class="font-display text-base sm:text-lg font-bold text-white/90 hover:text-white tracking-wide flex items-center gap-2">
                            <span>⚙️</span> <span>PENGATURAN GRAFIK & SUARA</span>
                        </div>
                        <div class="text-[11px] text-white/60">Jarak render distance (FPS booster), cuaca & audio</div>
                    </div>
                    <span class="text-white/40 text-lg font-bold">›</span>
                </button>

            </div>
        </div>

        <!-- BOTTOM ROW: Status Pills & Engine Tip -->
