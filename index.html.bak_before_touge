            0.5
        );

        // Separate West & East Splines: Stops and starts with 100% perpendicular precision at bridge seams!
        const westPoints = highwayPoints.slice(0, 5); // 0 to 4 (ends exactly at P_west)
        const eastPoints = highwayPoints.slice(6);    // 6 to 21 (starts exactly at P_east)

        const splineWest = new THREE.CatmullRomCurve3(
            westPoints.map(p => new THREE.Vector3(p[0], 0.28, p[1])),
            false, 'catmullrom', 0.5
        );
        const splineEast = new THREE.CatmullRomCurve3(
            eastPoints.map(p => new THREE.Vector3(p[0], 0.28, p[1])),
            false, 'catmullrom', 0.5
        );

        const roadWidth = 14.5;
        const roadPositions = [];
        const roadUvs = [];
        const roadIndices = [];
        const realDashPositions = [];
        const realDashIndices = [];

        const bAngle = -Math.atan2(26, 65);
        const bridgeDir = new THREE.Vector3(Math.cos(bAngle), 0, -Math.sin(bAngle)).normalize();
        const bridgeNorm = new THREE.Vector3(-bridgeDir.z, 0, bridgeDir.x).normalize();

        function appendRoadSection(spline, subdivs, startUvY = 0, seamType = 'none') {
            const basePosIdx = roadPositions.length / 3;
            const totalLen = spline.getLength();

            for (let i = 0; i <= subdivs; i++) {
                const t = i / subdivs;
                const pt = spline.getPoint(t);
                let tan = spline.getTangent(t);
                if (tan.lengthSq() < 0.001) tan = new THREE.Vector3(1, 0, 0);

                let nx = -tan.z;
                let nz = tan.x;
                const normLen = Math.hypot(nx, nz) || 1;
                nx /= normLen;
                nz /= normLen;

                // Enforce 100% perpendicular alignment with wooden bridge at both seams (Zero angle mismatch, zero Z-fighting!)
                if (seamType === 'west_end') {
                    // SplineWest ends at West Seam of Bridge: [-270.5, 39.0]
                    const stepsFromEnd = subdivs - i;
                    if (stepsFromEnd <= 5) {
                        const blend = 1.0 - (stepsFromEnd / 5);
                        nx = nx * (1 - blend) + bridgeNorm.x * blend;
                        nz = nz * (1 - blend) + bridgeNorm.z * blend;
                        const nl = Math.hypot(nx, nz) || 1;
                        nx /= nl;
                        nz /= nl;
                    }
                    if (i === subdivs) {
                        pt.x = -270.5;
                        pt.z = 39.0;
                        nx = bridgeNorm.x;
                        nz = bridgeNorm.z;
                    }
                } else if (seamType === 'east_start') {
                    // SplineEast starts at East Seam of Bridge: [-205.5, 65.0]
                    if (i <= 5) {
                        const blend = 1.0 - (i / 5);
                        nx = nx * (1 - blend) + bridgeNorm.x * blend;
                        nz = nz * (1 - blend) + bridgeNorm.z * blend;
                        const nl = Math.hypot(nx, nz) || 1;
                        nx /= nl;
                        nz /= nl;
                    }
                    if (i === 0) {
                        pt.x = -205.5;
                        pt.z = 65.0;
                        nx = bridgeNorm.x;
                        nz = bridgeNorm.z;
                    }
                }

                const lx = pt.x + nx * (roadWidth / 2);
                const lz = pt.z + nz * (roadWidth / 2);
                const rx = pt.x - nx * (roadWidth / 2);
                const rz = pt.z - nz * (roadWidth / 2);

                roadPositions.push(lx, pt.y, lz);
                roadPositions.push(rx, pt.y, rz);
                const uvY = startUvY + t * totalLen * 0.12;
                roadUvs.push(0, uvY, 1, uvY);

                if (i < subdivs) {
                    const b = basePosIdx + i * 2;
                    roadIndices.push(b, b + 2, b + 1);
                    roadIndices.push(b + 1, b + 2, b + 3);
                }
            }

            // Crisp dashed centerline for this section
            const dashLen = 4.0;
            const gapLen = 5.2;
            const cycleLen = dashLen + gapLen;
            const numDashCycles = Math.floor(totalLen / cycleLen);

            for (let d = 0; d < numDashCycles; d++) {
                const startDist = d * cycleLen + 1.2;
                const endDist = startDist + dashLen;
                if (endDist > totalLen - 0.5) break;

                const subSegments = 3;
                const baseDashIdx = realDashPositions.length / 3;

                for (let s = 0; s <= subSegments; s++) {
                    const u = Math.min(1, Math.max(0, (startDist + (s / subSegments) * dashLen) / totalLen));
                    const pt = spline.getPointAt(u);
                    const tan = spline.getTangentAt(u);
                    let dnx = -tan.z;
                    let dnz = tan.x;
                    const dnormLen = Math.hypot(dnx, dnz) || 1;
                    dnx /= dnormLen;
                    dnz /= dnormLen;

                    if (seamType === 'west_end' && u > 0.90) {
                        const blend = (u - 0.90) / 0.10;
                        dnx = dnx * (1 - blend) + bridgeNorm.x * blend;
                        dnz = dnz * (1 - blend) + bridgeNorm.z * blend;
                    } else if (seamType === 'east_start' && u < 0.10) {
                        const blend = 1.0 - (u / 0.10);
                        dnx = dnx * (1 - blend) + bridgeNorm.x * blend;
                        dnz = dnz * (1 - blend) + bridgeNorm.z * blend;
                    }

                    realDashPositions.push(
                        pt.x + dnx * 0.22, pt.y + 0.045, pt.z + dnz * 0.22,
                        pt.x - dnx * 0.22, pt.y + 0.045, pt.z - dnz * 0.22
                    );
                }

                for (let s = 0; s < subSegments; s++) {
                    const b = baseDashIdx + s * 2;
                    realDashIndices.push(b, b + 2, b + 1);
                    realDashIndices.push(b + 1, b + 2, b + 3);
                }
            }

            return startUvY + totalLen * 0.12;
        }

