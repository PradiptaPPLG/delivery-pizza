    <script>
        /********************************************************************
         * 1. SOUND SYSTEM (Pure Web Audio Vehicle Synthesizer)
         ********************************************************************/
        class SoundManager {
            constructor() {
                this.ctx = null;
                this.initialized = false;
                this.muted = false;

                // --- 1. HARMONIC ENGINE COMBUSTION CORE ---
                this.masterEngineGain = null;
                this.distortion = null;

                // 3 Harmonic Oscillators: Fundamental + 2nd Harmonic + 0.5x Subharmonic
                this.osc1 = null;
                this.gain1 = null;
                this.osc2 = null;
                this.gain2 = null;
                this.osc3 = null;
                this.gain3 = null;

                // Dual Acoustic Formant Filters
                this.engineFilterLow = null;
                this.engineFilterBody = null;

                // --- 2. INTAKE & EXHAUST AIRFLOW RUSH (Pink/Brown Noise) ---
                this.gasNoiseSrc = null;
                this.gasFilter = null;
                this.gasGain = null;

                // --- 3. REVERSE GEAR MESH & BACKUP CHIME ---
                this.reverseMeshOsc = null;
                this.reverseMeshGain = null;
                this.reverseBeepTimer = 0;

                // --- 4. NATURAL TIRE ASPHALT SCRUB & DRIFT ---
                this.tireNoiseSrc = null;
                this.tireFilter = null;
                this.tireGain = null;

                // Dynamic speed tracking
                this.virtualSpeed = 0;
            }

            // Create smooth saturation waveshaper curve (warm analog engine compression)
            makeDistortionCurve(amount = 8) {
                const k = amount;
                const n_samples = 44100;
                const curve = new Float32Array(n_samples);
                const deg = Math.PI / 180;
                for (let i = 0; i < n_samples; ++i) {
                    const x = (i * 2) / n_samples - 1;
                    curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
                }
                return curve;
            }

            init() {
                if (this.initialized) return;
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                this.ctx = new AudioCtx();
                this.initialized = true;

                const now = this.ctx.currentTime;

                // Master engine bus
                this.masterEngineGain = this.ctx.createGain();
                this.masterEngineGain.gain.setValueAtTime(0.0, now);
                this.masterEngineGain.connect(this.ctx.destination);

                // Warm analog saturation waveshaper
                this.distortion = this.ctx.createWaveShaper();
                this.distortion.curve = this.makeDistortionCurve(8);
                this.distortion.oversample = '4x';

                // Formant 1: Lowpass with smooth load opening (170Hz -> 750Hz)
                this.engineFilterLow = this.ctx.createBiquadFilter();
                this.engineFilterLow.type = 'lowpass';
                this.engineFilterLow.frequency.setValueAtTime(170, now);
                this.engineFilterLow.Q.setValueAtTime(0.7, now);

                // Formant 2: Engine block body acoustic resonance (280Hz -> 550Hz)
                this.engineFilterBody = this.ctx.createBiquadFilter();
                this.engineFilterBody.type = 'bandpass';
                this.engineFilterBody.frequency.setValueAtTime(280, now);
                this.engineFilterBody.Q.setValueAtTime(1.2, now);

                // Connect distortion -> dual formants -> master engine
                this.distortion.connect(this.engineFilterLow);
                this.engineFilterLow.connect(this.masterEngineGain);

                this.distortion.connect(this.engineFilterBody);
                this.engineFilterBody.connect(this.masterEngineGain);

                // --- OSCILLATOR 1: Fundamental Cylinder Pulse (Sawtooth, 30Hz - 88Hz) ---
                this.osc1 = this.ctx.createOscillator();
                this.osc1.type = 'sawtooth';
                this.osc1.frequency.setValueAtTime(32, now);
                this.gain1 = this.ctx.createGain();
                this.gain1.gain.setValueAtTime(0.50, now);
                this.osc1.connect(this.gain1);
                this.gain1.connect(this.distortion);
                this.osc1.start(now);

                // --- OSCILLATOR 2: 2nd Harmonic Stroke (Triangle, 64Hz - 176Hz) ---
                this.osc2 = this.ctx.createOscillator();
                this.osc2.type = 'triangle';
                this.osc2.frequency.setValueAtTime(64, now);
                this.gain2 = this.ctx.createGain();
                this.gain2.gain.setValueAtTime(0.35, now);
                this.osc2.connect(this.gain2);
                this.gain2.connect(this.distortion);
                this.osc2.start(now);

                // --- OSCILLATOR 3: 0.5x Subharmonic Camshaft Purr (Sine, 16Hz - 44Hz) ---
                this.osc3 = this.ctx.createOscillator();
                this.osc3.type = 'sine';
                this.osc3.frequency.setValueAtTime(16, now);
                this.gain3 = this.ctx.createGain();
                this.gain3.gain.setValueAtTime(0.38, now);
                this.osc3.connect(this.gain3);
                this.gain3.connect(this.distortion);
                this.osc3.start(now);

                // --- INTAKE & EXHAUST AIRFLOW RUSH (Filtered Noise) ---
                const sr = this.ctx.sampleRate;
                const noiseBuf = this.ctx.createBuffer(1, sr * 2, sr);
                const noiseData = noiseBuf.getChannelData(0);
                let lastOut = 0.0;
                for (let i = 0; i < noiseBuf.length; i++) {
                    const white = Math.random() * 2 - 1;
                    lastOut = (lastOut + 0.045 * white) / 1.045;
                    noiseData[i] = lastOut * 3.2;
                }
                this.gasNoiseSrc = this.ctx.createBufferSource();
                this.gasNoiseSrc.buffer = noiseBuf;
                this.gasNoiseSrc.loop = true;

                this.gasFilter = this.ctx.createBiquadFilter();
                this.gasFilter.type = 'lowpass';
                this.gasFilter.frequency.setValueAtTime(220, now);
                this.gasFilter.Q.setValueAtTime(0.8, now);

                this.gasGain = this.ctx.createGain();
                this.gasGain.gain.setValueAtTime(0.02, now);

                this.gasNoiseSrc.connect(this.gasFilter);
                this.gasFilter.connect(this.gasGain);
                this.gasGain.connect(this.masterEngineGain);
                this.gasNoiseSrc.start(now);

                // --- REVERSE GEAR MESH (Soft Low Sine Hum) ---
                this.reverseMeshOsc = this.ctx.createOscillator();
                this.reverseMeshOsc.type = 'sine';
                this.reverseMeshOsc.frequency.setValueAtTime(145, now);
                this.reverseMeshGain = this.ctx.createGain();
                this.reverseMeshGain.gain.setValueAtTime(0.0, now);
                this.reverseMeshOsc.connect(this.reverseMeshGain);
                this.reverseMeshGain.connect(this.ctx.destination);
                this.reverseMeshOsc.start(now);

                // --- TIRE ASPHALT FRICTION & DRIFT (Natural Rubber Scrub) ---
                const tireBuf = this.ctx.createBuffer(1, sr * 2, sr);
                const tireData = tireBuf.getChannelData(0);
                for (let i = 0; i < tireBuf.length; i++) {
                    tireData[i] = Math.random() * 2 - 1;
                }
                this.tireNoiseSrc = this.ctx.createBufferSource();
                this.tireNoiseSrc.buffer = tireBuf;
                this.tireNoiseSrc.loop = true;

                this.tireFilter = this.ctx.createBiquadFilter();
                this.tireFilter.type = 'bandpass';
                this.tireFilter.frequency.setValueAtTime(1100, now);
                this.tireFilter.Q.setValueAtTime(1.1, now);

                this.tireGain = this.ctx.createGain();
                this.tireGain.gain.setValueAtTime(0.0, now);

                this.tireNoiseSrc.connect(this.tireFilter);
                this.tireFilter.connect(this.tireGain);
                this.tireGain.connect(this.ctx.destination);
                this.tireNoiseSrc.start(now);
            }

            updateEngine(speed, isReversing, dt, driftIntensity = 0, isThrottling = false, isBraking = false) {
                if (!this.initialized) return;

                const isEngineRunning = (typeof carPhysics !== 'undefined' && carPhysics.engineOn) && (typeof gameState !== 'undefined' && !gameState.inMenu);

                if (this.muted || !isEngineRunning) {
                    if (this.masterEngineGain && this.ctx) this.masterEngineGain.gain.setTargetAtTime(0.0, this.ctx.currentTime, 0.08);
                    if (this.gasGain && this.ctx) this.gasGain.gain.setTargetAtTime(0.0, this.ctx.currentTime, 0.08);
                    if (this.reverseMeshGain && this.ctx) this.reverseMeshGain.gain.setTargetAtTime(0.0, this.ctx.currentTime, 0.08);
                    if (this.tireGain && this.ctx) this.tireGain.gain.setTargetAtTime(0.0, this.ctx.currentTime, 0.08);
                    return;
                }

                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }

                const now = this.ctx.currentTime;
                const absSpeed = Math.abs(speed || 0);

                // Smooth virtual speed tracking for natural RPM progression
                this.virtualSpeed += (absSpeed - this.virtualSpeed) * Math.min(1, dt * 7.5);

                const speedRatio = Math.min(1, this.virtualSpeed / 38);

                // --- 1. COMBUSTION PULSE UPDATE ---
                // Fundamental engine frequency: 32Hz (idle purr) up to ~88Hz (top speed)
                let baseFreq = 32 + speedRatio * 52;
                if (isThrottling) baseFreq += 5.5; // Slight rev lift under throttle load
                if (isReversing) baseFreq = 34 + Math.min(18, (absSpeed / 14) * 18);

                this.osc1.frequency.setTargetAtTime(baseFreq, now, 0.05);
                this.osc2.frequency.setTargetAtTime(baseFreq * 2, now, 0.05);
                this.osc3.frequency.setTargetAtTime(baseFreq * 0.5, now, 0.05);

                // Filter cutoff opens with engine RPM and gas throttle
                const targetCutoff = 170 + speedRatio * 320 + (isThrottling ? 220 : 0);
                this.engineFilterLow.frequency.setTargetAtTime(targetCutoff, now, 0.06);

                const targetBodyFreq = 280 + speedRatio * 180 + (isThrottling ? 80 : 0);
                this.engineFilterBody.frequency.setTargetAtTime(targetBodyFreq, now, 0.06);

                // Intake/exhaust airflow rush
                const targetGasVol = 0.02 + (isThrottling ? 0.12 : 0.01) * (0.3 + speedRatio * 0.7);
                this.gasGain.gain.setTargetAtTime(targetGasVol, now, 0.06);
                const targetGasCutoff = 220 + (isThrottling ? 450 : 0) + speedRatio * 200;
                this.gasFilter.frequency.setTargetAtTime(targetGasCutoff, now, 0.06);

                // Master engine volume: solid, pleasant, never piercing
                let targetMasterVol = 0.45 + speedRatio * 0.28 + (isThrottling ? 0.14 : 0);
                if (absSpeed < 0.5) targetMasterVol = 0.42; // Idle
                this.masterEngineGain.gain.setTargetAtTime(targetMasterVol, now, 0.05);

                // --- 2. REVERSE GEAR MESH (MUNDUR) ---
                if (isReversing && absSpeed > 0.3) {
                    const revRatio = Math.min(1, absSpeed / 18);
                    this.reverseMeshOsc.frequency.setTargetAtTime(140 + revRatio * 45, now, 0.05);
                    this.reverseMeshGain.gain.setTargetAtTime(0.035 * revRatio, now, 0.05);

                    this.reverseBeepTimer += dt;
                    if (this.reverseBeepTimer > 0.68) {
                        this.reverseBeepTimer = 0;
                        this.playTone(880, 0.065, 'sine', 0.035);
                    }
                } else {
                    this.reverseMeshGain.gain.setTargetAtTime(0.0, now, 0.08);
                    this.reverseBeepTimer = 0.55;
                }

                // --- 3. NATURAL TIRE SCRUB (DRIFT) ---
                if (driftIntensity > 0.05) {
                    const scrubFreq = 950 + driftIntensity * 400;
                    this.tireFilter.frequency.setTargetAtTime(scrubFreq, now, 0.04);
                    const targetScrubVol = Math.min(0.22, driftIntensity * 0.20);
                    this.tireGain.gain.setTargetAtTime(targetScrubVol, now, 0.05);
                } else if (isBraking && absSpeed > 5.0) {
                    this.tireFilter.frequency.setTargetAtTime(1050, now, 0.04);
                    const targetBrakeScrub = Math.min(0.18, (absSpeed / 30) * 0.18);
                    this.tireGain.gain.setTargetAtTime(targetBrakeScrub, now, 0.05);
                } else {
                    this.tireGain.gain.setTargetAtTime(0.0, now, 0.08);
                }
            }

            // --- 4. TASTEFUL SPORTY EXHAUST BURBLE (Subtle & pleasant, NOT explosive bombs) ---
            playBackfirePop(intensity = 1.0) {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const now = this.ctx.currentTime;

                // Soft low acoustic thump (like a sporty modern hatchback DSG burble)
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(58 + Math.random() * 12, now);
                osc.frequency.exponentialRampToValueAtTime(24, now + 0.075);

                const vol = Math.min(0.32, 0.20 * intensity);
                gain.gain.setValueAtTime(vol, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.075);

                osc.connect(gain);
                if (this.distortion) {
                    gain.connect(this.distortion);
                } else {
                    gain.connect(this.ctx.destination);
                }
                osc.start(now);
                osc.stop(now + 0.08);

                // Subtle muffled puff (soft high-frequency component)
                const sr = this.ctx.sampleRate;
                const puffLen = Math.floor(sr * 0.03);
                const puffBuf = this.ctx.createBuffer(1, puffLen, sr);
                const puffData = puffBuf.getChannelData(0);
                for (let i = 0; i < puffLen; i++) {
                    puffData[i] = (Math.random() * 2 - 1) * Math.exp(-i / (puffLen * 0.25));
                }
                const puffSrc = this.ctx.createBufferSource();
                puffSrc.buffer = puffBuf;
                const puffFilter = this.ctx.createBiquadFilter();
                puffFilter.type = 'bandpass';
                puffFilter.frequency.setValueAtTime(520, now);
                puffFilter.Q.setValueAtTime(1.5, now);
                const puffGain = this.ctx.createGain();
                puffGain.gain.setValueAtTime(0.10 * intensity, now);
                puffGain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);

                puffSrc.connect(puffFilter);
                puffFilter.connect(puffGain);
                puffGain.connect(this.ctx.destination);
                puffSrc.start(now);
            }

