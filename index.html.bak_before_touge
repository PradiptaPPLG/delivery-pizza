            playEngineStart() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const now = this.ctx.currentTime;

                // 1. Starter motor cranking pulses (3 rhythmic pulses: chug-chug-chug)
                for (let i = 0; i < 3; i++) {
                    const crankTime = now + i * 0.12;
                    const oscC = this.ctx.createOscillator();
                    const gainC = this.ctx.createGain();
                    oscC.type = 'sawtooth';
                    oscC.frequency.setValueAtTime(32 + i * 5, crankTime);
                    oscC.frequency.exponentialRampToValueAtTime(16, crankTime + 0.09);
                    gainC.gain.setValueAtTime(0.24, crankTime);
                    gainC.gain.exponentialRampToValueAtTime(0.001, crankTime + 0.09);
                    oscC.connect(gainC);
                    gainC.connect(this.ctx.destination);
                    oscC.start(crankTime);
                    oscC.stop(crankTime + 0.10);
                }

                // 2. Combustion catch flare (vroom rev flare settling into smooth idle)
                const catchTime = now + 0.38;
                const oscCatch = this.ctx.createOscillator();
                const gainCatch = this.ctx.createGain();
                oscCatch.type = 'sawtooth';
                oscCatch.frequency.setValueAtTime(45, catchTime);
                oscCatch.frequency.exponentialRampToValueAtTime(95, catchTime + 0.14);
                oscCatch.frequency.exponentialRampToValueAtTime(32, catchTime + 0.65);

                gainCatch.gain.setValueAtTime(0.0, catchTime);
                gainCatch.gain.linearRampToValueAtTime(0.38, catchTime + 0.08);
                gainCatch.gain.exponentialRampToValueAtTime(0.001, catchTime + 0.68);

                oscCatch.connect(gainCatch);
                if (this.distortion) gainCatch.connect(this.distortion);
                else gainCatch.connect(this.ctx.destination);

                oscCatch.start(catchTime);
                oscCatch.stop(catchTime + 0.70);

                // Resume master engine gain smoothly after catch
                if (this.masterEngineGain) {
                    this.masterEngineGain.gain.setValueAtTime(0.0, now);
                    this.masterEngineGain.gain.setValueAtTime(0.0, catchTime + 0.1);
                    this.masterEngineGain.gain.linearRampToValueAtTime(0.42, catchTime + 0.65);
                }
            }

            playEngineStop() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                if (this.ctx.state === 'suspended') this.ctx.resume();

                const now = this.ctx.currentTime;

                // Spool down pitch from idle to 10Hz
                if (this.osc1 && this.osc2 && this.osc3) {
                    this.osc1.frequency.setTargetAtTime(12, now, 0.16);
                    this.osc2.frequency.setTargetAtTime(24, now, 0.16);
                    this.osc3.frequency.setTargetAtTime(6, now, 0.16);
                }

                // Fade master engine gain to 0
                if (this.masterEngineGain) {
                    this.masterEngineGain.gain.setTargetAtTime(0.0, now, 0.20);
                }
                if (this.gasGain) {
                    this.gasGain.gain.setTargetAtTime(0.0, now, 0.16);
                }
            }

